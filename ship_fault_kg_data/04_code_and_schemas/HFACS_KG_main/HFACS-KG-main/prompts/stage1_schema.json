{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Stage-1 extraction output",
  "type": "object",
  "required": [
    "accident_metadata",
    "vessels_involved",
    "event_sequence",
    "causal_factors",
    "environmental_conditions"
  ],
  "properties": {
    "accident_metadata": {
      "type": "object",
      "required": [
        "name",
        "type"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "type": {
          "type": "string",
          "description": "From controlled vocabulary"
        },
        "date": {
          "type": [
            "string",
            "null"
          ]
        },
        "location": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "vessels_involved": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "imo_number": {
            "type": [
              "string",
              "null"
            ]
          },
          "flag_state": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "event_sequence": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "causal_factors": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "environmental_conditions": {
      "type": "object",
      "properties": {
        "weather": {
          "type": [
            "string",
            "null"
          ]
        },
        "visibility": {
          "type": [
            "string",
            "null"
          ]
        },
        "sea_state": {
          "type": [
            "string",
            "null"
          ]
        },
        "time_of_day": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}