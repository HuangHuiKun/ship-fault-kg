# Research documents and binary snapshots use Git LFS; source/metadata stay diffable.
*.pdf filter=lfs diff=lfs merge=lfs -text
*.tif filter=lfs diff=lfs merge=lfs -text
*.tiff filter=lfs diff=lfs merge=lfs -text
*.png filter=lfs diff=lfs merge=lfs -text
*.jpg filter=lfs diff=lfs merge=lfs -text
*.jpeg filter=lfs diff=lfs merge=lfs -text
*.pptx filter=lfs diff=lfs merge=lfs -text
*.docx filter=lfs diff=lfs merge=lfs -text
*.xlsx filter=lfs diff=lfs merge=lfs -text
*.sqlite filter=lfs diff=lfs merge=lfs -text
*.zip filter=lfs diff=lfs merge=lfs -text
*.7z filter=lfs diff=lfs merge=lfs -text
*.parquet filter=lfs diff=lfs merge=lfs -text
*.npy filter=lfs diff=lfs merge=lfs -text
*.npz filter=lfs diff=lfs merge=lfs -text
ship_fault_kg_data/01_datasets/**/*.csv filter=lfs diff=lfs merge=lfs -text

# Keep source encoding/line endings predictable; Cypher/styles remain ordinary text.
*.py text eol=lf
*.md text eol=lf
*.json text eol=lf
*.csv text eol=lf
*.cypher text eol=lf
*.grass text eol=lf
*.html text eol=lf
*.mjs text eol=lf
*.ps1 text eol=crlf
