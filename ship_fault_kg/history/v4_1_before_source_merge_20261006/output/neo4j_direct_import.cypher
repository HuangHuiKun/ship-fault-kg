 the com",`props_json`:"{\"name\": \"来源于\", \"graph_version\": \"4.1\", \"is_causal\": false}"}},{`id`:"edge:ec32b6f345cc361f",`source`:"shipkg:observation:f5d747e68b69",`target`:"shipkg:source:5137a1994672",`properties`:{`name`:"来源于",`graph_version`:"4.1",`is_causal`:false,`original_dataset_id`:"shipkg:dataset:710ea13e53ac",`original_dataset_name`:"Azimuth Thruster CBM Dataset",`original_dataset_props`:"{\"data_origin\": \"anonymised_field_summary\", \"display_name\": \"Azimuth Thruster CBM Dataset\", \"kind_zh\": \"数据集\", \"graph_version\": \"4.1\", \"legacy_kind\": \"Dataset\"}",`legacy_relation`:"HAS_CASE",`legacy_source`:"shipkg:dataset:710ea13e53ac",`legacy_target`:"shipkg:observation:f5d747e68b69",`data_origin`:"anonymised_field_summary",`id`:"edge:ec32b6f345cc361f",`case_id`:"",`certainty`:"reported",`certainty_zh`:"报告明确记载",`evidence_id`:"ev:596b2f398d646f0b",`source_file`:"Azimuth_Thruster_CBM_Dataset.zip",`source_url`:"https://zenodo.org/records/20101612",`page`:"",`locator`:"table3_lti_by_fault_type_anonymised.csv:row1",`quote`:"System / engine-family case=CAT C7 shaftline reductor / CAT C7 case A; Fault or condition=Structural looseness; Detection/event reference=Vibration alert Month -3.5; operational failure/gearbox repair; Reference class=LTI_operational; LTI / warning (mo)=3.5; Warning (h)=525.0; Recommended CBM action=Vibration-only CBM; 125 h vibration interval; Included in mechanical LTI summary=yes",`props_json`:"{\"name\": \"来源于\", \"graph_version\": \"4.1\", \"is_causal\": false, \"original_dataset_id\": \"shipkg:dataset:710ea13e53ac\", \"original_dataset_name\": \"Azimuth Thruster CBM Dataset\", \"original_dataset_props\": \"{\\\"data_origin\\\": \\\"anonymised_field_summary\\\", \\\"display_name\\\": \\\"Azimuth Thruster CBM Dataset\\\", \\\"kind_zh\\\": \\\"数据集\\\", \\\"graph_version\\\": \\\"4.1\\\", \\\"legacy_kind\\\": \\\"Dataset\\\"}\", \"legacy_relation\": \"HAS_CASE\", \"legacy_source\": \"shipkg:dataset:710ea13e53ac\", \"legacy_targe