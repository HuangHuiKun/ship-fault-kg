CALL () { UNWIND [{`id`:"edge:205dd00684e9a697",`source`:"shipkg:check:d57ef9f67880",`target`:"shipkg:fault:655f841ec7d0",`properties`:{`context_id`:"knowledge:damper_failure",`knowledge_layer`:"reference",`data_origin`:"manufacturer_guidance",`applicability`:"MAN L16/24、L21/31、L27/38等通函列明机型；不得推广其维护周期到其它机型。",`coupling_domains`:"热-机",`name`:"检查",`graph_version`:"4.1",`is_causal`:false,`id`:"edge:205dd00684e9a697",`case_id`:"knowledge:damper_failure",`certainty`:"derived_action",`certainty_zh`:"依据报告整理的检查建议",`evidence_id`:"ev:5cc0a7e2e1c99766",`source_file`:"MAN_SL2017_654_torsional_damper.pdf",`source_url`:"https://www.man-es.com/docs/default-source/service-letters/sl2017-654.pdf",`page`:"1",`locator`:"PDF page 1",`quote`:"a failing torsional vibration damper could be abnormal noise from the torsional vibration damper or any change in the vibra- tion behavior of the complete GenSet. In such a case, the complete torsional vibration damper must be replaced. For questions or comments please contact operation dept. Holeby: leo7@mandieselturbo.com Yours faithfully Crankshaft Torsional Vibration Damper SL2017-654",`props_json`:"{\"context_id\": \"knowledge:damper_failure\", \"knowledge_layer\": \"reference\", \"data_origin\": \"manufacturer_guidance\", \"applicability\": \"MAN L16/24、L21/31、L27/38等通函列明机型；不得推广其维护周期到其它机型。\", \"coupling_domains\": \"热-机\", \"name\": \"检查\", \"graph_version\": \"4.1\", \"is_causal\": false}"}},{`id`:"edge:27a54c90ae91058e",`source`:"shipkg:check:b9b23cb93dc6",`target`:"shipkg:condition:4277de3a84c9",`properties`:{`name`:"检查",`graph_version`:"4.1",`is_causal`:false,`id`:"edge:27a54c90ae91058e",`case_id`:"stena_europe_fuel_2023",`certainty`:"reported_action",`certainty_zh`:"报告行动/建议",`evidence_id`:"ev:0917ec321d12afd2",`source_file`:"MAIB_2024_20_Stena_Europe_fuel_spray_fire.pdf",`source_url`:"https://assets.publishing.service.gov.uk/media/6756db0ba63e1781efb87793/2024-20-StenaEurope.pdf",`page`:"32",`locator`:"PDF page 32",`quote`:"ght the hazards of entering a fire-damaged space without the correct personal protective equipment. 2024/174 Introduce the use of thermal imaging cameras to all Stena vessels with appropriate functionality for the detection of exposed hot surfaces of over 220°C within machinery spaces. Safety recommendations shall in no case create a presumption of blame or liability.",`props_json`:"{\"name\": \"检查\", \"graph_version\": \"4.1\", \"is_causal\": false}"}},{`id`:"edge:2af65627db2764ce",`source`:"shipkg:check:7bc4821b359e",`target`:"shipkg:fault:72c71c94ca13",`properties`:{`name`:"检查",`graph_version`:"4.1",`is_causal`:false,`id`:"edge:2af65627db2764ce",`case_id`:"sd2016_22_cooling_pipe",`certainty`:"reported_action",`certainty_zh`:"报告行动/建议",`evidence_id`:"ev:f402f62ae7b113ec",`source_file`:"MAIB_2016_Safety_Digest_generator_oil_fire.pdf",`source_url`:"https://assets.publishing.service.gov.uk/media/5e81e5d2d3bf7f13416961fa/2016-SD1-MAIBSafetyDigest.pdf",`page`:"60",`locator`:"PDF page 60",`quote`:"a water cooling pipe. Analysis of maintenance records showed that this pipework had not been inspected or renewed for many years. Sea inlet pipework should be thoroughly checked during planned maintenance periods. skipper, who had remained in the wheelhouse, then broadcast a “Mayday” message on VHF radio, which was received and relayed by the coastguard to all vessels in the area. As the vessel began to",`props_json`:"{\"name\": \"检查\", \"graph_version\": \"4.1\", \"is_causal\": false}"}},{`id`:"edge:33009345e85760a8",`source`:"shipkg:check:e53578d74732",`target`:"shipkg:cause:c5d7e29b6c94",`properties`:{`context_id`:"knowledge:coolant_blockage",`knowledge_layer`:"reference",`data_origin`:"manufacturer_guidance",`applicability`:"MAN四冲程柴油机闭式淡水冷却；水质要求与添加剂须按具体机型手册确认。",`coupling_domains`:"热-机",`name`:"检查",`graph_version`:"4.1",`is_causal`:false,`id`:"edge:33009345e85760a8",`case_id`:"knowledge:coolant_blockage",`certainty`:"guidance",`certainty_zh`:"厂家一般机理/指导（须核对机型）",`evidence_id`:"ev:9282652d0f980004",`source_file`:"MAN_SL2016_623_cooling_water.pdf",`source_url`:"https://www.man-es.com/docs/default-source/service-letters/sl2016-623.pdf",`page`:"3",`locator`:"PDF page 3",`quote`:"ontent ≤50 mg/l ≤50 mg/l 2) Fig. 3: Rust and limescale blocks the cooling water bores (valve seat removed from cylinder head) The quality of the freshwater must be checked using the MAN Diesel & Turbo water testing kit or a similar test kit pro - vided by the manufacturer. The requirements to freshwater quality are stated in Table 1. Treatment and periodical checks of the cooling water W hen distil",`props_json`:"{\"context_id\": \"knowledge:coolant_blockage\", \"knowledge_layer\": \"reference\", \"data_origin\": \"manufacturer_guidance\", \"applicability\": \"MAN四冲程柴油机闭式淡水冷却；水质要求与添加剂须按具体机型手册确认。\", \"coupling_domains\": \"热-机\", \"name\": \"检查\", \"graph_version\": \"4.1\", \"is_causal\": false}"}},{`id`:"edge:50872acb8cee9064",`source`:"shipkg:check:61f2da350e19",`target`:"shipkg:fault:7c36cc5888d4",`properties`:{`context_id`:"knowledge:coupling_failure",`knowledge_layer`:"reference",`data_origin`:"field_report",`applicability`:"实际证据是Hebrides的CPP执行器小型爪式联轴器，不是主推进轴联轴器断裂；主轴断裂根因不可由此推断。",`coupling_domains`:"机-电",`name`:"检查",`graph_version`:"4.1",`is_causal`:false,`id`:"edge:50872acb8cee9064",`case_id`:"knowledge:coupling_failure",`certainty`:"reported_action",`certainty_zh`:"报告行动/建议",`evidence_id`:"ev:6312cf968733db1b",`source_file`:"MAIB_2017_20_Hebrides_CPP_coupling.pdf",`source_url`:"https://assets.publishing.service.gov.uk/media/59b7ab1c40f0b61231e71a54/MAIBInvReport20_2017.pdf",`page`:"36",`locator`:"PDF page 36",`quote`:"NISATIONS Rolls-Royce Marine has: ● Issued a service letter to all users of the HeliconX propulsion control systems regarding the inspection and integrity of the jaw coupling within the linear servomotor actuator. ● Issued a service procedure for the linear servomotor based on OEM requirements. CalMac Ferries Ltd h as: ● Issued a technical bulletin to its major vessels that requires all propulsion con",`props_json`:"{\"context_id\": \"knowledge:coupling_failure\", \"knowledge_layer\": \"reference\", \"data_origin\": \"field_report\", \"applicability\": \"实际证据是Hebrides的CPP执行器小型爪式联轴器，不是主推进轴联轴器断裂；主轴断裂根因不可由此推断。\", \"coupling_domains\": \"机-电\", \"name\": \"检查\", \"graph_version\": \"4.1\", \"is_causal\": false}"}},{`id`:"edge:54a6f1f6bd496483",`source`:"shipkg:check:78fb4dfb3734",`target`:"shipkg:fault:2c6822dc16f4",`properties`:{`context_id`:"knowledge:liner_scuffing",`knowledge_layer`:"reference",`data_origin`:"manufacturer_guidance",`applicability`:"MAN B&W两冲程柴油机缸套/活塞环；2016通函用于机理，润滑油选择须查2023通函及本机手册。不能把活塞咬死一概等同于已证实拉缸。",`coupling_domains`:"热-机",`name`:"检查",`graph_version`:"4.1",`is_causal`:false,`id`:"edge:54a6f1f6bd496483",`case_id`:"knowledge:liner_scuffing",`certainty`:"derived_action",`certainty_zh`:"依据报告整理的检查建议",`evidence_id`:"ev:da388522df310fbc",`source_file`:"MAN_SL2016_633_piston_rings_scuffing.pdf",`source_url`:"https://www.man-es.com/docs/default-source/service-letters/sl2016-633.pdf",`page`:"3",`locator`:"PDF page 3",`quote`:"is recommended. Otherwise, polishing and smearing of the liner surface may occur and, thereby, in - crease the risk for seizures. Conditioning the liner surface When overhauling after prolonged operation on ULSF, the liner surface may not be in an adequate condition to facilitate the running-in of new piston rings as is the case when oper - ating on high-sulphur fuels. It may therefore b",`props_json`:"{\"context_id\": \"knowledge:liner_scuffing\", \"knowledge_layer\": \"reference\", \"data_origin\": \"manufacturer_guidance\", \"applicability\": \"MAN B&W两冲程柴油机缸套/活塞环；2016通函用于机理，润滑油选择须查2023通函及本机手册。不能把活塞咬死一概等同于已证实拉缸。\", \"coupling_domains\": \"热-机\", \"name\": \"检查\", \"graph_version\": \"4.1\", \"is_causal\": false}"}},{`id`:"edge:58661885c40c9a23",`source`:"shipkg:check:b6e1865763c1",`target`:"shipkg:fault:1e5a23a200ad",`properties`:{`name`:"检查",`graph_version`:"4.1",`is_causal`:false,`id`:"edge:58661885c40c9a23",`case_id`:"pride_can_cpp_2014",`certainty`:"reported_action",`certainty_zh`:"报告行动/建议",`evidence_id`:"ev:ccd29d6aeef2b43d",`source_file`:"MAIB_2015_22_Pride_of_Canterbury_CPP_hydraulic_fire.pdf",`source_url`:"https://assets.digital.cabinet-office.gov.uk/media/563092daed915d566d000002/MAIBInvReport-22_2015.pdf",`page`:"35",`locator`:"PDF page 35",`quote`:"d PSV3 on all CPP hydraulic modules. • Implemented a maintenance programme in which at least PSV1, PSV3 and NRV6 are disabled and their function checked once every 5 years. • Added a full flow check-valve, with an opening pressure of 10-12 bar, in the return oil circuit by-passing PSV3, the Oil Cooler and NRV6. Also, an additional alarm signal was to be fitted in the control system to give an alarm",`props_json`:"{\"name\": \"检查\", \"graph_version\": \"4.1\", \"is_causal\": false}"}},{`id`:"edge:6f704813104a170d",`source`:"shipkg:check:4999713b2123",`target`:"shipkg:fault:4de4eeb54341",`properties`:{`context_id`:"knowledge:electrical_oscillation",`knowledge_layer`:"reference",`data_origin`:"research_paper",`applicability`:"2021论文三类船舶的实测电网信号，含轴带发电化学品船；不是所有振荡都超限。DP船风浪影响主要作用于基波与频率，不能一概说风浪显著放大所有谐波。",`coupling_domains`:"机-电",`name`:"检查",`graph_version`:"4.1",`is_causal`:false,`id`:"edge:6f704813104a170d",`case_id`:"knowledge:electrical_oscillation",`certainty`:"derived_action",`certainty_zh`:"依据报告整理的检查建议",`evidence_id`:"ev:10373ed4022e576f",`source_file`:"Frontiers_2021_marine_converter_oscillations.pdf",`source_url`:"https://www.frontiersin.org/journals/energy-research/articles/10.3389/fenrg.2020.529756/pdf",`page`:"12",`locator`:"PDF page 12",`quote`:"amental voltage and frequency were affected in particular, with only minor impact of sea waves on harmonics modulation. Moreover, phase portraits can be used for fast detection of oscillatory behavior in maritime microgrids and their irregularities. The most important merit of such an approach is its simplicity. The calculations are fast and reliable. The dispersion of the results can",`props_json`:"{\"context_id\": \"knowledge:electrical_oscillation\", \"knowledge_layer\": \"reference\", \"data_origin\": \"research_paper\", \"applicability\": \"2021论文三类船舶的实测电网信号，含轴带发电化学品船；不是所有振荡都超限。DP船风浪影响主要作用于基波与频率，不能一概说风浪显著放大所有谐波。\", \"coupling_domains\": \"机-电\", \"name\": \"检查\", \"graph_version\": \"4.1\", \"is_causal\": false}"}},{`id`:"edge:72a4dee30a30f16a",`source`:"shipkg:check:168aa4cf65c8",`target`:"shipkg:fault:ad105e83a5af",`properties`:{`context_id`:"knowledge:generator_bearing_wear",`knowledge_layer`:"reference",`data_origin`:"manufacturer_guidance",`applicability`:"有滚动轴承的发电机或轴带发电机构型；滚动轴承与主机滑动轴瓦的失效机理不得混用。",`coupling_domains`:"热-机-电",`name`:"检查",`graph_version`:"4.1",`is_causal`:false,`id`:"edge:72a4dee30a30f16a",`case_id`:"knowledge:generator_bearing_wear",`certainty`:"derived_action",`certainty_zh`:"依据报告整理的检查建议",`evidence_id`:"ev:65e2c4b3facd8c2b",`source_file`:"STAMFORD_AGN076_alternator_bearings.pdf",`source_url`:"https://www.stamford-avk.com/sites/stamfordavk/files/2024-04/AGN076_C.pdf",`page`:"4",`locator`:"PDF page 4",`quote`:"t fail because of axial vibration, causing a fretting action in the housing, the cylindrical roller bearing might fail because of lack of grease or misalignment damage. The anti-friction ball bearings used on STAMFORD alternators are not insulated bearings. The design of STAMFORD alternators is such that the shaft does not come under the influence of magnetic fields that result in excessive vol",`props_json`:"{\"context_id\": \"knowledge:generator_bearing_wear\", \"knowledge_layer\": \"reference\", \"data_origin\": \"manufacturer_guidance\", \"applicability\": \"有滚动轴承的发电机或轴带发电机构型；滚动轴承与主机滑动轴瓦的失效机理不得混用。\", \"coupling_domains\": \"热-机-电\", \"name\": \"检查\", \"graph_version\": \"4.1\", \"is_causal\": false}"}},{`id`:"edge:75841e23b89f0d54",`source`:"shipkg:check:f9cad3df2b98",`target`:"shipkg:cause:8a2abf94d478",`properties`:{`name`:"检查",`graph_version`:"4.1",`is_causal`:false,`id`:"edge:75841e23b89f0d54",`case_id`:"wight_sky_me2_2018",`certainty`:"derived_action",`certainty_zh`:"依据报告整理的检查建议",`evidence_id`:"ev:d8028bdc4d93a0c8",`source_file`:"MAIB_2022_04_Wight_Sky_multiple_engine_failures.pdf",`source_url`:"https://assets.publishing.service.gov.uk/media/6267cc85e90e071690c1b679/2022-4-WightSky-Report.pdf",`page`:"84",`locator`:"PDF page 84",`quote`:"Opportunities to identify and diagnose engine problems early, and therefore avoid catastrophic failures, were missed because the condition of the engine lubricating oil and coolant was not closely monitored. [2.6.2] [2.6.3] 9. Some aspects of the maintenance work carried out by RKM did not meet the standards set by Volvo Penta and those expected by Wightlink. Assembly errors had been made during overhauls, basic levels of workshop c",`props_json`:"{\"name\": \"检查\", \"graph_version\": \"4.1\", \"is_causal\": false}"}},{`id`:"edge:75c0835b3c79a209",`source`:"shipkg:check:c586aa545141",`target`:"shipkg:condition:37396a158a92",`properties`:{`context_id`:"knowledge:shaft_generator_alignment",`knowledge_layer`:"reference",`data_origin`:"manufacturer_guidance",`applicability`:"通过齿轮箱及联轴器驱动的轴带发电机；不能推广到所有同轴无附加轴承的构型。",`coupling_domains`:"热-机-电",`name`:"检查",`graph_version`:"4.1",`is_causal`:false,`id`:"edge:75c0835b3c79a209",`case_id`:"knowledge:shaft_generator_alignment",`certainty`:"derived_action",`certainty_zh`:"依据报告整理的检查建议",`evidence_id`:"ev:52377c3b77516eac",`source_file`:"STAMFORD_AGN039_marine_shaft_generators.pdf",`source_url`:"https://www.stamford-avk.com/sites/stamfordavk/files/AGNs/AGN-039_C-Marine-Shaft-Generators.pdf",`page`:"2",`locator`:"PDF page 2",`quote`:"are to allow for the thermal expansion of the hot gearbox, which may well expand and lift the shaft centre line by < 1 mm. If the alignment is not accurate, then excessive vibration is likely to damage the shaft generator. There can also be lots of generator damaging vibration when the main engine is running at slow speeds and also when the ship is in storm conditions, because the s",`props_json`:"{\"context_id\": \"knowledge:shaft_generator_alignment\", \"knowledge_layer\": \"reference\", \"data_origin\": \"manufacturer_guidance\", \"applicability\": \"通过齿轮箱及联轴器驱动的轴带发电机；不能推广到所有同轴无附加轴承的构型。\", \"coupling_domains\": \"热-机-电\", \"name\": \"检查\", \"graph_version\": \"4.1\", \"is_causal\": false}"}},{`id`:"edge:79cc156b4e7adb2e",`source`:"shipkg:check:1c503f83ef89",`target`:"shipkg:condition:6fa538170906",`properties`:{`name`:"检查",`graph_version`:"4.1",`is_causal`:false,`id`:"edge:79cc156b4e7adb2e",`case_id`:"kommandor_susan_dg1_2025",`certainty`:"derived_action",`certainty_zh`:"依据报告整理的检查建议",`evidence_id`:"ev:1a0b3fbe432ab46d",`source_file`:"MAIB_2026_10_Kommandor_Susan_generator_bearing_failure.pdf",`source_url`:"https://www.gov.uk/maib-reports/catastrophic-engine-failure-and-subsequent-fire-on-board-the-site-investigation-vessel-kommandor-susan",`page`:"8",`locator`:"PDF page 8",`quote`:"ting priorities during the vessel’s conversion project, this resulted in Hays Ships providing minimal oversight to Holderness and no verification of authenticity for the parts used, enabling the installation of non- OEM components that later contributed to the engine failure. Similar to the lack of oversight highlighted in both the Finlandia Seaways and Finnmaster cases, the lack of structured supervision a",`props_json`:"{\"name\": \"检查\", \"graph_version\": \"4.1\", \"is_causal\": false}"}},{`id`:"edge:7c7bdf8eb11276f2",`source`:"shipkg:check:c55d526e8c4c",`target`:"shipkg:condition:2d0261049d78",`properties`:{`name`:"检查",`graph_version`:"4.1",`is_causal`:false,`id`:"edge:7c7bdf8eb11276f2",`case_id`:"queen_mary2_hf_2010",`certainty`:"reported_action",`certainty_zh`:"报告行动/建议",`evidence_id`:"ev:8d208881ac72d263",`source_file`:"MAIB_2011_28_Queen_Mary_2_harmonic_filter_failure.pdf",`source_url`:"https://assets.digital.cabinet-office.gov.uk/media/547c6fa6ed915d4c10000031/QM2Report.pdf",`page`:"69",`locator`:"PDF page 69",`quote`:"possibly leading to a blackout and loss of control in restricted waters, the need for power quality surveillance is significant. Regular monitoring of power quality, using a pre-determined pattern of propulsion motor loading with associated motor operating parameters, would help ensure that the health of electrical equipment on board is closely monitored as the vessel and its equipment ages",`props_json`:"{\"name\": \"检查\", \"graph_version\": \"4.1\", \"is_causal\": false}"}},{`id`:"edge:96a34d6a177bd786",`source`:"shipkg:check:f420d80dbf17",`target`:"shipkg:condition:ed8375f7583f",`properties`:{`name`:"检查",`graph_version`:"4.1",`is_causal`:false,`id`:"edge:96a34d6a177bd786",`case_id`:"sd2013_02_control_air",`certainty`:"derived_action",`certainty_zh`:"依据报告整理的检查建议",`evidence_id`:"ev:3f0c5814259eb000",`source_file`:"MAIB_2013_Safety_Digest_lubrication_bearing_cases.pdf",`source_url`:"https://assets.publishing.service.gov.uk/government/uploads/system/uploads/attachment_data/file/876748/2013-SD2-MAIBSafetyDigest.pdf",`page`:"15",`locator`:"PDF page 15",`quote`:"st 2/2013 The Lessons 1. When starting machinery or when putting machinery on line or on load, it is good engineering practice to check that it is operating correctly. Assumptions often lead to unwanted surprises. 2. When a machinery breakdown occurs in close proximity to navigational dangers and other vessels, its consequences could be catastrophic unless effective action is taken quickly. Ho",`props_json`:"{\"name\": \"检查\", \"graph_version\": \"4.1\", \"is_causal\": false}"}},{`id`:"edge:97769269bb8e8dcd",`source`:"shipkg:check:050d6770cfa0",`target`:"shipkg:condition:52a5771f68ca",`properties`:{`name`:"检查",`graph_version`:"4.1",`is_causal`:false,`id`:"edge:97769269bb8e8dcd",`case_id`:"sd2016_08_generator_oil",`certainty`:"reported_action",`certainty_zh`:"报告行动/建议",`evidence_id`:"ev:1e3e12480476352c",`source_file`:"MAIB_2016_Safety_Digest_generator_oil_fire.pdf",`source_url`:"https://assets.publishing.service.gov.uk/media/5e81e5d2d3bf7f13416961fa/2016-SD1-MAIBSafetyDigest.pdf",`page`:"28",`locator`:"PDF page 28",`quote`:"icient to ignite an oil or fuel spray. 2. These temperatures are not visible to the eye unless the surface is glowing. However, a thermal image will immediately identify unlagged sections (Figure 3). 3. All vessels are required to comply with SOLAS regulations regarding the maximum allowable temperature of an exposed surface (Chapter II/2): • All surfaces with temperatures above 220°C which may be impinged as a re",`props_json`:"{\"name\": \"检查\", \"graph_version\": \"4.1\", \"is_causal\": false}"}},{`id`:"edge:9d6285f72a296672",`source`:"shipkg:check:470049664913",`target`:"shipkg:fault:fce2f501a499",`properties`:{`name`:"检查",`graph_version`:"4.1",`is_causal`:false,`id`:"edge:9d6285f72a296672",`case_id`:"sd2016_09_cpp_response",`certainty`:"reported_action",`certainty_zh`:"报告行动/建议",`evidence_id`:"ev:ec533ae27276b674",`source_file`:"MAIB_2016_Safety_Digest_generator_oil_fire.pdf",`source_url`:"https://assets.publishing.service.gov.uk/media/5e81e5d2d3bf7f13416961fa/2016-SD1-MAIBSafetyDigest.pdf",`page`:"29",`locator`:"PDF page 29",`quote`:"rried out. These drills will give operators confidence in the back-up systems and help them react effectively in an emergency. 3. Frequent engine response tests should be completed, both ahead and astern. This is particularly important before entering and leaving port or congested waters",`props_json`:"{\"name\": \"检查\", \"graph_version\": \"4.1\", \"is_causal\": false}"}},{`id`:"edge:a308d2312b6b3634",`source`:"shipkg:check:3e5bf3f8ece1",`target`:"shipkg:fault:4de4eeb54341",`properties`:{`context_id`:"knowledge:electrical_oscillation",`knowledge_layer`:"reference",`data_origin`:"research_paper",`applicability`:"2021论文三类船舶的实测电网信号，含轴带发电化学品船；不是所有振荡都超限。DP船风浪影响主要作用于基波与频率，不能一概说风浪显著放大所有谐波。",`coupling_domains`:"机-电",`name`:"检查",`graph_version`:"4.1",`is_causal`:false,`id`:"edge:a308d2312b6b3634",`case_id`:"knowledge:electrical_oscillation",`certainty`:"derived_action",`certainty_zh`:"依据报告整理的检查建议",`evidence_id`:"ev:172a7fb8c0a27ceb",`source_file`:"Frontiers_2021_marine_converter_oscillations.pdf",`source_url`:"https://www.frontiersin.org/journals/energy-research/articles/10.3389/fenrg.2020.529756/pdf",`page`:"1",`locator`:"PDF page 1",`quote`:"aneous frequency is determined and subsequently ﬂuctuations of fundamental components and chosen harmonics are calculated using zoom- DFT. The characteristics of these irregular ﬂuctuations are compared and commented on. Next, phase portraits and Poincare map of the registered voltages are calculated and compared. Moreover, the impact of ship rolling and pitching",`props_json`:"{\"context_id\": \"knowledge:electrical_oscillation\", \"knowledge_layer\": \"reference\", \"data_origin\": \"research_paper\", \"applicability\": \"2021论文三类船舶的实测电网信号，含轴带发电化学品船；不是所有振荡都超限。DP船风浪影响主要作用于基波与频率，不能一概说风浪显著放大所有谐波。\", \"coupling_domains\": \"机-电\", \"name\": \"检查\", \"graph_version\": \"4.1\", \"is_causal\": false}"}},{`id`:"edge:a7ed81bfe526a514",`source`:"shipkg:check:72fca2c03641",`target`:"shipkg:fault:f6eb639558ed",`properties`:{`context_id`:"knowledge:shaft_torsional",`knowledge_layer`:"reference",`data_origin`:"manufacturer_guidance",`applicability`:"内燃机-发电机传动链一般机理；证据支持扭振导致失效风险及电气故障转矩冲击，但未建立某大型船主轴联轴器断裂的已证实事故链。",`coupling_domains`:"热-机-电",`name`:"检查",`graph_version`:"4.1",`is_causal`:false,`id`:"edge:a7ed81bfe526a514",`case_id`:"knowledge:shaft_torsional",`certainty`:"guidance",`certainty_zh`:"厂家一般机理/指导（须核对机型）",`evidence_id`:"ev:34006c39dec5327b",`source_file`:"STAMFORD_AGN235_torsional_analysis.pdf",`source_url`:"https://www.stamford-avk.com/sites/stamfordavk/files/AGNs/AGN-235_A-Generating-Set-Assembly-Torsional-Vibration-Analysis.pdf",`page`:"7",`locator`:"PDF page 7",`quote`:"ing sequence, cycle to cycle variation impacts different cylinder firing orders differently. All torsional vibration calculations require validation by test. Typical results from torsional vibration calculations are; - Angular displacements. - Angular accelerations. - Vibratory torques and stresses at shaft sections. - All torsional modes of vibration (natural frequencies and forced",`props_json`:"{\"context_id\": \"knowledge:shaft_torsional\", \"knowledge_layer\": \"reference\", \"data_origin\": \"manufacturer_guidance\", \"applicability\": \"内燃机-发电机传动链一般机理；证据支持扭振导致失效风险及电气故障转矩冲击，但未建立某大型船主轴联轴器断裂的已证实事故链。\", \"coupling_domains\": \"热-机-电\", \"name\": \"检查\", \"graph_version\": \"4.1\", \"is_causal\": false}"}},{`id`:"edge:aa4c596339c6cfa1",`source`:"shipkg:check:5a2af85dcbf4",`target`:"shipkg:fault:b2aa91be158b",`properties`:{`name`:"检查",`graph_version`:"4.1",`is_causal`:false,`id`:"edge:aa4c596339c6cfa1",`case_id`:"queen_mary2_hf_2010",`certainty`:"reported_action",`certainty_zh`:"报告行动/建议",`evidence_id`:"ev:38d40fe90e8b2dbf",`source_file`:"MAIB_2011_28_Queen_Mary_2_harmonic_filter_failure.pdf",`source_url`:"https://assets.digital.cabinet-office.gov.uk/media/547c6fa6ed915d4c10000031/QM2Report.pdf",`page`:"69",`locator`:"PDF page 69",`quote`:"when there are no alternative or back-up systems, must fail safe. They should also be tested at regular intervals to verify that all the sub-components in the system are functional. [2.4.5] 7 . Awareness of arc-flash hazards needs to be significantly increased throughout the marine industry, so that designers, builders, owners, operators and engineers understand the hazard, risks and the potential risk redu",`props_json`:"{\"name\": \"检查\", \"graph_version\": \"4.1\", \"is_causal\": false}"}},{`id`:"edge:b8ac6af4bce1c7b7",`source`:"shipkg:check:cf70a74f2d91",`target`:"shipkg:fault:ce4fe75e21d8",`properties`:{`context_id`:"knowledge:bearing_seizure",`knowledge_layer`:"reference",`data_origin`:"manufacturer_guidance",`applicability`:"主机滑动轴承；烧瓦是检索用的工程统称，不能把全部轴瓦疲劳、瓦片转位或轴承失效直接标成已证实烧瓦。",`coupling_domains`:"热-机",`name`:"检查",`graph_version`:"4.1",`is_causal`:false,`id`:"edge:b8ac6af4bce1c7b7",`case_id`:"knowledge:bearing_seizure",`certainty`:"guidance",`certainty_zh`:"厂家一般机理/指导（须核对机型）",`evidence_id`:"ev:561c84866e09149d",`source_file`:"MAN_SL2013_569_bearing_wear_monitoring.pdf",`source_url`:"https://www.man-es.com/docs/default-source/service-letters/sl2013-569.pdf",`page`:"4",`locator`:"PDF page 4",`quote`:"2013-569/HWC Bearing Wear Monitoring. Page 4 of 4 Encl. 2a of 2 Bearing Wear Monitoring Procedures for Checking for Update Status Ability to detect rapidly developing bearing damage Kongsberg Maritime The ability to detect rapid wear can be checked in the fol - lowing manner: From the Navigator panel “Bearing wear” is selected. If a screen named “Rapid wear” appears, the system is ca- pable of early detectio",`props_json`:"{\"context_id\": \"knowledge:bearing_seizure\", \"knowledge_layer\": \"reference\", \"data_origin\": \"manufacturer_guidance\", \"applicability\": \"主机滑动轴承；烧瓦是检索用的工程统称，不能把全部轴瓦疲劳、瓦片转位或轴承失效直接标成已证实烧瓦。\", \"coupling_domains\": \"热-机\", \"name\": \"检查\", \"graph_version\": \"4.1\", \"is_causal\": false}"}},{`id`:"edge:bf07e6903aa4cc76",`source`:"shipkg:check:fa162d9e9a3f",`target`:"shipkg:cause:0b368a5a5869",`properties`:{`name`:"检查",`graph_version`:"4.1",`is_causal`:false,`id`:"edge:bf07e6903aa4cc76",`case_id`:"wight_sky_me4_2018",`certainty`:"derived_action",`certainty_zh`:"依据报告整理的检查建议",`evidence_id`:"ev:c74257f47f29e86a",`source_file`:"MAIB_2022_04_Wight_Sky_multiple_engine_failures.pdf",`source_url`:"https://assets.publishing.service.gov.uk/media/6267cc85e90e071690c1b679/2022-4-WightSky-Report.pdf",`page`:"72",`locator`:"PDF page 72",`quote`:"ble to determine why the technician made such a basic error. However, the engine manufacturer’s investigation identified that the serial numbers on the connecting rods and caps were not routinely checked to ensure that they matched following assembly. To mitigate the risk of similar errors, Volvo Penta introduced an improved method of identifying and matching the connecting rods into its production process. 2.4 OTHER WIGHT CLASS",`props_json`:"{\"name\": \"检查\", \"graph_version\": \"4.1\", \"is_causal\": false}"}},{`id`:"edge:c3c47266c8b691ba",`source`:"shipkg:check:7015063ef15d",`target`:"shipkg:condition:0abf74811b34",`properties`:{`context_id`:"knowledge:cooling_cavitation",`knowledge_layer`:"reference",`data_origin`:"manufacturer_guidance",`applicability`:"扫气空气冷却器水侧；该证据描述低流量局部沸腾及管路汽蚀，不等同于已证明所有冷却泵汽蚀由此引起。",`coupling_domains`:"热-机",`name`:"检查",`graph_version`:"4.1",`is_causal`:false,`id`:"edge:c3c47266c8b691ba",`case_id`:"knowledge:cooling_cavitation",`certainty`:"derived_action",`certainty_zh`:"依据报告整理的检查建议",`evidence_id`:"ev:a4b9b5883574eb17",`source_file`:"MAN_main_engine_auxiliary_efficiency.pdf",`source_url`:"https://www.man-es.com/docs/default-source/document-sync/efficiency-improvements-main-engine-auxiliary-systems-eng.pdf",`page`:"11",`locator`:"PDF page 11",`quote`:"exceeded, and the engine may thereby not fulfil the Tier II NO X requirements. On this basis, a system has to be established that maintains a constant cooling water flow to the scavenge air cooler and, at the same time, makes it possible to reduce the flow to the LO and jacket water coolers, see Fig. 13. The total flow versus engine load can be obtained by taking the approach that the water flow",`props_json`:"{\"context_id\": \"knowledge:cooling_cavitation\", \"knowledge_layer\": \"reference\", \"data_origin\": \"manufacturer_guidance\", \"applicability\": \"扫气空气冷却器水侧；该证据描述低流量局部沸腾及管路汽蚀，不等同于已证明所有冷却泵汽蚀由此引起。\", \"coupling_domains\": \"热-机\", \"name\": \"检查\", \"graph_version\": \"4.1\", \"is_causal\": false}"}},{`id`:"edge:c69f85185d1d74c4",`source`:"shipkg:check:c0dd4b8aa6a3",`target`:"shipkg:fault:7dd3cdd4fe58",`properties`:{`context_id`:"knowledge:bearing_electrical_erosion",`knowledge_layer`:"reference",`data_origin`:"manufacturer_guidance",`applicability`:"具有闭合轴电流路径的旋转电机；轴承绝缘和接地刷方案按厂家/机型确定，不能假定全部STAMFORD机型都需要绝缘轴承。",`coupling_domains`:"电-机",`name`:"检查",`graph_version`:"4.1",`is_causal`:false,`id`:"edge:c69f85185d1d74c4",`case_id`:"knowledge:bearing_electrical_erosion",`certainty`:"derived_action",`certainty_zh`:"依据报告整理的检查建议",`evidence_id`:"ev:ac86437a65d64581",`source_file`:"STAMFORD_AGN033_bearing_currents.pdf",`source_url`:"https://www.stamford-avk.com/sites/stamfordavk/files/AGNs/AGN-033_C-Shaft-Bearing-Currents.pdf",`page`:"3",`locator`:"PDF page 3",`quote`:"measured end to end, along the axial length of the alternator’s shaft was in the region of 60mV. The international standards for shaft voltage measurement differs in their determination of acceptable levels for non-insulated bearings, as shown in Table 1. Standard Description Range NEMA MG 1-2014 If the shaft voltage is larger than 300 millivolts peak, bearing insulation should be",`props_json`:"{\"context_id\": \"knowledge:bearing_electrical_erosion\", \"knowledge_layer\": \"reference\", \"data_origin\": \"manufacturer_guidance\", \"applicability\": \"具有闭合轴电流路径的旋转电机；轴承绝缘和接地刷方案按厂家/机型确定，不能假定全部STAMFORD机型都需要绝缘轴承。\", \"coupling_domains\": \"电-机\", \"name\": \"检查\", \"graph_version\": \"4.1\", \"is_causal\": false}"}},{`id`:"edge:cc0ca93956c2f810",`source`:"shipkg:check:02ead897029b",`target`:"shipkg:fault:58d32c38d0ac",`properties`:{`name`:"检查",`graph_version`:"4.1",`is_causal`:false,`id`:"edge:cc0ca93956c2f810",`case_id`:"sd2013_05_missing_filter",`certainty`:"derived_action",`certainty_zh`:"依据报告整理的检查建议",`evidence_id`:"ev:b10e854dd960072c",`source_file`:"MAIB_2013_Safety_Digest_lubrication_bearing_cases.pdf",`source_url`:"https://assets.publishing.service.gov.uk/government/uploads/system/uploads/attachment_data/file/876748/2013-SD2-MAIBSafetyDigest.pdf",`page`:"21",`locator`:"PDF page 21",`quote`:"ate without any problems and the vessel undertook several voyages. However, after the engine failure, the duplex filter was found without a filter cartridge in the on-line filter chamber, and the engine lubricating oil system was contaminated. The contamination caused main bearing seizure, the rotation of bearing shells and the blockage of oil ways, and subsequent oil starvation and",`props_json`:"{\"name\": \"检查\", \"graph_version\": \"4.1\", \"is_causal\": false}"}},{`id`:"edge:cd1430bee1da21a7",`source`:"shipkg:check:64ccf3c3f401",`target`:"shipkg:fault:dddb0abee018",`properties`:{`name`:"检查",`graph_version`:"4.1",`is_causal`:false,`id`:"edge:cd1430bee1da21a7",`case_id`:"sd2016_05_cpp_backup",`certainty`:"reported_action",`certainty_zh`:"报告行动/建议",`evidence_id`:"ev:aee93ed7c1866eb1",`source_file`:"MAIB_2016_Safety_Digest_generator_oil_fire.pdf",`source_url`:"https://assets.publishing.service.gov.uk/media/5e81e5d2d3bf7f13416961fa/2016-SD1-MAIBSafetyDigest.pdf",`page`:"21",`locator`:"PDF page 21",`quote`:"id not fully understand the vessel’s propulsion control system and had not routinely tested their back-up and emergency controls. Regular testing of back-up and emergency control systems, and the conduct of machinery breakdown drills, provide the most effective method of ensuring the crew fully understand their ship’s systems and are best prepared to respond in an emergency. Figure 3: Damage to linkspan, mooring",`props_json`:"{\"name\": \"检查\", \"graph_version\": \"4.1\", \"is_causal\": false}"}},{`id`:"edge:d51f41c5677b1145",`source`:"shipkg:check:de8a5b9844ad",`target`:"shipkg:fault:8027eb707475",`properties`:{`name`:"检查",`graph_version`:"4.1",`is_causal`:false,`id`:"edge:d51f41c5677b1145",`case_id`:"sd2013_03_turning_gear",`certainty`:"derived_action",`certainty_zh`:"依据报告整理的检查建议",`evidence_id`:"ev:d2bfff6df47b53cc",`source_file`:"MAIB_2013_Safety_Digest_lubrication_bearing_cases.pdf",`source_url`:"https://assets.publishing.service.gov.uk/government/uploads/system/uploads/attachment_data/file/876748/2013-SD2-MAIBSafetyDigest.pdf",`page`:"18",`locator`:"PDF page 18",`quote`:"2013 The Lessons 1. The turning gear interlock had not been included within the planned maintenance system on board and there was no record of it having been tested. 2. Control console illumination panels are vital to the safe operation of machinery and should therefore be tested regularly. If problems with visual indication or warning lamps cannot be rectified immediately, they must be repo",`props_json`:"{\"name\": \"检查\", \"graph_version\": \"4.1\", \"is_causal\": false}"}},{`id`:"edge:d635d865ca38c4ac",`source`:"shipkg:check:b9cd13a70a15",`target`:"shipkg:fault:c1ffab11185c",`properties`:{`name`:"检查",`graph_version`:"4.1",`is_causal`:false,`id`:"edge:d635d865ca38c4ac",`case_id`:"sd2016_14_sea_valve",`certainty`:"derived_action",`certainty_zh`:"依据报告整理的检查建议",`evidence_id`:"ev:e7382090fee9962a",`source_file`:"MAIB_2016_Safety_Digest_generator_oil_fire.pdf",`source_url`:"https://assets.publishing.service.gov.uk/media/5e81e5d2d3bf7f13416961fa/2016-SD1-MAIBSafetyDigest.pdf",`page`:"41",`locator`:"PDF page 41",`quote`:"t the valve was fully closed when it was not. Although there was a visual indicator located on the side of the actuator, this was not checked to confirm that the valve was closed prior to removal of the flange bolts. The actuator had previously been repaired. However, the chief engineer, who had only recently joined the vessel, was unaware of the actuator’s poor internal condition (Figures 2 and 3). Figur",`props_json`:"{\"name\": \"检查\", \"graph_version\": \"4.1\", \"is_causal\": false}"}},{`id`:"edge:e45f68f4619ba94f",`source`:"shipkg:check:e3171f6b59e1",`target`:"shipkg:fault:f09e1be695a7",`properties`:{`context_id`:"knowledge:winding_insulation",`knowledge_layer`:"reference",`data_origin`:"manufacturer_guidance",`applicability`:"STAMFORD/AvK发电机；检测与干燥作业须停电隔离，由合格人员依本机手册执行，本文不提供通用阈值或操作命令。",`coupling_domains`:"热-电",`name`:"检查",`graph_version`:"4.1",`is_causal`:false,`id`:"edge:e45f68f4619ba94f",`case_id`:"knowledge:winding_insulation",`certainty`:"guidance",`certainty_zh`:"厂家一般机理/指导（须核对机型）",`evidence_id`:"ev:0e3fac9dc3cdbd8f",`source_file`:"STAMFORD_AGN040_winding_insulation.pdf",`source_url`:"https://www.stamford-avk.com/sites/stamfordavk/files/AGNs/AGN-040_E-Winding-Insulation-System.pdf",`page`:"6",`locator`:"PDF page 6",`quote`:"ce and understanding about the risk of operation of the alternator’s insulation system is required, then the next test would be a Polarization Index - PI Test. The alternator's Insulation Resistance (IR), along with many other critical factors, will have been measured during the STAMFORD | AvK factory processes of manufacture, assembly and test. The alternator will have been",`props_json`:"{\"context_id\": \"knowledge:winding_insulation\", \"knowledge_layer\": \"reference\", \"data_origin\": \"manufacturer_guidance\", \"applicability\": \"STAMFORD/AvK发电机；检测与干燥作业须停电隔离，由合格人员依本机手册执行，本文不提供通用阈值或操作命令。\", \"coupling_domains\": \"热-电\", \"name\": \"检查\", \"graph_version\": \"4.1\", \"is_causal\": false}"}},{`id`:"edge:e60c667ebf1841c7",`source`:"shipkg:check:2ae63dd081a2",`target`:"shipkg:condition:d96dbed6a05c",`properties`:{`name`:"检查",`graph_version`:"4.1",`is_causal`:false,`id`:"edge:e60c667ebf1841c7",`case_id`:"sd2013_12_oily_rag",`certainty`:"reported_action",`certainty_zh`:"报告行动/建议",`evidence_id`:"ev:f5fbae0eb047725b",`source_file`:"MAIB_2013_Safety_Digest_lubrication_bearing_cases.pdf",`source_url`:"https://assets.publishing.service.gov.uk/government/uploads/system/uploads/attachment_data/file/876748/2013-SD2-MAIBSafetyDigest.pdf",`page`:"42",`locator`:"PDF page 42",`quote`:"f waste. Discarded oily materials significantly increase fire risks, especially in hot areas such as engine rooms. 2. Do consider visiting the engine room(s) soon after starting equipment for the first time in the day. Equipment cools down overnight, and restarting it is a vulnerable time because leaks can occur when equipment reaches normal operating temperatures. Also, as this case shows, it provides the opportu",`props_json`:"{\"name\": \"检查\", \"graph_version\": \"4.1\", \"is_causal\": false}"}},{`id`:"edge:e6ab53a8e13e0567",`source`:"shipkg:check:5a856a1f5111",`target`:"shipkg:fault:4de4eeb54341",`properties`:{`context_id`:"knowledge:electrical_oscillation",`knowledge_layer`:"reference",`data_origin`:"research_paper",`applicability`:"2021论文三类船舶的实测电网信号，含轴带发电化学品船；不是所有振荡都超限。DP船风浪影响主要作用于基波与频率，不能一概说风浪显著放大所有谐波。",`coupling_domains`:"机-电",`name`:"检查",`graph_version`:"4.1",`is_causal`:false,`id`:"edge:e6ab53a8e13e0567",`case_id`:"knowledge:electrical_oscillation",`certainty`:"derived_action",`certainty_zh`:"依据报告整理的检查建议",`evidence_id`:"ev:77686b69a8ec6449",`source_file`:"Frontiers_2021_marine_converter_oscillations.pdf",`source_url`:"https://www.frontiersin.org/journals/energy-research/articles/10.3389/fenrg.2020.529756/pdf",`page`:"13",`locator`:"PDF page 13",`quote`:"above described DP ship, a number of factors have to be taken into account: generators ’ prime movers modulated rotational speed, governors, and AVRs settings including droop control for load sharing, power converter parameters, and their control and ﬁnally irregularly modulated load of each drive. Therefore, the work will be pursued. The authors plan to concentrate on ships with elect",`props_json`:"{\"context_id\": \"knowledge:electrical_oscillation\", \"knowledge_layer\": \"reference\", \"data_origin\": \"research_paper\", \"applicability\": \"2021论文三类船舶的实测电网信号，含轴带发电化学品船；不是所有振荡都超限。DP船风浪影响主要作用于基波与频率，不能一概说风浪显著放大所有谐波。\", \"coupling_domains\": \"机-电\", \"name\": \"检查\", \"graph_version\": \"4.1\", \"is_causal\": false}"}},{`id`:"edge:eec6461f4fd0dde2",`source`:"shipkg:check:52bfc5553a79",`target`:"shipkg:cause:3667d8d2e0ca",`properties`:{`name`:"检查",`graph_version`:"4.1",`is_causal`:false,`id`:"edge:eec6461f4fd0dde2",`case_id`:"sd2016_09_cpp_response",`certainty`:"derived_action",`certainty_zh`:"依据报告整理的检查建议",`evidence_id`:"ev:88dffcc589cf9235",`source_file`:"MAIB_2016_Safety_Digest_generator_oil_fire.pdf",`source_url`:"https://assets.publishing.service.gov.uk/media/5e81e5d2d3bf7f13416961fa/2016-SD1-MAIBSafetyDigest.pdf",`page`:"29",`locator`:"PDF page 29",`quote`:"y to bring the vessel back under control before it struck the quay. It was also revealed during the investigation that the system parameters for astern pitch control had been incorrectly set during the commissioning of the propulsion system when the vessel was delivered from the yard. The Lessons 1. If you are expected to manoeuvre a vessel, you should make every effort to familiarise yourself with the controls at yo",`props_json`:"{\"name\": \"检查\", \"graph_version\": \"4.1\", \"is_causal\": false}"}},{`id`:"edge:f3894185e054e017",`source`:"shipkg:check:3b1fdbe04792",`target`:"shipkg:fault:f2f9d4b10a0b",`properties`:{`name`:"检查",`graph_version`:"4.1",`is_causal`:false,`id`:"edge:f3894185e054e017",`case_id`:"sd2016_08_generator_oil",`certainty`:"reported_action",`certainty_zh`:"报告行动/建议",`evidence_id`:"ev:7732c1387876e1fb",`source_file`:"MAIB_2016_Safety_Digest_generator_oil_fire.pdf",`source_url`:"https://assets.publishing.service.gov.uk/media/5e81e5d2d3bf7f13416961fa/2016-SD1-MAIBSafetyDigest.pdf",`page`:"28",`locator`:"PDF page 28",`quote`:"s on the engines exceed acceptable limits. Overall vibration velocity can be measured with very simple instruments. If excessive, frequency analysis of the vibration waveform can often identify the root cause of excessive vibration levels. Figure 3: Example of a thermal image showing ‘hot spots’ on uninsulated sections of the exhaust system",`props_json`:"{\"name\": \"检查\", \"graph_version\": \"4.1\", \"is_causal\": false}"}},{`id`:"edge:f88ba84487c8e409",`source`:"shipkg:check:313a552b87bf",`target`:"shipkg:cause:29f8307f5eed",`properties`:{`name`:"检查",`graph_version`:"4.1",`is_causal`:false,`id`:"edge:f88ba84487c8e409",`case_id`:"finlandia_seaways_me_2018",`certainty`:"derived_action",`certainty_zh`:"依据报告整理的检查建议",`evidence_id`:"ev:33782f93bde6d8a1",`source_file`:"MAIB_2021_02_Finlandia_Seaways_connecting_rod_failure.pdf",`source_url`:"https://www.gov.uk/maib-reports/engine-failure-and-subsequent-fire-on-ro-ro-cargo-vessel-finlandia-seaways-with-1-person-injured",`page`:"56",`locator`:"PDF page 56",`quote`:"d a competent fitter to undertake the specific task of removing the piston pin bushes at its workshops in Klaipeda. Despite this, seven of the intact 11 small ends removed from Finlandia Seaways’ engine were found to have notch damage on the internal surfaces of their small end eyes. Three of Botnia Seaways’ small ends had similar damage and three had evidence of localised heat damage. Although the technical investigations did not identify when the damage had",`props_json`:"{\"name\": \"检查\", \"graph_version\": \"4.1\", \"is_causal\": false}"}}] AS row MATCH (a:ShipKG {id:row.source}), (b:ShipKG {id:row.target}) MERGE (a)-[r:CHECKS {id:row.id}]->(b) SET r += row.properties RETURN count(r) AS processed_44 }
CALL () { UNWIND [{`id`:"edge:22cc33617b12a5be",`source`:"shipkg:vessel:ce08d017f5c9",`target`:"shipkg:vesseltype:3309438ef854",`properties`:{`name`:"船型为",`graph_version`:"4.1",`is_causal`:false,`id`:"edge:22cc33617b12a5be",`case_id`:"windcat8_port_engine_2017",`certainty`:"curated_classification",`certainty_zh`:"研究者分类（非因果结论）",`evidence_id`:"ev:4e45851ecc9eb9f4",`source_file`:"MAIB_2018_01_Windcat8_bearing_failure_fire.pdf",`source_url`:"https://assets.publishing.service.gov.uk/government/uploads/system/uploads/attachment_data/file/683922/MAIBInvReport01_2018.pdf",`page`:"1",`locator`:"PDF page 1",`quote`:"and no injuries. The MAIB investigation identified that the catastrophic damage to Windcat 8’s port main engine was caused by the failure of a piston connecting rod big end shell bearing, which resulted in the connecting rod assembly releasing and penetrating through the engine crankcase. The investigation also identified that: • A high oil temperature alarm prior to the engine failure warranted a more cautious a",`props_json`:"{\"name\": \"船型为\", \"graph_version\": \"4.1\", \"is_causal\": false}"}},{`id`:"edge:2c6f1a13391788b4",`source`:"shipkg:vessel:2ee30864aa2d",`target`:"shipkg:vesseltype:1baadd7689d1",`properties`:{`name`:"船型为",`graph_version`:"4.1",`is_causal`:false,`id`:"edge:2c6f1a13391788b4",`case_id`:"kommandor_susan_dg1_2025",`certainty`:"curated_classification",`certainty_zh`:"研究者分类（非因果结论）",`evidence_id`:"ev:01f3913bd9c46899",`source_file`:"MAIB_2026_10_Kommandor_Susan_generator_bearing_failure.pdf",`source_url`:"https://www.gov.uk/maib-reports/catastrophic-engine-failure-and-subsequent-fire-on-board-the-site-investigation-vessel-kommandor-susan",`page`:"1",`locator`:"PDF page 1",`quote`:"f Forth, Scotland on 25 January 2025 SUMMARY At 1305 on 25 January 2025, the site investigation vessel Kommandor Susan suffered a catastrophic failure of a diesel generator engine while conducting sea trials in the Firth of Forth, Scotland. The failure resulted in an engine room fire and a complete power blackout. The crew responded promptly, extinguished the fire and mustered safely. The vessel lost propu",`props_json`:"{\"name\": \"船型为\", \"graph_version\": \"4.1\", \"is_causal\": false}"}},{`id`:"edge:3a331549a6929c8a",`source`:"shipkg:vessel:a81974e78c4c",`target`:"shipkg:vesseltype:f28be4be5375",`properties`:{`name`:"船型为",`graph_version`:"4.1",`is_causal`:false,`id`:"edge:3a331549a6929c8a",`case_id`:"sd2016_14_sea_valve",`certainty`:"curated_classification",`certainty_zh`:"研究者分类（非因果结论）",`evidence_id`:"ev:b7715f5c139d9453",`source_file`:"MAIB_2016_Safety_Digest_generator_oil_fire.pdf",`source_url`:"https://assets.publishing.service.gov.uk/media/5e81e5d2d3bf7f13416961fa/2016-SD1-MAIBSafetyDigest.pdf",`page`:"40",`locator`:"PDF page 40",`quote`:"33 MAIB Safety Digest 1/2016 CASE 14 Fail to Plan, Plan to Fail Narrative On a fine day, a general cargo vessel was on passage with a cargo of limestone. The master was on watch on the bridge. In the engine room, the chief engineer, motorman and a seaman were undertaking maintenance on one of the two main ballast pumps; the chief engineer",`props_json`:"{\"name\": \"船型为\", \"graph_version\": \"4.1\", \"is_causal\": false}"}},{`id`:"edge:807b66dfcdd4bff8",`source`:"shipkg:vessel:205954d6d86e",`target`:"shipkg:vesseltype:f28be4be5375",`properties`:{`name`:"船型为",`graph_version`:"4.1",`is_causal`:false,`id`:"edge:807b66dfcdd4bff8",`case_id`:"sd2013_05_missing_filter",`certainty`:"curated_classification",`certainty_zh`:"研究者分类（非因果结论）",`evidence_id`:"ev:7116308e5054c090",`source_file`:"MAIB_2013_Safety_Digest_lubrication_bearing_cases.pdf",`source_url`:"https://assets.publishing.service.gov.uk/government/uploads/system/uploads/attachment_data/file/876748/2013-SD2-MAIBSafetyDigest.pdf",`page`:"21",`locator`:"PDF page 21",`quote`:"CASE 5 20 MAIB Safety Digest 2/2013 Narrative A fully loaded cargo ship departed port and proceeded on her voyage. Several days into the passage, the oil mist detector (OMD) on the medium speed diesel main engine alarmed. The duty engineer investigated but could not find any fault with the engine. He",`props_json`:"{\"name\": \"船型为\", \"graph_version\": \"4.1\", \"is_causal\": false}"}},{`id`:"edge:949e25f70b41b18e",`source`:"shipkg:vessel:5466bfcfc864",`target`:"shipkg:vesseltype:bbb73c8d697d",`properties`:{`name`:"船型为",`graph_version`:"4.1",`is_causal`:false,`id`:"edge:949e25f70b41b18e",`case_id`:"spirit_of_discovery_pods_2023",`certainty`:"curated_classification",`certainty_zh`:"研究者分类（非因果结论）",`evidence_id`:"ev:c3429f0fc22579e1",`source_file`:"MAIB_2026_06_Spirit_of_Discovery_propulsion_loss.pdf",`source_url`:"https://www.gov.uk/maib-reports/loss-of-propulsion-in-heavy-weather-experienced-by-the-passenger-vessel-spirit-of-discovery-leading-to-over-100-injuries-and-one-fatality",`page`:"42",`locator`:"PDF page 42",`quote`:"e vessel’s heading. Given the weather conditions at the time, it is almost certain that Spirit of Discovery’s pitching caused the propellers to come out of the water. This caused a sudden reduction in torque on the propulsion motor and led to a very rapid increase in the motors’ rpm. The engine alarm and monitoring system recorded that, immediately before their shutdown, the rpm of each pod’s",`props_json`:"{\"name\": \"船型为\", \"graph_version\": \"4.1\", \"is_causal\": false}"}},{`id`:"edge:ab0e830c01ac6e7b",`source`:"shipkg:vessel:db8f8f17b349",`target`:"shipkg:vesseltype:2973e45389fb",`properties`:{`name`:"船型为",`graph_version`:"4.1",`is_causal`:false,`id`:"edge:ab0e830c01ac6e7b",`case_id`:"finlandia_seaways_me_2018",`certainty`:"curated_classification",`certainty_zh`:"研究者分类（非因果结论）",`evidence_id`:"ev:eb8d9ba0db21fede",`source_file`:"MAIB_2021_02_Finlandia_Seaways_connecting_rod_failure.pdf",`source_url`:"https://www.gov.uk/maib-reports/engine-failure-and-subsequent-fire-on-ro-ro-cargo-vessel-finlandia-seaways-with-1-person-injured",`page`:"9",`locator`:"PDF page 9",`quote`:"ent and Incident Investigation Division and the engine manufacturer, MAN Diesel and Turbo SE. The investigation identified that a fracture of the connecting rod small end had led to the sudden failure of the main engine. The investigation also found that the method used to replace the connecting rod small end piston pin bearing bushes by the vessel manager’s maintenance support contractor had intr",`props_json`:"{\"name\": \"船型为\", \"graph_version\": \"4.1\", \"is_causal\": false}"}},{`id`:"edge:cfa8f58ac479e8ae",`source`:"shipkg:vessel:3cb736742ac6",`target`:"shipkg:vesseltype:bbb73c8d697d",`properties`:{`name`:"船型为",`graph_version`:"4.1",`is_causal`:false,`id`:"edge:cfa8f58ac479e8ae",`case_id`:"queen_mary2_hf_2010",`certainty`:"curated_classification",`certainty_zh`:"研究者分类（非因果结论）",`evidence_id`:"ev:af6ff177f229c6a2",`source_file`:"MAIB_2011_28_Queen_Mary_2_harmonic_filter_failure.pdf",`source_url`:"https://assets.digital.cabinet-office.gov.uk/media/547c6fa6ed915d4c10000031/QM2Report.pdf",`page`:"13",`locator`:"PDF page 13",`quote`:"e suppression spray heads were activated, one in the aft harmonic filter room and the other in the aft main switchboard room. The explosion was triggered by deterioration in the capacitors in the aft HF . Internal arcing between the capacitor plates developed, which vaporised the dielectric medium causing the internal pressure to increase, until it caused the capacitor casing to rupture. Dielectric fluid vapour spr",`props_json`:"{\"name\": \"船型为\", \"graph_version\": \"4.1\", \"is_causal\": false}"}}] AS row MATCH (a:ShipKG {id:row.source}), (b:ShipKG {id:row.target}) MERGE (a)-[r:OF_VESSEL_TYPE {id:row.id}]->(b) SET r += row.properties RETURN count(r) AS processed_45 }
CALL () { UNWIND [{`id`:"edge:2456f1de9ee8e68e",`source`:"shipkg:fault:0b115c0dd100",`target`:"shipkg:faulttype:660e09f63773",`properties`:{`classification_basis`:"人工审核术语分类；不是由该文献证明所有实例根因相同",`name`:"归入故障类别",`graph_version`:"4.1",`is_causal`:false,`id`:"edge:2456f1de9ee8e68e",`case_id`:"knowledge:coolant_blockage",`certainty`:"curated_classification",`certainty_zh`:"研究者分类（非因果结论）",`evidence_id`:"ev:1ac13d5b81e13593",`source_file`:"MAN_SL2016_623_cooling_water.pdf",`source_url`:"https://www.man-es.com/docs/default-source/service-letters/sl2016-623.pdf",`page`:"2",`locator`:"PDF page 2",`quote`:"der head. The damages are often a result of corrosion, restrictions in or blocking of the cooling water flow, which are caused by deposits of limescale and/or rust. In general corrosion may result in leakages and thereby re - duce the lifetime and safety of the engine components. Lime- scale as well as rust deposits will reduce the heat transfer and may result in thermal overload of the com",`props_json`:"{\"classification_basis\": \"人工审核术语分类；不是由该文献证明所有实例根因相同\", \"name\": \"归入故障类别\", \"graph_version\": \"4.1\", \"is_causal\": false}"}},{`id`:"edge:4d3dc3490377ae2b",`source`:"shipkg:fault:655f841ec7d0",`target`:"shipkg:faulttype:8a35cec932af",`properties`:{`classification_basis`:"人工审核术语分类；不是由该文献证明所有实例根因相同",`name`:"归入故障类别",`graph_version`:"4.1",`is_causal`:false,`id`:"edge:4d3dc3490377ae2b",`case_id`:"knowledge:damper_failure",`certainty`:"curated_classification",`certainty_zh`:"研究者分类（非因果结论）",`evidence_id`:"ev:71b1d838f3e59389",`source_file`:"MAN_SL2017_654_torsional_damper.pdf",`source_url`:"https://www.man-es.com/docs/default-source/service-letters/sl2017-654.pdf",`page`:"1",`locator`:"PDF page 1",`quote`:"oil - r educed lube oil supply - c ontaminated lube oil leading to carbon built up internal the damper b y the centrifugal forces will reduce the service life of the torsional vibration damper and may lead to failure before reaching the mentioned operation limits. Indications of a failing torsional vibration damper could be abnormal noise from the torsional vibration damper or any chan",`props_json`:"{\"classification_basis\": \"人工审核术语分类；不是由该文献证明所有实例根因相同\", \"name\": \"归入故障类别\", \"graph_version\": \"4.1\", \"is_causal\": false}"}},{`id`:"edge:4fe16aa347f64479",`source`:"shipkg:fault:f6eb639558ed",`target`:"shipkg:faulttype:84e503bec36b",`properties`:{`classification_basis`:"人工审核术语分类；不是由该文献证明所有实例根因相同",`name`:"归入故障类别",`graph_version`:"4.1",`is_causal`:false,`id`:"edge:4fe16aa347f64479",`case_id`:"knowledge:shaft_torsional",`certainty`:"curated_classification",`certainty_zh`:"研究者分类（非因果结论）",`evidence_id`:"ev:1e17c52e491ed79c",`source_file`:"STAMFORD_AGN235_torsional_analysis.pdf",`source_url`:"https://www.stamford-avk.com/sites/stamfordavk/files/AGNs/AGN-235_A-Generating-Set-Assembly-Torsional-Vibration-Analysis.pdf",`page`:"1",`locator`:"PDF page 1",`quote`:"ng the extremely rapid pressure pulse of a burning air fuel mixture above the piston. The engine produces power in pulses and the pulses can excite very significant resonant responses. The pulsing of the power produced by the combustion process translates to angular vibrations in the crank shaft of the engine. The magnitude of the vibration depends on the number of cylinders in the engine. The movement of an i",`props_json`:"{\"classification_basis\": \"人工审核术语分类；不是由该文献证明所有实例根因相同\", \"name\": \"归入故障类别\", \"graph_version\": \"4.1\", \"is_causal\": false}"}},{`id`:"edge:554fb67487d5e1d1",`source`:"shipkg:fault:ad105e83a5af",`target`:"shipkg:faulttype:bff048b48ff1",`properties`:{`classification_basis`:"人工审核术语分类；不是由该文献证明所有实例根因相同",`name`:"归入故障类别",`graph_version`:"4.1",`is_causal`:false,`id`:"edge:554fb67487d5e1d1",`case_id`:"knowledge:generator_bearing_wear",`certainty`:"curated_classification",`certainty_zh`:"研究者分类（非因果结论）",`evidence_id`:"ev:65e2c4b3facd8c2b",`source_file`:"STAMFORD_AGN076_alternator_bearings.pdf",`source_url`:"https://www.stamford-avk.com/sites/stamfordavk/files/2024-04/AGN076_C.pdf",`page`:"4",`locator`:"PDF page 4",`quote`:"t fail because of axial vibration, causing a fretting action in the housing, the cylindrical roller bearing might fail because of lack of grease or misalignment damage. The anti-friction ball bearings used on STAMFORD alternators are not insulated bearings. The design of STAMFORD alternators is such that the shaft does not come under the influence of magnetic fields that result in excessive vol",`props_json`:"{\"classification_basis\": \"人工审核术语分类；不是由该文献证明所有实例根因相同\", \"name\": \"归入故障类别\", \"graph_version\": \"4.1\", \"is_causal\": false}"}},{`id`:"edge:74d164bef7c37e77",`source`:"shipkg:fault:4de4eeb54341",`target`:"shipkg:faulttype:796439daaa03",`properties`:{`classification_basis`:"人工审核术语分类；不是由该文献证明所有实例根因相同",`name`:"归入故障类别",`graph_version`:"4.1",`is_causal`:false,`id`:"edge:74d164bef7c37e77",`case_id`:"knowledge:electrical_oscillation",`certainty`:"curated_classification",`certainty_zh`:"研究者分类（非因果结论）",`evidence_id`:"ev:d85a741773e8f8b9",`source_file`:"Frontiers_2021_marine_converter_oscillations.pdf",`source_url`:"https://www.frontiersin.org/journals/energy-research/articles/10.3389/fenrg.2020.529756/pdf",`page`:"2",`locator`:"PDF page 2",`quote`:"sed in percentage terms. The limits are 0.5% for frequency and 5% for voltage. Well documented causes of such behavior include pulsating torque of generators’ prime movers and/or ﬂuctuating load, which combined with commonly used droop control method for load sharing, possibly leads to severe short and long-term frequency ﬂuctuations. However, little is known about the osci",`props_json`:"{\"classification_basis\": \"人工审核术语分类；不是由该文献证明所有实例根因相同\", \"name\": \"归入故障类别\", \"graph_version\": \"4.1\", \"is_causal\": false}"}},{`id`:"edge:8b70612cc91373ff",`source`:"shipkg:fault:9d33e738a3d3",`target`:"shipkg:faulttype:6456485708ad",`properties`:{`classification_basis`:"人工审核术语分类；不是由该文献证明所有实例根因相同",`name`:"归入故障类别",`graph_version`:"4.1",`is_causal`:false,`id`:"edge:8b70612cc91373ff",`case_id`:"knowledge:shaft_generator_alignment",`certainty`:"curated_classification",`certainty_zh`:"研究者分类（非因果结论）",`evidence_id`:"ev:9db4aabb400f0aae",`source_file`:"STAMFORD_AGN039_marine_shaft_generators.pdf",`source_url`:"https://www.stamford-avk.com/sites/stamfordavk/files/AGNs/AGN-039_C-Marine-Shaft-Generators.pdf",`page`:"2",`locator`:"PDF page 2",`quote`:"ansion of the hot gearbox, which may well expand and lift the shaft centre line by < 1 mm. If the alignment is not accurate, then excessive vibration is likely to damage the shaft generator. There can also be lots of generator damaging vibration when the main engine is running at slow speeds and also when the ship is in storm conditions, because the ship’s hull flexes and so the gearbox to genera",`props_json`:"{\"classification_basis\": \"人工审核术语分类；不是由该文献证明所有实例根因相同\", \"name\": \"归入故障类别\", \"graph_version\": \"4.1\", \"is_causal\": false}"}},{`id`:"edge:a933310b041781d7",`source`:"shipkg:fault:f09e1be695a7",`target`:"shipkg:faulttype:40cb53a64e31",`properties`:{`classification_basis`:"人工审核术语分类；不是由该文献证明所有实例根因相同",`name`:"归入故障类别",`graph_version`:"4.1",`is_causal`:false,`id`:"edge:a933310b041781d7",`case_id`:"knowledge:winding_insulation",`certainty`:"curated_classification",`certainty_zh`:"研究者分类（非因果结论）",`evidence_id`:"ev:31bd0a2dcc933aac",`source_file`:"STAMFORD_AGN040_winding_insulation.pdf",`source_url`:"https://www.stamford-avk.com/sites/stamfordavk/files/AGNs/AGN-040_E-Winding-Insulation-System.pdf",`page`:"6",`locator`:"PDF page 6",`quote`:"s of just a few MegOhms become more typical. Major factors, which affect and reduce the IR value, start with the winding outhang. Surface moisture, often present in conjunction with surface contamination, are typically the result of prevailing site conditions. Either will seriously reduce measured IR values, and if the root cause that allows this contaminant to be present i",`props_json`:"{\"classification_basis\": \"人工审核术语分类；不是由该文献证明所有实例根因相同\", \"name\": \"归入故障类别\", \"graph_version\": \"4.1\", \"is_causal\": false}"}},{`id`:"edge:c5e2335b46334594",`source`:"shipkg:fault:2c6822dc16f4",`target`:"shipkg:faulttype:ce7933999459",`properties`:{`classification_basis`:"人工审核术语分类；不是由该文献证明所有实例根因相同",`name`:"归入故障类别",`graph_version`:"4.1",`is_causal`:false,`id`:"edge:c5e2335b46334594",`case_id`:"knowledge:liner_scuffing",`certainty`:"curated_classification",`certainty_zh`:"研究者分类（非因果结论）",`evidence_id`:"ev:5fd90f16f36a665e",`source_file`:"MAN_SL2016_633_piston_rings_scuffing.pdf",`source_url`:"https://www.man-es.com/docs/default-source/service-letters/sl2016-633.pdf",`page`:"2",`locator`:"PDF page 2",`quote`:"l film. When the oil film is compromised, the cast iron piston rings, which are in contact with the cast iron liner, may generate high friction and seizures that will not recover (liner scuffing). During scuffing, the surface of the liner is hardened and will need machining to recover before new rings can be run in. Cermet is a composite, part-ceramic, part-metal material. It combines the best properties of a ceramic, i.e",`props_json`:"{\"classification_basis\": \"人工审核术语分类；不是由该文献证明所有实例根因相同\", \"name\": \"归入故障类别\", \"graph_version\": \"4.1\", \"is_causal\": false}"}},{`id`:"edge:d3ce04da2aa38ab5",`source`:"shipkg:fault:ce4fe75e21d8",`target`:"shipkg:faulttype:3353dce7f4ad",`properties`:{`classification_basis`:"人工审核术语分类；不是由该文献证明所有实例根因相同",`name`:"归入故障类别",`graph_version`:"4.1",`is_causal`:false,`id`:"edge:d3ce04da2aa38ab5",`case_id`:"knowledge:bearing_seizure",`certainty`:"curated_classification",`certainty_zh`:"研究者分类（非因果结论）",`evidence_id`:"ev:0523deba67297b7c",`source_file`:"MAN_SL2013_569_bearing_wear_monitoring.pdf",`source_url`:"https://www.man-es.com/docs/default-source/service-letters/sl2013-569.pdf",`page`:"2",`locator`:"PDF page 2",`quote`:"C A main bearing damage was recently experienced on an MAN B&W S-MC-C main engine of medium bore size. The damage was caused by a sudden ingress of foreign matter into the bearing via the lubricating oil system, and it devel - oped rapidly into a bearing seizure. The engine was equipped with a bearing wear monitoring (BWM) system as recommended by MAN Diesel & Turbo (MDT). However, for rea",`props_json`:"{\"classification_basis\": \"人工审核术语分类；不是由该文献证明所有实例根因相同\", \"name\": \"归入故障类别\", \"graph_version\": \"4.1\", \"is_causal\": false}"}},{`id`:"edge:f075c9fecca3fcf0",`source`:"shipkg:fault:7dd3cdd4fe58",`target`:"shipkg:faulttype:6dbd0d51366c",`properties`:{`classification_basis`:"人工审核术语分类；不是由该文献证明所有实例根因相同",`name`:"归入故障类别",`graph_version`:"4.1",`is_causal`:false,`id`:"edge:f075c9fecca3fcf0",`case_id`:"knowledge:bearing_electrical_erosion",`certainty`:"curated_classification",`certainty_zh`:"研究者分类（非因果结论）",`evidence_id`:"ev:0f7534e3f93d98e3",`source_file`:"STAMFORD_AGN033_bearing_currents.pdf",`source_url`:"https://www.stamford-avk.com/sites/stamfordavk/files/AGNs/AGN-033_C-Shaft-Bearing-Currents.pdf",`page`:"1",`locator`:"PDF page 1",`quote`:"porting bearings, consequently any resulting current flow will pass across the rolling element of the bearings, and will initiate electrical erosion of the bearing materials, eventually reducing the low friction expectation of the bearing. It is possible for a single bearing alternator to suffer from shaft bearing currents, but here the current flow path at the drive end of the alternator’s shaft mus",`props_json`:"{\"classification_basis\": \"人工审核术语分类；不是由该文献证明所有实例根因相同\", \"name\": \"归入故障类别\", \"graph_version\": \"4.1\", \"is_causal\": false}"}},{`id`:"edge:f723bbcf2a7901a6",`source`:"shipkg:fault:0ad9453d012b",`target`:"shipkg:faulttype:f8ea1aa17718",`properties`:{`classification_basis`:"人工审核术语分类；不是由该文献证明所有实例根因相同",`name`:"归入故障类别",`graph_version`:"4.1",`is_causal`:false,`id`:"edge:f723bbcf2a7901a6",`case_id`:"knowledge:cooling_cavitation",`certainty`:"curated_classification",`certainty_zh`:"研究者分类（非因果结论）",`evidence_id`:"ev:fbe07737c9447c24",`source_file`:"MAN_main_engine_auxiliary_efficiency.pdf",`source_url`:"https://www.man-es.com/docs/default-source/document-sync/efficiency-improvements-main-engine-auxiliary-systems-eng.pdf",`page`:"11",`locator`:"PDF page 11",`quote`:"d fuel oil consumption. – A flow which is too low may cause local boiling on the water side inside the scavenge air cooler, which may lead to cavitation in the cooling water pipes. – The stated max. scavenge air temperature values given in the technical file may be exceeded, and the engine may thereby not fulfil the Tier II NO X requirements. On this basis, a system has to be established that maintains a c",`props_json`:"{\"classification_basis\": \"人工审核术语分类；不是由该文献证明所有实例根因相同\", \"name\": \"归入故障类别\", \"graph_version\": \"4.1\", \"is_causal\": false}"}},{`id`:"edge:fb3714370d60b45b",`source`:"shipkg:fault:7c36cc5888d4",`target`:"shipkg:faulttype:12275851bbd1",`properties`:{`classification_basis`:"人工审核术语分类；不是由该文献证明所有实例根因相同",`name`:"归入故障类别",`graph_version`:"4.1",`is_causal`:false,`id`:"edge:fb3714370d60b45b",`case_id`:"knowledge:coupling_failure",`certainty`:"curated_classification",`certainty_zh`:"研究者分类（非因果结论）",`evidence_id`:"ev:d3e64cd30311c1bb",`source_file`:"MAIB_2017_20_Hebrides_CPP_coupling.pdf",`source_url`:"https://assets.publishing.service.gov.uk/media/59b7ab1c40f0b61231e71a54/MAIBInvReport20_2017.pdf",`page`:"35",`locator`:"PDF page 35",`quote`:"s caused by the loosening of a setscrew used to attach a coupling to a stepper motor shaft due to its lack of rundown torque, the absence of thread locking fluid, and vibration during the actuator’s operation. [2.2] 3. The absence of service instructions for the actuator’s inspection and maintenance that were available from its manufacturer was pivotal to the failure. [2.3] 4. No thread l",`props_json`:"{\"classification_basis\": \"人工审核术语分类；不是由该文献证明所有实例根因相同\", \"name\": \"归入故障类别\", \"graph_version\": \"4.1\", \"is_causal\": false}"}}] AS row MATCH (a:ShipKG {id:row.source}), (b:ShipKG {id:row.target}) MERGE (a)-[r:INSTANCE_OF {id:row.id}]->(b) SET r += row.properties RETURN count(r) AS processed_46 }
CALL () { UNWIND [{`id`:"edge:24649f6af55a11fd",`source`:"shipkg:condition:7647f12090ef",`target`:"shipkg:fault:f078b5a27275",`properties`:{`name`:"增加风险",`graph_version`:"4.1",`is_causal`:true,`id`:"edge:24649f6af55a11fd",`case_id`:"sd2016_05_cpp_backup",`certainty`:"reported",`certainty_zh`:"报告明确记载",`evidence_id`:"ev:4812bf9684b2b7ad",`source_file`:"MAIB_2016_Safety_Digest_generator_oil_fire.pdf",`source_url`:"https://assets.publishing.service.gov.uk/media/5e81e5d2d3bf7f13416961fa/2016-SD1-MAIBSafetyDigest.pdf",`page`:"21",`locator`:"PDF page 21",`quote`:"14 MAIB Safety Digest 1/2016 CASE 5 The Lessons 1. Ergonomically, the layout of the bridge console was not well designed. The close proximity of the safety-critical propulsion control buttons and the similar looking everyday use dimmer buttons, increased the likelihood of the type of human error seen in this case. There is always a risk that watchkeepers and equipment operators will inadvertently press the wrong butto",`props_json`:"{\"name\": \"增加风险\", \"graph_version\": \"4.1\", \"is_causal\": true}"}},{`id`:"edge:2b6a03692c5ae278",`source`:"shipkg:fault:f6eb639558ed",`target`:"shipkg:fault:64f6c42af0db",`properties`:{`context_id`:"knowledge:shaft_torsional",`knowledge_layer`:"reference",`data_origin`:"manufacturer_guidance",`applicability`:"内燃机-发电机传动链一般机理；证据支持扭振导致失效风险及电气故障转矩冲击，但未建立某大型船主轴联轴器断裂的已证实事故链。",`coupling_domains`:"热-机-电",`name`:"增加风险",`graph_version`:"4.1",`is_causal`:true,`id`:"edge:2b6a03692c5ae278",`case_id`:"knowledge:shaft_torsional",`certainty`:"guidance",`certainty_zh`:"厂家一般机理/指导（须核对机型）",`evidence_id`:"ev:37c159b04a8c6f70",`source_file`:"STAMFORD_AGN235_torsional_analysis.pdf",`source_url`:"https://www.stamford-avk.com/sites/stamfordavk/files/AGNs/AGN-235_A-Generating-Set-Assembly-Torsional-Vibration-Analysis.pdf",`page`:"2",`locator`:"PDF page 2",`quote`:"n a Generating Set. A TVA is required to measure the angular vibration against acceptable limits. A TVA should be performed:  To prevent fatigue or wear damage to the engine, alternator or the attached drivetrain system.  To minimize product noise and sound quality.  To improve equipment performance.  To avoid annoying vibrations transmitted to other parts of the machine.  To avoid",`props_json`:"{\"context_id\": \"knowledge:shaft_torsional\", \"knowledge_layer\": \"reference\", \"data_origin\": \"manufacturer_guidance\", \"applicability\": \"内燃机-发电机传动链一般机理；证据支持扭振导致失效风险及电气故障转矩冲击，但未建立某大型船主轴联轴器断裂的已证实事故链。\", \"coupling_domains\": \"热-机-电\", \"name\": \"增加风险\", \"graph_version\": \"4.1\", \"is_causal\": true}"}},{`id`:"edge:740e9eb1e7a243da",`source`:"shipkg:cause:29f8307f5eed",`target`:"shipkg:fault:4e2929b80b35",`properties`:{`name`:"增加风险",`graph_version`:"4.1",`is_causal`:true,`id`:"edge:740e9eb1e7a243da",`case_id`:"finlandia_seaways_me_2018",`certainty`:"reported",`certainty_zh`:"报告明确记载",`evidence_id`:"ev:ed4a18d326cb49be",`source_file`:"MAIB_2021_02_Finlandia_Seaways_connecting_rod_failure.pdf",`source_url`:"https://www.gov.uk/maib-reports/engine-failure-and-subsequent-fire-on-ro-ro-cargo-vessel-finlandia-seaways-with-1-person-injured",`page`:"9",`locator`:"PDF page 9",`quote`:"used to replace the connecting rod small end piston pin bearing bushes by the vessel manager’s maintenance support contractor had introduced stress raisers that signficantly increased the likelihood of crack initiation and fatigue failure. Other factors that contributed to the engine failure included: standards of maintenance management; lack of appreciation of the importance of following the engine manufacturer’s instructions for the removal and refitting of the",`props_json`:"{\"name\": \"增加风险\", \"graph_version\": \"4.1\", \"is_causal\": true}"}},{`id`:"edge:74e694c52d1695ff",`source`:"shipkg:condition:ef4f2a093081",`target`:"shipkg:fault:3349e319bedc",`properties`:{`name`:"增加风险",`graph_version`:"4.1",`is_causal`:true,`id`:"edge:74e694c52d1695ff",`case_id`:"stena_europe_fuel_2023",`certainty`:"reported",`certainty_zh`:"报告明确记载",`evidence_id`:"ev:fc52e39e8b1fe63a",`source_file`:"MAIB_2024_20_Stena_Europe_fuel_spray_fire.pdf",`source_url`:"https://assets.publishing.service.gov.uk/media/6756db0ba63e1781efb87793/2024-20-StenaEurope.pdf",`page`:"29",`locator`:"PDF page 29",`quote`:"s. The opportunity to fit the modified flange connection to the external fuel systems on the remaining engines was missed and the risk of fuel leakage remained high. [2.3. 1] 4. Much of the insulation and shielding on all of Stena Europe’s engines was in a poor state of repair or missing completely. The ship’s crew and shore management had become accustomed to this condition over time, possi",`props_json`:"{\"name\": \"增加风险\", \"graph_version\": \"4.1\", \"is_causal\": true}"}},{`id`:"edge:bc16de904459ec48",`source`:"shipkg:condition:37dbebf86df6",`target`:"shipkg:fault:562580f2bf5a",`properties`:{`name`:"增加风险",`graph_version`:"4.1",`is_causal`:true,`id`:"edge:bc16de904459ec48",`case_id`:"pride_can_cpp_2014",`certainty`:"reported",`certainty_zh`:"报告明确记载",`evidence_id`:"ev:169a62f5f3bc2de6",`source_file`:"MAIB_2015_22_Pride_of_Canterbury_CPP_hydraulic_fire.pdf",`source_url`:"https://assets.digital.cabinet-office.gov.uk/media/563092daed915d566d000002/MAIBInvReport-22_2015.pdf",`page`:"30",`locator`:"PDF page 30",`quote`:"from the OD box were protected. Critically, in the zone between the two starboard main engines where the leak occurred, there was no evidence after the fire of shielding on the flanged joints. Given the port side arrangement had no shielding for the same joints (Figure 19), it is concluded unlikely that shielding was ever in place on the starboard side. Although surveyed and inspected on a regular basis, the omission",`props_json`:"{\"name\": \"增加风险\", \"graph_version\": \"4.1\", \"is_causal\": true}"}},{`id`:"edge:d48112dab1dcd5a0",`source`:"shipkg:condition:8012db626950",`target`:"shipkg:fault:256ba55c5fb2",`properties`:{`name`:"增加风险",`graph_version`:"4.1",`is_causal`:true,`id`:"edge:d48112dab1dcd5a0",`case_id`:"stena_europe_fuel_2023",`certainty`:"reported",`certainty_zh`:"报告明确记载",`evidence_id`:"ev:3b167c1e7ff25a89",`source_file`:"MAIB_2024_20_Stena_Europe_fuel_spray_fire.pdf",`source_url`:"https://assets.publishing.service.gov.uk/media/6756db0ba63e1781efb87793/2024-20-StenaEurope.pdf",`page`:"29",`locator`:"PDF page 29",`quote`:"-screw flange within the fuel oil pipework loosened. [2.2] 2. The fuel oil spray was allowed to reach the hot surface because the joint was not protected by anti-splashing tape or shielding and fuel was able to escape forcefully. [2.3.2] 3. The engine manufacturer’s recommended fuel system modification had been fitted to the external fuel system of just one of Stena Europe’s four main engines. The opportunity to fit",`props_json`:"{\"name\": \"增加风险\", \"graph_version\": \"4.1\", \"is_causal\": true}"}}] AS row MATCH (a:ShipKG {id:row.source}), (b:ShipKG {id:row.target}) MERGE (a)-[r:INCREASES_RISK_OF {id:row.id}]->(b) SET r += row.properties RETURN count(r) AS processed_47 }
CALL () { UNWIND [{`id`:"edge:2567df4a8d750e32",`source`:"shipkg:fault:d005e46c6652",`target`:"shipkg:consequence:7de07882b364",`properties`:{`name`:"加重后果",`graph_version`:"4.1",`is_causal`:true,`id`:"edge:2567df4a8d750e32",`case_id`:"spirit_of_discovery_pods_2023",`certainty`:"reported",`certainty_zh`:"报告明确记载",`evidence_id`:"ev:a61057fac0fe1035",`source_file`:"MAIB_2026_06_Spirit_of_Discovery_propulsion_loss.pdf",`source_url`:"https://www.gov.uk/maib-reports/loss-of-propulsion-in-heavy-weather-experienced-by-the-passenger-vessel-spirit-of-discovery-leading-to-over-100-injuries-and-one-fatality",`page`:"51",`locator`:"PDF page 51",`quote`:"e vessel. [2.3.1] 3. The loss of control was exacerbated by the initiation of the pod’s water leakage stop sequence, which led to both pods being parked at 90° to the vessel’s heading. This caused the vessel to lose steerage, its bow to swing to port and its motion to become even more severe. [2.3.1] 4. The vessel’s propulsion control system was unable to prevent the loss of propulsion when its movement was wi",`props_json`:"{\"name\": \"加重后果\", \"graph_version\": \"4.1\", \"is_causal\": true}"}},{`id`:"edge:7313eba4e604d89f",`source`:"shipkg:condition:ef7365f4e337",`target`:"shipkg:fault:ce4fe75e21d8",`properties`:{`context_id`:"knowledge:bearing_seizure",`knowledge_layer`:"reference",`data_origin`:"manufacturer_guidance",`applicability`:"主机滑动轴承；烧瓦是检索用的工程统称，不能把全部轴瓦疲劳、瓦片转位或轴承失效直接标成已证实烧瓦。",`coupling_domains`:"热-机",`name`:"加重后果",`graph_version`:"4.1",`is_causal`:true,`id`:"edge:7313eba4e604d89f",`case_id`:"knowledge:bearing_seizure",`certainty`:"guidance",`certainty_zh`:"厂家一般机理/指导（须核对机型）",`evidence_id`:"ev:a6b5f4147115c639",`source_file`:"MAN_SL2013_569_bearing_wear_monitoring.pdf",`source_url`:"https://www.man-es.com/docs/default-source/service-letters/sl2013-569.pdf",`page`:"2",`locator`:"PDF page 2",`quote`:"g wear monitoring (BWM) system as recommended by MAN Diesel & Turbo (MDT). However, for reasons not relevant in this context, the crew did not react to the alarm and slow-down signals from the BWM system. Operation of the engine continued until the oil mist detec - tor (OMD) alarm set off and requested slow-down. At this stage, the bearing damage had evolved into a situation where compreh",`props_json`:"{\"context_id\": \"knowledge:bearing_seizure\", \"knowledge_layer\": \"reference\", \"data_origin\": \"manufacturer_guidance\", \"applicability\": \"主机滑动轴承；烧瓦是检索用的工程统称，不能把全部轴瓦疲劳、瓦片转位或轴承失效直接标成已证实烧瓦。\", \"coupling_domains\": \"热-机\", \"name\": \"加重后果\", \"graph_version\": \"4.1\", \"is_causal\": true}"}},{`id`:"edge:7f6a0de1a4eca672",`source`:"shipkg:condition:ff505693e52e",`target`:"shipkg:fault:ae4a492efe41",`properties`:{`name`:"加重后果",`graph_version`:"4.1",`is_causal`:true,`id`:"edge:7f6a0de1a4eca672",`case_id`:"pride_can_cpp_2014",`certainty`:"reported",`certainty_zh`:"报告明确记载",`evidence_id`:"ev:c2f0061fd7fa1953",`source_file`:"MAIB_2015_22_Pride_of_Canterbury_CPP_hydraulic_fire.pdf",`source_url`:"https://assets.digital.cabinet-office.gov.uk/media/563092daed915d566d000002/MAIBInvReport-22_2015.pdf",`page`:"29",`locator`:"PDF page 29",`quote`:"ation of the CPP system as it maintained the overall system pressure. When this component failed to operate correctly, there were no means within the system to effectively relieve excess pressure. In addition, pressure safety valve (PSV1), which enabled pressure to be dissipated into the return line, was set to operate at 145 bar. This was significantly higher than the pressure at which some parts of the system were able",`props_json`:"{\"name\": \"加重后果\", \"graph_version\": \"4.1\", \"is_causal\": true}"}},{`id`:"edge:e6b69b6f97a3c827",`source`:"shipkg:condition:f4f364d25a5d",`target`:"shipkg:consequence:196ff2650762",`properties`:{`name`:"加重后果",`graph_version`:"4.1",`is_causal`:true,`id`:"edge:e6b69b6f97a3c827",`case_id`:"sd2016_14_sea_valve",`certainty`:"reported",`certainty_zh`:"报告明确记载",`evidence_id`:"ev:fb6cf34a58c7fe85",`source_file`:"MAIB_2016_Safety_Digest_generator_oil_fire.pdf",`source_url`:"https://assets.publishing.service.gov.uk/media/5e81e5d2d3bf7f13416961fa/2016-SD1-MAIBSafetyDigest.pdf",`page`:"40",`locator`:"PDF page 40",`quote`:"f water ingress to the cargo hold, all six crew abandoned to one of the lifeboats. The vessel continued to flood (Figure 1), with water entering the accommodation areas through the open engine room doorway. The vessel’s owner contracted salvors, who were able to stop the flooding and, once stable, the vessel was towed into port.",`props_json`:"{\"name\": \"加重后果\", \"graph_version\": \"4.1\", \"is_causal\": true}"}}] AS row MATCH (a:ShipKG {id:row.source}), (b:ShipKG {id:row.target}) MERGE (a)-[r:WORSENS {id:row.id}]->(b) SET r += row.properties RETURN count(r) AS processed_48 }
CALL () { UNWIND [{`id`:"edge:4af275aa2b680929",`source`:"shipkg:symptom:f944832200f3",`target`:"shipkg:fault:0134b2c4ef20",`properties`:{`context_id`:"knowledge:liner_scuffing",`knowledge_layer`:"reference",`data_origin`:"manufacturer_guidance",`applicability`:"MAN B&W两冲程柴油机缸套/活塞环；2016通函用于机理，润滑油选择须查2023通函及本机手册。不能把活塞咬死一概等同于已证实拉缸。",`coupling_domains`:"热-机",`name`:"提示",`graph_version`:"4.1",`is_causal`:false,`id`:"edge:4af275aa2b680929",`case_id`:"knowledge:liner_scuffing",`certainty`:"guidance",`certainty_zh`:"厂家一般机理/指导（须核对机型）",`evidence_id`:"ev:2caee49788bf31ab",`source_file`:"MAN_SL2019_685_ring_coating_wear.pdf",`source_url`:"https://www.man-es.com/docs/default-source/service-letters/sl2019-685.pdf",`page`:"2",`locator`:"PDF page 2",`quote`:"ng, and so forth. The wear of the cermet coating can to some extent be assessed by analysis of drain oil samples. If these have a high iron content, the piston rings and the liners are worn correspondingly. Figure 2: Examples of piston ring packs with cermet coating Alu coating CL-groove Double S-lock Cermet High ring High ring High ring Alu coating CL-groove Double S-lock C",`props_json`:"{\"context_id\": \"knowledge:liner_scuffing\", \"knowledge_layer\": \"reference\", \"data_origin\": \"manufacturer_guidance\", \"applicability\": \"MAN B&W两冲程柴油机缸套/活塞环；2016通函用于机理，润滑油选择须查2023通函及本机手册。不能把活塞咬死一概等同于已证实拉缸。\", \"coupling_domains\": \"热-机\", \"name\": \"提示\", \"graph_version\": \"4.1\", \"is_causal\": false}"}},{`id`:"edge:5744565ed1984fa1",`source`:"shipkg:symptom:0164170e49d6",`target`:"shipkg:fault:655f841ec7d0",`properties`:{`context_id`:"knowledge:damper_failure",`knowledge_layer`:"reference",`data_origin`:"manufacturer_guidance",`applicability`:"MAN L16/24、L21/31、L27/38等通函列明机型；不得推广其维护周期到其它机型。",`coupling_domains`:"热-机",`name`:"提示",`graph_version`:"4.1",`is_causal`:false,`id`:"edge:5744565ed1984fa1",`case_id`:"knowledge:damper_failure",`certainty`:"guidance",`certainty_zh`:"厂家一般机理/指导（须核对机型）",`evidence_id`:"ev:2204971987d93cb0",`source_file`:"MAN_SL2017_654_torsional_damper.pdf",`source_url`:"https://www.man-es.com/docs/default-source/service-letters/sl2017-654.pdf",`page`:"1",`locator`:"PDF page 1",`quote`:"may lead to failure before reaching the mentioned operation limits. Indications of a failing torsional vibration damper could be abnormal noise from the torsional vibration damper or any change in the vibra- tion behavior of the complete GenSet. In such a case, the complete torsional vibration damper must be replaced. For questions or comments please contact operation de",`props_json`:"{\"context_id\": \"knowledge:damper_failure\", \"knowledge_layer\": \"reference\", \"data_origin\": \"manufacturer_guidance\", \"applicability\": \"MAN L16/24、L21/31、L27/38等通函列明机型；不得推广其维护周期到其它机型。\", \"coupling_domains\": \"热-机\", \"name\": \"提示\", \"graph_version\": \"4.1\", \"is_causal\": false}"}},{`id`:"edge:7a90b3df99d23ffe",`source`:"shipkg:symptom:fa4424a6b543",`target`:"shipkg:fault:f078b5a27275",`properties`:{`name`:"提示",`graph_version`:"4.1",`is_causal`:false,`id`:"edge:7a90b3df99d23ffe",`case_id`:"sd2016_05_cpp_backup",`certainty`:"reported",`certainty_zh`:"报告明确记载",`evidence_id`:"ev:b0c29f0e315a7acd",`source_file`:"MAIB_2016_Safety_Digest_generator_oil_fire.pdf",`source_url`:"https://assets.publishing.service.gov.uk/media/5e81e5d2d3bf7f13416961fa/2016-SD1-MAIBSafetyDigest.pdf",`page`:"19",`locator`:"PDF page 19",`quote`:"continued towards the port. However, a few minutes later the engineers in the engine control room noticed that the starboard CPP back-up control system indicator lamp was illuminated on their console. Having not seen this before, they discussed its significance before deciding to take no immediate action. As the vessel entered the port the master reduced speed by decreasing the pitch settings on the port and",`props_json`:"{\"name\": \"提示\", \"graph_version\": \"4.1\", \"is_causal\": false}"}},{`id`:"edge:7b9d6bca057b15ae",`source`:"shipkg:symptom:601948a19d34",`target`:"shipkg:cause:29f8307f5eed",`properties`:{`name`:"提示",`graph_version`:"4.1",`is_causal`:false,`id`:"edge:7b9d6bca057b15ae",`case_id`:"finlandia_seaways_me_2018",`certainty`:"reported",`certainty_zh`:"报告明确记载",`evidence_id`:"ev:b2ab413559094e03",`source_file`:"MAIB_2021_02_Finlandia_Seaways_connecting_rod_failure.pdf",`source_url`:"https://www.gov.uk/maib-reports/engine-failure-and-subsequent-fire-on-ro-ro-cargo-vessel-finlandia-seaways-with-1-person-injured",`page`:"56",`locator`:"PDF page 56",`quote`:"workshops in Klaipeda. Despite this, seven of the intact 11 small ends removed from Finlandia Seaways’ engine were found to have notch damage on the internal surfaces of their small end eyes. Three of Botnia Seaways’ small ends had similar damage and three had evidence of localised heat damage. Although the technical investigations did not identify when the damage had been done, it was clearly apparent that it had be",`props_json`:"{\"name\": \"提示\", \"graph_version\": \"4.1\", \"is_causal\": false}"}},{`id`:"edge:95b6f65a0db377d4",`source`:"shipkg:symptom:9d91c2845b73",`target`:"shipkg:fault:d26785dacafa",`properties`:{`name`:"提示",`graph_version`:"4.1",`is_causal`:false,`id`:"edge:95b6f65a0db377d4",`case_id`:"sd2016_08_generator_oil",`certainty`:"reported",`certainty_zh`:"报告明确记载",`evidence_id`:"ev:5a52dfb1b2f1d73b",`source_file`:"MAIB_2016_Safety_Digest_generator_oil_fire.pdf",`source_url`:"https://assets.publishing.service.gov.uk/media/5e81e5d2d3bf7f13416961fa/2016-SD1-MAIBSafetyDigest.pdf",`page`:"26",`locator`:"PDF page 26",`quote`:"arrative A fully loaded ro-ro passenger ferry was en route to its next port when the engineers in the control room acknowledged a low oil pressure alarm on one of the generators (Figure 1). On the CCTV they observed that oil from this generator was spraying on to the adjacent generator. While they were investigating the source of the leak oil that had been sprayed on the exhaust casing of the adjacent en",`props_json`:"{\"name\": \"提示\", \"graph_version\": \"4.1\", \"is_causal\": false}"}},{`id`:"edge:bc5f87458313894f",`source`:"shipkg:symptom:89c72d5dc590",`target`:"shipkg:consequence:81fff36694d8",`properties`:{`name`:"提示",`graph_version`:"4.1",`is_causal`:false,`id`:"edge:bc5f87458313894f",`case_id`:"sd2016_22_cooling_pipe",`certainty`:"reported",`certainty_zh`:"报告明确记载",`evidence_id`:"ev:e7c09d475a3dc5ea",`source_file`:"MAIB_2016_Safety_Digest_generator_oil_fire.pdf",`source_url`:"https://assets.publishing.service.gov.uk/media/5e81e5d2d3bf7f13416961fa/2016-SD1-MAIBSafetyDigest.pdf",`page`:"59",`locator`:"PDF page 59",`quote`:"on deck sorting a previous catch. The skipper returned to the wheelhouse to investigate the noises and found that the engine room bilge high level alarm was illuminated and sounding. The skipper instructed the engineer to go to the engine room and investigate. The engineer observed that water was almost level with the top of the main engine and was rising quickly. He started the bilge pump but could not reac",`props_json`:"{\"name\": \"提示\", \"graph_version\": \"4.1\", \"is_causal\": false}"}},{`id`:"edge:d1cc2d824057cc25",`source`:"shipkg:symptom:ff3b8fa9a284",`target`:"shipkg:fault:58d32c38d0ac",`properties`:{`name`:"提示",`graph_version`:"4.1",`is_causal`:false,`id`:"edge:d1cc2d824057cc25",`case_id`:"sd2013_05_missing_filter",`certainty`:"reported",`certainty_zh`:"报告明确记载",`evidence_id`:"ev:0c984e504147698d",`source_file`:"MAIB_2013_Safety_Digest_lubrication_bearing_cases.pdf",`source_url`:"https://assets.publishing.service.gov.uk/government/uploads/system/uploads/attachment_data/file/876748/2013-SD2-MAIBSafetyDigest.pdf",`page`:"23",`locator`:"PDF page 23",`quote`:"e not overlooked. 2. One of the advantages of completing daily logs is the ability to assess trends in the operating machinery. A consistently low reading on the filter differential oil pressure gauge, and a comparison with previous operating hours between filter changes, should have rung alarm bells that something was wrong. 3. An oil mist detector gives advance warning of an impending major failure. When a detector alarm occ",`props_json`:"{\"name\": \"提示\", \"graph_version\": \"4.1\", \"is_causal\": false}"}}] AS row MATCH (a:ShipKG {id:row.source}), (b:ShipKG {id:row.target}) MERGE (a)-[r:INDICATES {id:row.id}]->(b) SET r += row.properties RETURN count(r) AS processed_49 }
CALL () { UNWIND [{`id`:"edge:78eb1892f1bf4469",`source`:"shipkg:condition:a9a45fb680fd",`target`:"shipkg:fault:fee4df6aeb24",`properties`:{`name`:"加剧严重度",`graph_version`:"4.1",`is_causal`:true,`id`:"edge:78eb1892f1bf4469",`case_id`:"wight_sky_me2_2018",`certainty`:"reported",`certainty_zh`:"报告明确记载",`evidence_id`:"ev:cf454850540d2ce6",`source_file`:"MAIB_2022_04_Wight_Sky_multiple_engine_failures.pdf",`source_url`:"https://assets.publishing.service.gov.uk/media/6267cc85e90e071690c1b679/2022-4-WightSky-Report.pdf",`page`:"85",`locator`:"PDF page 85",`quote`:"driving one VSP unit in parallel, because of the time it took the fluid couplings to declutch the shutdown engine. [2.8] 16. The inability to immediately declutch and therefore stop an engine when a shutdown signal was given significantly increased the severity of engine damage and the likelihood of explosions and fires. [2.8] 17. The long history of cavitation erosion and cylinder liner and engine block seal failures",`props_json`:"{\"name\": \"加剧严重度\", \"graph_version\": \"4.1\", \"is_causal\": true}"}}] AS row MATCH (a:ShipKG {id:row.source}), (b:ShipKG {id:row.target}) MERGE (a)-[r:INCREASES_SEVERITY_OF {id:row.id}]->(b) SET r += row.properties RETURN count(r) AS processed_50 }
RETURN 491 AS source_nodes, 1185 AS source_relationships, '4.1' AS version;