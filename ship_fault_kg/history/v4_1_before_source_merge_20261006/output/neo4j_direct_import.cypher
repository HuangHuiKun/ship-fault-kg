rigin\": \"controlled_experiment\"}"}},{`id`:"edge:ed9e4e61ea266b36",`source`:"shipkg:faulttype:6456485708ad",`target`:"shipkg:source:44dc69861c93",`properties`:{`name`:"来源于",`graph_version`:"4.1",`is_causal`:false,`id`:"edge:ed9e4e61ea266b36",`case_id`:"knowledge:shaft_generator_alignment",`certainty`:"reported",`certainty_zh`:"报告明确记载",`evidence_id`:"ev:46c70849c9c28abc",`source_file`:"STAMFORD_AGN039_marine_shaft_generators.pdf",`source_url`:"https://www.stamford-avk.com/sites/stamfordavk/files/AGNs/AGN-039_C-Marine-Shaft-Generators.pdf",`page`:"2",`locator`:"PDF page 2",`quote`:"When the shaft generator is aligned with the gearbox drive shaft, the ships design engineer must take great care to allow for the thermal expansion of the hot gearbox, which may well expand and lift the shaft centre line by < 1 mm. If the alignment is not accurate, then excessive vibration is likely to damage the shaft generator. There can also be lots of generator damaging vibration when the",`props_json`:"{\"name\": \"来源于\", \"graph_version\": \"4.1\", \"is_causal\": false}"}},{`id`:"edge:f331bb2d23d88bfe",`source`:"shipkg:sensor:366f77564e58",`target`:"shipkg:source:e12fe2e83b8d",`properties`:{`name`:"来源于",`graph_version`:"4.1",`is_causal`:false,`original_dataset_id`:"shipkg:dataset:1ceeb4cad6d8",`original_dataset_name`:"Marine Engine Fault Dataset (MU323DGSC)",`original_dataset_props`:"{\"data_origin\": \"controlled_experiment\", \"display_name\": \"Marine Engine Fault Dataset (MU323DGSC)\", \"kind_zh\": \"数据集\", \"graph_version\": \"4.1\", \"legacy_kind\": \"Dataset\"}",`legacy_relation`:"HAS_CHANNEL",`legacy_source`:"shipkg:dataset:1ceeb4cad6d8",`legacy_target`:"shipkg:sensor:366f77564e58",`data_origin`:"controlled_experiment",`id`:"edge:f331bb2d23d88bfe",`case_id`:"",`certainty`:"reported",`certainty_zh`:"报告明确记载",`evidence_id`:"ev:1fe44331fadb665a",`source_file`:"Marine_Engine_Fault_Data_v1.zip",`source_url`:"https://zenodo.org/records/19857425",`page`:"",`locator`:"variable_dictionary.csv:No.1 Exh.Gas Temp.",`quote`:"full_name=No.1 Exh.Gas Temp.; symbol=T1; unit=°C; dtype=number; in_reference=TRUE; in_scenario_files=TRUE; category=temperature",`props_json`:"{\"name\": \"来源于\", \"graph_version\": \"4.1\", \"is_causal\": false, \"original_dataset_id\": \"shipkg:dataset:1ceeb4cad6d8\", \"original_dataset_name\": \"Marine Engine Fault Dataset (MU323DGSC)\", \"original_dataset_props\": \"{\\\"data_origin\\\": \\\"controlled_experiment\\\", \\\"display_name\\\": \\\"Marine Engine Fault Dataset (MU323DGSC)\\\", \\\"kind_zh\\\": \\\"数据集\\\", \\\"graph_version\\\": \\\"4.1\\\", \\\"legacy_kind\\\": \\\"Dataset\\\"}\", \"legacy_relation\": \"HAS_CHANNEL\", \"legacy_source\": \"shipkg:dataset:1ceeb4cad6d8\", \"legacy_target\": \"shipkg:sensor:366f77564e58\", \"data_origin\": \"controlled_experiment\"}"}},{`id`:"edge:f76de38e7d57e6dc",`source`:"shipkg:faulttype:8a35cec932af",`target`:"shipkg:source:40e44500f25e",`properties`:{`name`:"来源于",`graph_version`:"4.1",`is_causal`:false,`id`:"edge:f76de38e7d57e6dc",`case_id`:"knowledge:damper_failure",`certainty`:"reported",`certainty_zh`:"报告明确记载",`evidence_id`:"ev:71b1d838f3e59389",`source_file`:"MAN_SL2017_654_torsional_damper.pdf",`source_url`:"https://www.man-es.com/docs/default-source/service-letters/sl2017-654.pdf",`page`:"1",`locator`:"PDF page 1",`quote`:"oil - r educed lube oil supply - c ontaminated lube oil leading to carbon built up internal the damper b y the centrifugal forces will reduce the service life of the torsional vibration damper and may lead to failure before reaching the mentioned operation limits. Indications of a failing torsional vibration damper could be abnormal noise from the torsional vibration damper or any chan",`props_json`:"{\"name\": \"来源于\", \"graph_version\": \"4.1\", \"is_causal\": false}"}},{`id`:"edge:f7d3c136149f9f3e",`source`:"shipkg:case:d6e9f8f8ade2",`target`:"shipkg:source:a4b58f363149",`properties`:{`name`:"来源于",`graph_version`:"4.1",`is_causal`:false,`id`:"edge:f7d3c136149f9f3e",`case_id`:"finlandia_seaways_me_2018",`certainty`:"reported",`certainty_zh`:"报告明确记载",`evidence_id`:"ev:eb8d9ba0db21fede",`source_file`:"MAIB_2021_02_Finlandia_Seaways_connecting_rod_failure.pdf",`source_url`:"https://www.gov.uk/maib-reports/engine-failure-and-subsequent-fire-on-ro-ro-cargo-vessel-finlandia-seaways-with-1-person-injured",`page`:"9",`locator`:"PDF page 9",`quote`:"ent and Incident Investigation Division and the engine manufacturer, MAN Diesel and Turbo SE. The investigation identified that a fracture of the connecting rod small end had led to the sudden failure of the main engine. The investigation also found that the method used to replace the connecting rod small end piston pin bearing bushes by the vessel manager’s maintenance support contractor had intr",`props_json`:"{\"name\": \"来源于\", \"graph_version\": \"4.1\", \"is_causal\": false}"}},{`id`:"edge:f8a997fd212eac55",`source`:"shipkg:faulttype:bff048b48ff1",`target`:"shipkg:source:44dc69861c93",`properties`:{`name`:"来源于",`graph_version`:"4.1",`is_causal`:false,`id`:"edge:f8a997fd212eac55",`case_id`:"knowledge:generator_bearing_wear",`certainty`:"reported",`certainty_zh`:"报告明确记载",`evidence_id`:"ev:e409b2a83322445c",`source_file`:"STAMFORD_AGN039_marine_shaft_generators.pdf",`source_url`:"https://www.stamford-avk.com/sites/stamfordavk/files/AGNs/AGN-039_C-Marine-Shaft-Generators.pdf",`page`:"2",`locator`:"PDF page 2",`quote`:"at many different speeds and for much of this time unexcited, the ships maintenance schedule should include clear guidance about bearing regreasing instructions. It is recommended that the shaft generator is fitted with re- greasable bearings, which should be specified at time of order. When the shaft generator is aligned with the gearbox drive shaft, the ships design engineer must take",`props_json`:"{\"name\": \"来源于\", \"graph_version\": \"4.1\", \"is_causal\": false}"}}] AS row MATCH (a:ShipKG {id:row.source}), (b:ShipKG {id:row.target}) MERGE (a)-[r:DOCUMENTED_BY {id:row.id}]->(b) SET r += row.properties RETURN count(r) AS processed_33 }
CALL () { UNWIND [{`id`:"edge:063d6f3f40f4c6b7",`source`:"shipkg:condition:86fd7df9de11",`target`:"shipkg:fault:4de4eeb54341",`properties`:{`context_id`:"knowledge:electrical_oscillation",`knowledge_layer`:"reference",`data_origin`:"research_paper",`applicability`:"2021论文三类船舶的实测电网信号，含轴带发电化学品船；不是所有振荡都超限。DP船风浪影响主要作用于基波与频率，不能一概说风浪显著放大所有谐波。",`coupling_domains`:"机-电",`name`:"可能促成",`graph_version`:"4.1",`is_causal`:true,`id`:"edge:063d6f3f40f4c6b7",`case_id`:"knowledge:electrical_oscillation",`certainty`:"guidance",`certainty_zh`:"厂家一般机理/指导（须核对机型）",`evidence_id`:"ev:d85a741773e8f8b9",`source_file`:"Frontiers_2021_marine_converter_oscillations.pdf",`source_url`:"https://www.frontiersin.org/journals/energy-research/articles/10.3389/fenrg.2020.529756/pdf",`page`:"2",`locator`:"PDF page 2",`quote`:"sed in percentage terms. The limits are 0.5% for frequency and 5% for voltage. Well documented causes of such behavior include pulsating torque of generators’ prime movers and/or ﬂuctuating load, which combined with commonly used droop control method for load sharing, possibly leads to severe short and long-term frequency ﬂuctuations. However, little is known about the osci",`props_json`:"{\"context_id\": \"knowledge:electrical_oscillation\", \"knowledge_layer\": \"reference\", \"data_origin\": \"research_paper\", \"applicability\": \"2021论文三类船舶的实测电网信号，含轴带发电化学品船；不是所有振荡都超限。DP船风浪影响主要作用于基波与频率，不能一概说风浪显著放大所有谐波。\", \"coupling_domains\": \"机-电\", \"name\": \"可能促成\", \"graph_version\": \"4.1\", \"is_causal\": true}"}},{`id`:"edge:081192cf85580b02",`source`:"shipkg:fault:41a15c8ffad7",`target`:"shipkg:fault:1ff35faef80c",`properties`:{`context_id`:"knowledge:coolant_blockage",`knowledge_layer`:"reference",`data_origin`:"manufacturer_guidance",`applicability`:"MAN四冲程柴油机闭式淡水冷却；水质要求与添加剂须按具体机型手册确认。",`coupling_domains`:"热-机",`name`:"可能促成",`graph_version`:"4.1",`is_causal`:true,`id`:"edge:081192cf85580b02",`case_id`:"knowledge:coolant_blockage",`certainty`:"guidance",`certainty_zh`:"厂家一般机理/指导（须核对机型）",`evidence_id`:"ev:4cdcbf4e0a149c7e",`source_file`:"MAN_SL2016_623_cooling_water.pdf",`source_url`:"https://www.man-es.com/docs/default-source/service-letters/sl2016-623.pdf",`page`:"2",`locator`:"PDF page 2",`quote`:"t in thermal overload of the components to be cooled by the engine cooling water. A thermal overload may, however, also result in cracks and leakages as seen in the exhaust valve seat ring. Insufficient cooling water flow has widespread consequenc - es, in many cases this will influence the combustion process as well and therefore the overall performance and safety of Fig. 1:",`props_json`:"{\"context_id\": \"knowledge:coolant_blockage\", \"knowledge_layer\": \"reference\", \"data_origin\": \"manufacturer_guidance\", \"applicability\": \"MAN四冲程柴油机闭式淡水冷却；水质要求与添加剂须按具体机型手册确认。\", \"coupling_domains\": \"热-机\", \"name\": \"可能促成\", \"graph_version\": \"4.1\", \"is_causal\": true}"}},{`id`:"edge:097b47acb7e2d378",`source`:"shipkg:condition:43c6b88e1884",`target`:"shipkg:fault:f6eb639558ed",`properties`:{`context_id`:"knowledge:shaft_torsional",`knowledge_layer`:"reference",`data_origin`:"manufacturer_guidance",`applicability`:"内燃机-发电机传动链一般机理；证据支持扭振导致失效风险及电气故障转矩冲击，但未建立某大型船主轴联轴器断裂的已证实事故链。",`coupling_domains`:"热-机-电",`name`:"可能促成",`graph_version`:"4.1",`is_causal`:true,`id`:"edge:097b47acb7e2d378",`case_id`:"knowledge:shaft_torsional",`certainty`:"guidance",`certainty_zh`:"厂家一般机理/指导（须核对机型）",`evidence_id`:"ev:1e17c52e491ed79c",`source_file`:"STAMFORD_AGN235_torsional_analysis.pdf",`source_url`:"https://www.stamford-avk.com/sites/stamfordavk/files/AGNs/AGN-235_A-Generating-Set-Assembly-Torsional-Vibration-Analysis.pdf",`page`:"1",`locator`:"PDF page 1",`quote`:"ng the extremely rapid pressure pulse of a burning air fuel mixture above the piston. The engine produces power in pulses and the pulses can excite very significant resonant responses. The pulsing of the power produced by the combustion process translates to angular vibrations in the crank shaft of the engine. The magnitude of the vibration depends on the number of cylinders in the engine. The movement of an i",`props_json`:"{\"context_id\": \"knowledge:shaft_torsional\", \"knowledge_layer\": \"reference\", \"data_origin\": \"manufacturer_guidance\", \"applicability\": \"内燃机-发电机传动链一般机理；证据支持扭振导致失效风险及电气故障转矩冲击，但未建立某大型船主轴联轴器断裂的已证实事故链。\", \"coupling_domains\": \"热-机-电\", \"name\": \"可能促成\", \"graph_version\": \"4.1\", \"is_causal\": true}"}},{`id`:"edge:0f023c81bf9a886b",`source`:"shipkg:condition:20591bbadf85",`target`:"shipkg:fault:655f841ec7d0",`properties`:{`context_id`:"knowledge:damper_failure",`knowledge_layer`:"reference",`data_origin`:"manufacturer_guidance",`applicability`:"MAN L16/24、L21/31、L27/38等通函列明机型；不得推广其维护周期到其它机型。",`coupling_domains`:"热-机",`name`:"可能促成",`graph_version`:"4.1",`is_causal`:true,`id`:"edge:0f023c81bf9a886b",`case_id`:"knowledge:damper_failure",`certainty`:"guidance",`certainty_zh`:"厂家一般机理/指导（须核对机型）",`evidence_id`:"ev:71b1d838f3e59389",`source_file`:"MAN_SL2017_654_torsional_damper.pdf",`source_url`:"https://www.man-es.com/docs/default-source/service-letters/sl2017-654.pdf",`page`:"1",`locator`:"PDF page 1",`quote`:"oil - r educed lube oil supply - c ontaminated lube oil leading to carbon built up internal the damper b y the centrifugal forces will reduce the service life of the torsional vibration damper and may lead to failure before reaching the mentioned operation limits. Indications of a failing torsional vibration damper could be abnormal noise from the torsional vibration damper or any chan",`props_json`:"{\"context_id\": \"knowledge:damper_failure\", \"knowledge_layer\": \"reference\", \"data_origin\": \"manufacturer_guidance\", \"applicability\": \"MAN L16/24、L21/31、L27/38等通函列明机型；不得推广其维护周期到其它机型。\", \"coupling_domains\": \"热-机\", \"name\": \"可能促成\", \"graph_version\": \"4.1\", \"is_causal\": true}"}},{`id`:"edge:20e5a089e38d720a",`source`:"shipkg:condition:212a684d37a2",`target`:"shipkg:fault:655f841ec7d0",`properties`:{`context_id`:"knowledge:damper_failure",`knowledge_layer`:"reference",`data_origin`:"manufacturer_guidance",`applicability`:"MAN L16/24、L21/31、L27/38等通函列明机型；不得推广其维护周期到其它机型。",`coupling_domains`:"热-机",`name`:"可能促成",`graph_version`:"4.1",`is_causal`:true,`id`:"edge:20e5a089e38d720a",`case_id`:"knowledge:damper_failure",`certainty`:"guidance",`certainty_zh`:"厂家一般机理/指导（须核对机型）",`evidence_id`:"ev:66303eda9ce85d8c",`source_file`:"MAN_SL2017_654_torsional_damper.pdf",`source_url`:"https://www.man-es.com/docs/default-source/service-letters/sl2017-654.pdf",`page`:"1",`locator`:"PDF page 1",`quote`:"ses which inevitably lead to wear and tear on the torsional vibration damper. Unfavorable operating conditions such as: - e ngine over-speed - s hocks caused by hydraulic locks in engine cylinders - w ater in the lube oil - r educed lube oil supply - c ontaminated lube oil leading to carbon built up internal the damper b y the centrifugal forces will reduce the servic",`props_json`:"{\"context_id\": \"knowledge:damper_failure\", \"knowledge_layer\": \"reference\", \"data_origin\": \"manufacturer_guidance\", \"applicability\": \"MAN L16/24、L21/31、L27/38等通函列明机型；不得推广其维护周期到其它机型。\", \"coupling_domains\": \"热-机\", \"name\": \"可能促成\", \"graph_version\": \"4.1\", \"is_causal\": true}"}},{`id`:"edge:2435bebde3e9e628",`source`:"shipkg:condition:5b302d0da57d",`target`:"shipkg:fault:ad105e83a5af",`properties`:{`context_id`:"knowledge:generator_bearing_wear",`knowledge_layer`:"reference",`data_origin`:"manufacturer_guidance",`applicability`:"有滚动轴承的发电机或轴带发电机构型；滚动轴承与主机滑动轴瓦的失效机理不得混用。",`coupling_domains`:"热-机-电",`name`:"可能促成",`graph_version`:"4.1",`is_causal`:true,`id`:"edge:2435bebde3e9e628",`case_id`:"knowledge:generator_bearing_wear",`certainty`:"guidance",`certainty_zh`:"厂家一般机理/指导（须核对机型）",`evidence_id`:"ev:65e2c4b3facd8c2b",`source_file`:"STAMFORD_AGN076_alternator_bearings.pdf",`source_url`:"https://www.stamford-avk.com/sites/stamfordavk/files/2024-04/AGN076_C.pdf",`page`:"4",`locator`:"PDF page 4",`quote`:"t fail because of axial vibration, causing a fretting action in the housing, the cylindrical roller bearing might fail because of lack of grease or misalignment damage. The anti-friction ball bearings used on STAMFORD alternators are not insulated bearings. The design of STAMFORD alternators is such that the shaft does not come under the influence of magnetic fields that result in excessive vol",`props_json`:"{\"context_id\": \"knowledge:generator_bearing_wear\", \"knowledge_layer\": \"reference\", \"data_origin\": \"manufacturer_guidance\", \"applicability\": \"有滚动轴承的发电机或轴带发电机构型；滚动轴承与主机滑动轴瓦的失效机理不得混用。\", \"coupling_domains\": \"热-机-电\", \"name\": \"可能促成\", \"graph_version\": \"4.1\", \"is_causal\": true}"}},{`id`:"edge:289ff5abae33adf3",`source`:"shipkg:condition:4e433b14487c",`target`:"shipkg:fault:ad105e83a5af",`properties`:{`context_id`:"knowledge:generator_bearing_wear",`knowledge_layer`:"reference",`data_origin`:"manufacturer_guidance",`applicability`:"有滚动轴承的发电机或轴带发电机构型；滚动轴承与主机滑动轴瓦的失效机理不得混用。",`coupling_domains`:"热-机-电",`name`:"可能促成",`graph_version`:"4.1",`is_causal`:true,`id`:"edge:289ff5abae33adf3",`case_id`:"knowledge:generator_bearing_wear",`certainty`:"guidance",`certainty_zh`:"厂家一般机理/指导（须核对机型）",`evidence_id`:"ev:0bd224f4476f3548",`source_file`:"STAMFORD_AGN076_alternator_bearings.pdf",`source_url`:"https://www.stamford-avk.com/sites/stamfordavk/files/2024-04/AGN076_C.pdf",`page`:"4",`locator`:"PDF page 4",`quote`:"e expected, but the bearings might well be failing for different reasons. For example; where a ball bearing might fail because of axial vibration, causing a fretting action in the housing, the cylindrical roller bearing might fail because of lack of grease or misalignment damage. The anti-friction ball bearings used on STAMFORD alternators are not insulated bearings. The design of STAMFORD alternato",`props_json`:"{\"context_id\": \"knowledge:generator_bearing_wear\", \"knowledge_layer\": \"reference\", \"data_origin\": \"manufacturer_guidance\", \"applicability\": \"有滚动轴承的发电机或轴带发电机构型；滚动轴承与主机滑动轴瓦的失效机理不得混用。\", \"coupling_domains\": \"热-机-电\", \"name\": \"可能促成\", \"graph_version\": \"4.1\", \"is_causal\": true}"}},{`id`:"edge:3525910e48ef80d7",`source`:"shipkg:fault:4de4eeb54341",`target`:"shipkg:consequence:f285f6c5b4a4",`properties`:{`context_id`:"knowledge:electrical_oscillation",`knowledge_layer`:"reference",`data_origin`:"research_paper",`applicability`:"2021论文三类船舶的实测电网信号，含轴带发电化学品船；不是所有振荡都超限。DP船风浪影响主要作用于基波与频率，不能一概说风浪显著放大所有谐波。",`coupling_domains`:"机-电",`name`:"可能促成",`graph_version`:"4.1",`is_causal`:true,`id`:"edge:3525910e48ef80d7",`case_id`:"knowledge:electrical_oscillation",`certainty`:"guidance",`certainty_zh`:"厂家一般机理/指导（须核对机型）",`evidence_id`:"ev:852d00c244f5135b",`source_file`:"Frontiers_2021_marine_converter_oscillations.pdf",`source_url`:"https://www.frontiersin.org/journals/energy-research/articles/10.3389/fenrg.2020.529756/pdf",`page`:"1",`locator`:"PDF page 1",`quote`:"frequency ﬂuctuations can lead to undesirable electrical motors shaft vibration and decrease in their energy efﬁciency and add thermal stress to insulation, thus creating hazardous operating conditions for electrical motors onboard ( Gnaci´nski et al., 2020 ). Frequency ﬂuctuations can also lead to undesirable resonances and cause crucial equipment such as measuring instruments to malfunct",`props_json`:"{\"context_id\": \"knowledge:electrical_oscillation\", \"knowledge_layer\": \"reference\", \"data_origin\": \"research_paper\", \"applicability\": \"2021论文三类船舶的实测电网信号，含轴带发电化学品船；不是所有振荡都超限。DP船风浪影响主要作用于基波与频率，不能一概说风浪显著放大所有谐波。\", \"coupling_domains\": \"机-电\", \"name\": \"可能促成\", \"graph_version\": \"4.1\", \"is_causal\": true}"}},{`id`:"edge:3fa6da5f705760f5",`source`:"shipkg:condition:e3641dbad50c",`target`:"shipkg:condition:3516d66bca42",`properties`:{`context_id`:"knowledge:bearing_electrical_erosion",`knowledge_layer`:"reference",`data_origin`:"manufacturer_guidance",`applicability`:"具有闭合轴电流路径的旋转电机；轴承绝缘和接地刷方案按厂家/机型确定，不能假定全部STAMFORD机型都需要绝缘轴承。",`coupling_domains`:"电-机",`name`:"可能促成",`graph_version`:"4.1",`is_causal`:true,`id`:"edge:3fa6da5f705760f5",`case_id`:"knowledge:bearing_electrical_erosion",`certainty`:"guidance",`certainty_zh`:"厂家一般机理/指导（须核对机型）",`evidence_id`:"ev:9eb024fc4137b406",`source_file`:"STAMFORD_AGN033_bearing_currents.pdf",`source_url`:"https://www.stamford-avk.com/sites/stamfordavk/files/AGNs/AGN-033_C-Shaft-Bearing-Currents.pdf",`page`:"1",`locator`:"PDF page 1",`quote`:"aft within a rotating electrical machine - motor or alternator – to come under the influence of magnetic fields which result in a voltage (electrical pressure) generated along the axial length of the shaft. This ‘shaft voltage’ will then force current to flow from one end of the shaft, along a path which is radially out of the shaft through an end bracket continue along the alternators stator fra",`props_json`:"{\"context_id\": \"knowledge:bearing_electrical_erosion\", \"knowledge_layer\": \"reference\", \"data_origin\": \"manufacturer_guidance\", \"applicability\": \"具有闭合轴电流路径的旋转电机；轴承绝缘和接地刷方案按厂家/机型确定，不能假定全部STAMFORD机型都需要绝缘轴承。\", \"coupling_domains\": \"电-机\", \"name\": \"可能促成\", \"graph_version\": \"4.1\", \"is_causal\": true}"}},{`id`:"edge:4fc2671e35298eb4",`source`:"shipkg:condition:9b800c18cd13",`target`:"shipkg:fault:2c6822dc16f4",`properties`:{`context_id`:"knowledge:liner_scuffing",`knowledge_layer`:"reference",`data_origin`:"manufacturer_guidance",`applicability`:"MAN B&W两冲程柴油机缸套/活塞环；2016通函用于机理，润滑油选择须查2023通函及本机手册。不能把活塞咬死一概等同于已证实拉缸。",`coupling_domains`:"热-机",`name`:"可能促成",`graph_version`:"4.1",`is_causal`:true,`id`:"edge:4fc2671e35298eb4",`case_id`:"knowledge:liner_scuffing",`certainty`:"guidance",`certainty_zh`:"厂家一般机理/指导（须核对机型）",`evidence_id`:"ev:5fd90f16f36a665e",`source_file`:"MAN_SL2016_633_piston_rings_scuffing.pdf",`source_url`:"https://www.man-es.com/docs/default-source/service-letters/sl2016-633.pdf",`page`:"2",`locator`:"PDF page 2",`quote`:"l film. When the oil film is compromised, the cast iron piston rings, which are in contact with the cast iron liner, may generate high friction and seizures that will not recover (liner scuffing). During scuffing, the surface of the liner is hardened and will need machining to recover before new rings can be run in. Cermet is a composite, part-ceramic, part-metal material. It combines the best properties of a ceramic, i.e",`props_json`:"{\"context_id\": \"knowledge:liner_scuffing\", \"knowledge_layer\": \"reference\", \"data_origin\": \"manufacturer_guidance\", \"applicability\": \"MAN B&W两冲程柴油机缸套/活塞环；2016通函用于机理，润滑油选择须查2023通函及本机手册。不能把活塞咬死一概等同于已证实拉缸。\", \"coupling_domains\": \"热-机\", \"name\": \"可能促成\", \"graph_version\": \"4.1\", \"is_causal\": true}"}},{`id`:"edge:5680fead0eff2e39",`source`:"shipkg:condition:0abf74811b34",`target`:"shipkg:condition:654fd1d6ce35",`properties`:{`context_id`:"knowledge:cooling_cavitation",`knowledge_layer`:"reference",`data_origin`:"manufacturer_guidance",`applicability`:"扫气空气冷却器水侧；该证据描述低流量局部沸腾及管路汽蚀，不等同于已证明所有冷却泵汽蚀由此引起。",`coupling_domains`:"热-机",`name`:"可能促成",`graph_version`:"4.1",`is_causal`:true,`id`:"edge:5680fead0eff2e39",`case_id`:"knowledge:cooling_cavitation",`certainty`:"guidance",`certainty_zh`:"厂家一般机理/指导（须核对机型）",`evidence_id`:"ev:2d4645410e75d447",`source_file`:"MAN_main_engine_auxiliary_efficiency.pdf",`source_url`:"https://www.man-es.com/docs/default-source/document-sync/efficiency-improvements-main-engine-auxiliary-systems-eng.pdf",`page`:"11",`locator`:"PDF page 11",`quote`:"ion and thereby increase cylinder wear. – Increased scavenge air temperature which will lead to increased fuel oil consumption. – A flow which is too low may cause local boiling on the water side inside the scavenge air cooler, which may lead to cavitation in the cooling water pipes. – The stated max. scavenge air temperature values given in the technical file may be exceeded, and the engine may thereby",`props_json`:"{\"context_id\": \"knowledge:cooling_cavitation\", \"knowledge_layer\": \"reference\", \"data_origin\": \"manufacturer_guidance\", \"applicability\": \"扫气空气冷却器水侧；该证据描述低流量局部沸腾及管路汽蚀，不等同于已证明所有冷却泵汽蚀由此引起。\", \"coupling_domains\": \"热-机\", \"name\": \"可能促成\", \"graph_version\": \"4.1\", \"is_causal\": true}"}},{`id`:"edge:61750d355e3fed64",`source`:"shipkg:condition:37396a158a92",`target`:"shipkg:fault:9d33e738a3d3",`properties`:{`context_id`:"knowledge:shaft_generator_alignment",`knowledge_layer`:"reference",`data_origin`:"manufacturer_guidance",`applicability`:"通过齿轮箱及联轴器驱动的轴带发电机；不能推广到所有同轴无附加轴承的构型。",`coupling_domains`:"热-机-电",`name`:"可能促成",`graph_version`:"4.1",`is_causal`:true,`id`:"edge:61750d355e3fed64",`case_id`:"knowledge:shaft_generator_alignment",`certainty`:"guidance",`certainty_zh`:"厂家一般机理/指导（须核对机型）",`evidence_id`:"ev:9db4aabb400f0aae",`source_file`:"STAMFORD_AGN039_marine_shaft_generators.pdf",`source_url`:"https://www.stamford-avk.com/sites/stamfordavk/files/AGNs/AGN-039_C-Marine-Shaft-Generators.pdf",`page`:"2",`locator`:"PDF page 2",`quote`:"ansion of the hot gearbox, which may well expand and lift the shaft centre line by < 1 mm. If the alignment is not accurate, then excessive vibration is likely to damage the shaft generator. There can also be lots of generator damaging vibration when the main engine is running at slow speeds and also when the ship is in storm conditions, because the ship’s hull flexes and so the gearbox to genera",`props_json`:"{\"context_id\": \"knowledge:shaft_generator_alignment\", \"knowledge_layer\": \"reference\", \"data_origin\": \"manufacturer_guidance\", \"applicability\": \"通过齿轮箱及联轴器驱动的轴带发电机；不能推广到所有同轴无附加轴承的构型。\", \"coupling_domains\": \"热-机-电\", \"name\": \"可能促成\", \"graph_version\": \"4.1\", \"is_causal\": true}"}},{`id`:"edge:7d6838a1a6475ee5",`source`:"shipkg:condition:654fd1d6ce35",`target`:"shipkg:fault:0ad9453d012b",`properties`:{`context_id`:"knowledge:cooling_cavitation",`knowledge_layer`:"reference",`data_origin`:"manufacturer_guidance",`applicability`:"扫气空气冷却器水侧；该证据描述低流量局部沸腾及管路汽蚀，不等同于已证明所有冷却泵汽蚀由此引起。",`coupling_domains`:"热-机",`name`:"可能促成",`graph_version`:"4.1",`is_causal`:true,`id`:"edge:7d6838a1a6475ee5",`case_id`:"knowledge:cooling_cavitation",`certainty`:"guidance",`certainty_zh`:"厂家一般机理/指导（须核对机型）",`evidence_id`:"ev:fbe07737c9447c24",`source_file`:"MAN_main_engine_auxiliary_efficiency.pdf",`source_url`:"https://www.man-es.com/docs/default-source/document-sync/efficiency-improvements-main-engine-auxiliary-systems-eng.pdf",`page`:"11",`locator`:"PDF page 11",`quote`:"d fuel oil consumption. – A flow which is too low may cause local boiling on the water side inside the scavenge air cooler, which may lead to cavitation in the cooling water pipes. – The stated max. scavenge air temperature values given in the technical file may be exceeded, and the engine may thereby not fulfil the Tier II NO X requirements. On this basis, a system has to be established that maintains a c",`props_json`:"{\"context_id\": \"knowledge:cooling_cavitation\", \"knowledge_layer\": \"reference\", \"data_origin\": \"manufacturer_guidance\", \"applicability\": \"扫气空气冷却器水侧；该证据描述低流量局部沸腾及管路汽蚀，不等同于已证明所有冷却泵汽蚀由此引起。\", \"coupling_domains\": \"热-机\", \"name\": \"可能促成\", \"graph_version\": \"4.1\", \"is_causal\": true}"}},{`id`:"edge:906419b0e1885484",`source`:"shipkg:cause:8a2abf94d478",`target`:"shipkg:fault:aba0717d72a0",`properties`:{`name`:"可能促成",`graph_version`:"4.1",`is_causal`:true,`id`:"edge:906419b0e1885484",`case_id`:"wight_sky_me2_2018",`certainty`:"possible",`certainty_zh`:"可能",`evidence_id`:"ev:f586cbe874297cd1",`source_file`:"MAIB_2022_04_Wight_Sky_multiple_engine_failures.pdf",`source_url`:"https://assets.publishing.service.gov.uk/media/6267cc85e90e071690c1b679/2022-4-WightSky-Report.pdf",`page`:"84",`locator`:"PDF page 84",`quote`:"main journal and crankpin was blocked off when the bearing shells turned in their housing. Poor fuel combustion, the presence of silica sand and other abrasive particles embedded in the main bearing shells, engine misalignment, high levels of vibration, and contaminated lubricating oil might all have contributed to the event failure. [2.3.1] 3. Wight Sky’s ME4 failed catastrophically because of an assembly error during build at Vol",`props_json`:"{\"name\": \"可能促成\", \"graph_version\": \"4.1\", \"is_causal\": true}"}},{`id`:"edge:9f7a4ae4b1796cdb",`source`:"shipkg:condition:2d805325d843",`target`:"shipkg:fault:aba0717d72a0",`properties`:{`name`:"可能促成",`graph_version`:"4.1",`is_causal`:true,`id`:"edge:9f7a4ae4b1796cdb",`case_id`:"wight_sky_me2_2018",`certainty`:"possible",`certainty_zh`:"可能",`evidence_id`:"ev:26718cca28f9fc30",`source_file`:"MAIB_2022_04_Wight_Sky_multiple_engine_failures.pdf",`source_url`:"https://assets.publishing.service.gov.uk/media/6267cc85e90e071690c1b679/2022-4-WightSky-Report.pdf",`page`:"84",`locator`:"PDF page 84",`quote`:"heir housing. Poor fuel combustion, the presence of silica sand and other abrasive particles embedded in the main bearing shells, engine misalignment, high levels of vibration, and contaminated lubricating oil might all have contributed to the event failure. [2.3.1] 3. Wight Sky’s ME4 failed catastrophically because of an assembly error during build at Volvo Penta’s factory in Sweden. Two of the engine’s matched connecting rod big end bearing caps had been trans",`props_json`:"{\"name\": \"可能促成\", \"graph_version\": \"4.1\", \"is_causal\": true}"}},{`id`:"edge:a41f05aa92594419",`source`:"shipkg:condition:f61e4eef7cce",`target`:"shipkg:fault:5737f3610967",`properties`:{`name`:"可能促成",`graph_version`:"4.1",`is_causal`:true,`id`:"edge:a41f05aa92594419",`case_id`:"queen_mary2_hf_2010",`certainty`:"probable",`certainty_zh`:"很可能",`evidence_id`:"ev:1caa6757e63a8feb",`source_file`:"MAIB_2011_28_Queen_Mary_2_harmonic_filter_failure.pdf",`source_url`:"https://assets.digital.cabinet-office.gov.uk/media/547c6fa6ed915d4c10000031/QM2Report.pdf",`page`:"62",`locator`:"PDF page 62",`quote`:"ed lifetime of 20 years due to the operating conditions being harsher than expected. The initial degradation of the capacitor was likely to have been caused by one or both of the following: • being subjected to voltages in excess of their design rating • being exposed to frequent voltage transients due to increased number of switching cycles Failure initiation due to minor manufacturing anomalies s",`props_json`:"{\"name\": \"可能促成\", \"graph_version\": \"4.1\", \"is_causal\": true}"}},{`id`:"edge:d3404c467b3d4cba",`source`:"shipkg:condition:88ba505ebf5b",`target`:"shipkg:fault:41a15c8ffad7",`properties`:{`context_id`:"knowledge:coolant_blockage",`knowledge_layer`:"reference",`data_origin`:"manufacturer_guidance",`applicability`:"MAN四冲程柴油机闭式淡水冷却；水质要求与添加剂须按具体机型手册确认。",`coupling_domains`:"热-机",`name`:"可能促成",`graph_version`:"4.1",`is_causal`:true,`id`:"edge:d3404c467b3d4cba",`case_id`:"knowledge:coolant_blockage",`certainty`:"guidance",`certainty_zh`:"厂家一般机理/指导（须核对机型）",`evidence_id`:"ev:0aa614f9faf8b6fd",`source_file`:"MAN_SL2016_623_cooling_water.pdf",`source_url`:"https://www.man-es.com/docs/default-source/service-letters/sl2016-623.pdf",`page`:"2",`locator`:"PDF page 2",`quote`:"e - duce the lifetime and safety of the engine components. Lime- scale as well as rust deposits will reduce the heat transfer and may result in thermal overload of the components to be cooled by the engine cooling water. A thermal overload may, however, also result in cracks and leakages as seen in the exhaust valve seat ring. Insufficient cooling water flow has widespread consequenc - e",`props_json`:"{\"context_id\": \"knowledge:coolant_blockage\", \"knowledge_layer\": \"reference\", \"data_origin\": \"manufacturer_guidance\", \"applicability\": \"MAN四冲程柴油机闭式淡水冷却；水质要求与添加剂须按具体机型手册确认。\", \"coupling_domains\": \"热-机\", \"name\": \"可能促成\", \"graph_version\": \"4.1\", \"is_causal\": true}"}}] AS row MATCH (a:ShipKG {id:row.source}), (b:ShipKG {id:row.target}) MERGE (a)-[r:MAY_CONTRIBUTE_TO {id:row.id}]->(b) SET r += row.properties RETURN count(r) AS processed_34 }
CALL () { UNWIND [{`id`:"edge:08944f6f37ecd17d",`source`:"shipkg:case:d6e9f8f8ade2",`target`:"shipkg:equipment:aea23b9943a4",`properties`:{`name`:"涉及设备",`graph_version`:"4.1",`is_causal`:false,`id`:"edge:08944f6f37ecd17d",`case_id`:"finlandia_seaways_me_2018",`certainty`:"reported",`certainty_zh`:"报告明确记载",`evidence_id`:"ev:eb8d9ba0db21fede",`source_file`:"MAIB_2021_02_Finlandia_Seaways_connecting_rod_failure.pdf",`source_url`:"https://www.gov.uk/maib-reports/engine-failure-and-subsequent-fire-on-ro-ro-cargo-vessel-finlandia-seaways-with-1-person-injured",`page`:"9",`locator`:"PDF page 9",`quote`:"ent and Incident Investigation Division and the engine manufacturer, MAN Diesel and Turbo SE. The investigation identified that a fracture of the connecting rod small end had led to the sudden failure of the main engine. The investigation also found that the method used to replace the connecting rod small end piston pin bearing bushes by the vessel manager’s maintenance support contractor had intr",`props_json`:"{\"name\": \"涉及设备\", \"graph_version\": \"4.1\", \"is_causal\": false}"}},{`id`:"edge:092b3e8ee71be8c8",`source`:"shipkg:case:213f8edb92c2",`target`:"shipkg:equipment:024350fd8dee",`properties`:{`name`:"涉及设备",`graph_version`:"4.1",`is_causal`:false,`id`:"edge:092b3e8ee71be8c8",`case_id`:"queen_mary2_hf_2010",`certainty`:"reported",`certainty_zh`:"报告明确记载",`evidence_id`:"ev:af6ff177f229c6a2",`source_file`:"MAIB_2011_28_Queen_Mary_2_harmonic_filter_failure.pdf",`source_url`:"https://assets.digital.cabinet-office.gov.uk/media/547c6fa6ed915d4c10000031/QM2Report.pdf",`page`:"13",`locator`:"PDF page 13",`quote`:"e suppression spray heads were activated, one in the aft harmonic filter room and the other in the aft main switchboard room. The explosion was triggered by deterioration in the capacitors in the aft HF . Internal arcing between the capacitor plates developed, which vaporised the dielectric medium causing the internal pressure to increase, until it caused the capacitor casing to rupture. Dielectric fluid vapour spr",`props_json`:"{\"name\": \"涉及设备\", \"graph_version\": \"4.1\", \"is_causal\": false}"}},{`id`:"edge:0c9b494dada80d37",`source`:"shipkg:case:6f58fb8a8b17",`target`:"shipkg:equipment:3e7f89ac810b",`properties`:{`name`:"涉及设备",`graph_version`:"4.1",`is_causal`:false,`id`:"edge:0c9b494dada80d37",`case_id`:"sd2016_22_cooling_pipe",`certainty`:"reported",`certainty_zh`:"报告明确记载",`evidence_id`:"ev:fe1c60aff6da4452",`source_file`:"MAIB_2016_Safety_Digest_generator_oil_fire.pdf",`source_url`:"https://assets.publishing.service.gov.uk/media/5e81e5d2d3bf7f13416961fa/2016-SD1-MAIBSafetyDigest.pdf",`page`:"59",`locator`:"PDF page 59",`quote`:"52 MAIB Safety Digest 1/2016 CASE 22 Supper Would Have Been on Time if the Vessel Had Not Sunk Narrative A 24m steel hulled fishing trawler, with a crew of six, was fishing in calm seas when its engine began to make unusual noises. No-one was in the wheelhouse; the skipper, who was on watch, had gone to the mess room to prepare supper and the majority of the crew wer",`props_json`:"{\"name\": \"涉及设备\", \"graph_version\": \"4.1\", \"is_causal\": false}"}},{`id`:"edge:0d5aaf13da7e3b16",`source`:"shipkg:case:ffc594a9fab7",`target`:"shipkg:equipment:0d7957f0c12c",`properties`:{`name`:"涉及设备",`graph_version`:"4.1",`is_causal`:false,`id`:"edge:0d5aaf13da7e3b16",`case_id`:"sd2013_12_oily_rag",`certainty`:"reported",`certainty_zh`:"报告明确记载",`evidence_id`:"ev:7293e870a8d5467f",`source_file`:"MAIB_2013_Safety_Digest_lubrication_bearing_cases.pdf",`source_url`:"https://assets.publishing.service.gov.uk/government/uploads/system/uploads/attachment_data/file/876748/2013-SD2-MAIBSafetyDigest.pdf",`page`:"40",`locator`:"PDF page 40",`quote`:"CASE 12 39MAIB Safety Digest 2/2013 Narrative It was a clear, bright morning as the crew of a small passenger catamaran arrived on board to carry out their routine pre-sailing checks before their first trip of the day. While the master carried out his navigational aids checks, the mate went to the engine rooms and checked the fuel and main engines",`props_json`:"{\"name\": \"涉及设备\", \"graph_version\": \"4.1\", \"is_causal\": false}"}},{`id`:"edge:1c02eb3bc76cbd7f",`source`:"shipkg:case:9676bd22b5e5",`target`:"shipkg:equipment:5ed28aa334b7",`properties`:{`name`:"涉及设备",`graph_version`:"4.1",`is_causal`:false,`id`:"edge:1c02eb3bc76cbd7f",`case_id`:"sd2013_05_missing_filter",`certainty`:"reported",`certainty_zh`:"报告明确记载",`evidence_id`:"ev:7116308e5054c090",`source_file`:"MAIB_2013_Safety_Digest_lubrication_bearing_cases.pdf",`source_url`:"https://assets.publishing.service.gov.uk/government/uploads/system/uploads/attachment_data/file/876748/2013-SD2-MAIBSafetyDigest.pdf",`page`:"21",`locator`:"PDF page 21",`quote`:"CASE 5 20 MAIB Safety Digest 2/2013 Narrative A fully loaded cargo ship departed port and proceeded on her voyage. Several days into the passage, the oil mist detector (OMD) on the medium speed diesel main engine alarmed. The duty engineer investigated but could not find any fault with the engine. He",`props_json`:"{\"name\": \"涉及设备\", \"graph_version\": \"4.1\", \"is_causal\": false}"}},{`id`:"edge:29e795201e06206f",`source`:"shipkg:case:551512d967af",`target`:"shipkg:equipment:5d25f4bda048",`properties`:{`name`:"涉及设备",`graph_version`:"4.1",`is_causal`:false,`id`:"edge:29e795201e06206f",`case_id`:"sd2013_02_control_air",`certainty`:"reported",`certainty_zh`:"报告明确记载",`evidence_id`:"ev:8b57dbab2f3af128",`source_file`:"MAIB_2013_Safety_Digest_lubrication_bearing_cases.pdf",`source_url`:"https://assets.publishing.service.gov.uk/government/uploads/system/uploads/attachment_data/file/876748/2013-SD2-MAIBSafetyDigest.pdf",`page`:"14",`locator`:"PDF page 14",`quote`:"CASE 2 13MAIB Safety Digest 2/2013 Narrative During passage, the duty engineer on board a ro-ro passenger ferry noticed an oily mist surrounding one of two air compressors (No1). The compressor in question was supplying control air to the vessel’s main engine clutches. The engineer changed over the supply of control air to a second compres",`props_json`:"{\"name\": \"涉及设备\", \"graph_version\": \"4.1\", \"is_causal\": false}"}},{`id`:"edge:3884973f837051d2",`source`:"shipkg:case:1e6479e108d9",`target`:"shipkg:equipment:49d861a78ba3",`properties`:{`name`:"涉及设备",`graph_version`:"4.1",`is_causal`:false,`id`:"edge:3884973f837051d2",`case_id`:"kommandor_susan_dg1_2025",`certainty`:"reported",`certainty_zh`:"报告明确记载",`evidence_id`:"ev:01f3913bd9c46899",`source_file`:"MAIB_2026_10_Kommandor_Susan_generator_bearing_failure.pdf",`source_url`:"https://www.gov.uk/maib-reports/catastrophic-engine-failure-and-subsequent-fire-on-board-the-site-investigation-vessel-kommandor-susan",`page`:"1",`locator`:"PDF page 1",`quote`:"f Forth, Scotland on 25 January 2025 SUMMARY At 1305 on 25 January 2025, the site investigation vessel Kommandor Susan suffered a catastrophic failure of a diesel generator engine while conducting sea trials in the Firth of Forth, Scotland. The failure resulted in an engine room fire and a complete power blackout. The crew responded promptly, extinguished the fire and mustered safely. The vessel lost propu",`props_json`:"{\"name\": \"涉及设备\", \"graph_version\": \"4.1\", \"is_causal\": false}"}},{`id`:"edge:468bbb6d0b21ad7a",`source`:"shipkg:case:8b13bdb1a5bc",`target`:"shipkg:equipment:8c8343c45190",`properties`:{`name`:"涉及设备",`graph_version`:"4.1",`is_causal`:false,`id`:"edge:468bbb6d0b21ad7a",`case_id`:"sd2016_09_cpp_response",`certainty`:"reported",`certainty_zh`:"报告明确记载",`evidence_id`:"ev:e1dce2948e24adc9",`source_file`:"MAIB_2016_Safety_Digest_generator_oil_fire.pdf",`source_url`:"https://assets.publishing.service.gov.uk/media/5e81e5d2d3bf7f13416961fa/2016-SD1-MAIBSafetyDigest.pdf",`page`:"29",`locator`:"PDF page 29",`quote`:"22 MAIB Safety Digest 1/2016 CASE 9 Sluggish Pitch Control Causes Serious Accident Narrative A chemical tanker was being manoeuvred to its designated jetty. As the vessel approached the quay, the pilot ordered an astern movement to enable a turn into the lock. The vessel did not respond and continued to proceed ahead. Despite placing the",`props_json`:"{\"name\": \"涉及设备\", \"graph_version\": \"4.1\", \"is_causal\": false}"}},{`id`:"edge:4f987e939c176b16",`source`:"shipkg:case:00057f56fe39",`target`:"shipkg:equipment:1755b4f618f2",`properties`:{`name`:"涉及设备",`graph_version`:"4.1",`is_causal`:false,`id`:"edge:4f987e939c176b16",`case_id`:"wight_sky_me_2017",`certainty`:"reported",`certainty_zh`:"报告明确记载",`evidence_id`:"ev:19d0b2283f62b511",`source_file`:"MAIB_2018_14_Wight_Sky_engine_bearing_fire.pdf",`source_url`:"https://assets.publishing.service.gov.uk/media/5b5217c7ed915d0b81e003df/MAIBInvReport14_2018.pdf",`page`:"1",`locator`:"PDF page 1",`quote`:"examination conducted by the vessel’s engine maker, Volvo Penta UK, concluded that the most probable trigger for the failure was debris in the engine’s oil channels following rebuild. The MAIB investigation established the following: • The engine had been completely rebuilt and failed after 5½ hours of operation. • The vessel’s soft patches 1 had not been removed, necessitating the engine to be lowered piecem",`props_json`:"{\"name\": \"涉及设备\", \"graph_version\": \"4.1\", \"is_causal\": false}"}},{`id`:"edge:5e7a6c288d988ead",`source`:"shipkg:case:187dc871fbd5",`target`:"shipkg:equipment:710361995928",`properties`:{`name`:"涉及设备",`graph_version`:"4.1",`is_causal`:false,`id`:"edge:5e7a6c288d988ead",`case_id`:"spirit_of_discovery_pods_2023",`certainty`:"reported",`certainty_zh`:"报告明确记载",`evidence_id`:"ev:c3429f0fc22579e1",`source_file`:"MAIB_2026_06_Spirit_of_Discovery_propulsion_loss.pdf",`source_url`:"https://www.gov.uk/maib-reports/loss-of-propulsion-in-heavy-weather-experienced-by-the-passenger-vessel-spirit-of-discovery-leading-to-over-100-injuries-and-one-fatality",`page`:"42",`locator`:"PDF page 42",`quote`:"e vessel’s heading. Given the weather conditions at the time, it is almost certain that Spirit of Discovery’s pitching caused the propellers to come out of the water. This caused a sudden reduction in torque on the propulsion motor and led to a very rapid increase in the motors’ rpm. The engine alarm and monitoring system recorded that, immediately before their shutdown, the rpm of each pod’s",`props_json`:"{\"name\": \"涉及设备\", \"graph_version\": \"4.1\", \"is_causal\": false}"}},{`id`:"edge:6b45075de9331f83",`source`:"shipkg:case:7a1c0165bb56",`target`:"shipkg:equipment:00688defba1b",`properties`:{`name`:"涉及设备",`graph_version`:"4.1",`is_causal`:false,`id`:"edge:6b45075de9331f83",`case_id`:"sd2016_08_generator_oil",`certainty`:"reported",`certainty_zh`:"报告明确记载",`evidence_id`:"ev:7e21ab64015c1360",`source_file`:"MAIB_2016_Safety_Digest_generator_oil_fire.pdf",`source_url`:"https://assets.publishing.service.gov.uk/media/5e81e5d2d3bf7f13416961fa/2016-SD1-MAIBSafetyDigest.pdf",`page`:"26",`locator`:"PDF page 26",`quote`:"19 MAIB Safety Digest 1/2016 CASE 8 Maintenance Induced Fire Narrative A fully loaded ro-ro passenger ferry was en route to its next port when the engineers in the control room acknowledged a low oil pressure alarm on one of the generators (Figure 1). On the CCTV they observed that oil from this generator was spraying on to the adjacen",`props_json`:"{\"name\": \"涉及设备\", \"graph_version\": \"4.1\", \"is_causal\": false}"}},{`id`:"edge:88ab1a090195de96",`source`:"shipkg:case:278d7572ef08",`target`:"shipkg:equipment:6cc9aa419de7",`properties`:{`name`:"涉及设备",`graph_version`:"4.1",`is_causal`:false,`id`:"edge:88ab1a090195de96",`case_id`:"wight_sky_me4_2018",`certainty`:"reported",`certainty_zh`:"报告明确记载",`evidence_id`:"ev:3ca79df2a0332a1a",`source_file`:"MAIB_2022_04_Wight_Sky_multiple_engine_failures.pdf",`source_url`:"https://assets.publishing.service.gov.uk/media/6267cc85e90e071690c1b679/2022-4-WightSky-Report.pdf",`page`:"84",`locator`:"PDF page 84",`quote`:"igh levels of vibration, and contaminated lubricating oil might all have contributed to the event failure. [2.3.1] 3. Wight Sky’s ME4 failed catastrophically because of an assembly error during build at Volvo Penta’s factory in Sweden. Two of the engine’s matched connecting rod big end bearing caps had been transposed during the engine assembly process. [2.3.2] 4. The transposition of the bearing caps reduced the",`props_json`:"{\"name\": \"涉及设备\", \"graph_version\": \"4.1\", \"is_causal\": false}"}},{`id`:"edge:934d4b0ac0cc971f",`source`:"shipkg:case:1f8ffc7c55c3",`target`:"shipkg:equipment:23fe6c4f1acc",`properties`:{`name`:"涉及设备",`graph_version`:"4.1",`is_causal`:false,`id`:"edge:934d4b0ac0cc971f",`case_id`:"pride_can_cpp_2014",`certainty`:"reported",`certainty_zh`:"报告明确记载",`evidence_id`:"ev:8c30394060f9cd2e",`source_file`:"MAIB_2015_22_Pride_of_Canterbury_CPP_hydraulic_fire.pdf",`source_url`:"https://assets.digital.cabinet-office.gov.uk/media/563092daed915d566d000002/MAIBInvReport-22_2015.pdf",`page`:"30",`locator`:"PDF page 30",`quote`:"d, most likely, occurred gradually over a long period of time. 2.3.3 Pipework joints and shielding Whereas the main components of Pride of Canterbury’s CPP system were supplied after testing by the manufacturer, the interconnecting pipework was supplied and fitted by the shipyard when the vessel was constructed. Although the manufacturer’s drawings specified a particular type",`props_json`:"{\"name\": \"涉及设备\", \"graph_version\": \"4.1\", \"is_causal\": false}"}},{`id`:"edge:9c3b9940d47470b3",`source`:"shipkg:case:ad49b658b30b",`target`:"shipkg:equipment:361590fc68c0",`properties`:{`name`:"涉及设备",`graph_version`:"4.1",`is_causal`:false,`id`:"edge:9c3b9940d47470b3",`case_id`:"sd2016_14_sea_valve",`certainty`:"reported",`certainty_zh`:"报告明确记载",`evidence_id`:"ev:b7715f5c139d9453",`source_file`:"MAIB_2016_Safety_Digest_generator_oil_fire.pdf",`source_url`:"https://assets.publishing.service.gov.uk/media/5e81e5d2d3bf7f13416961fa/2016-SD1-MAIBSafetyDigest.pdf",`page`:"40",`locator`:"PDF page 40",`quote`:"33 MAIB Safety Digest 1/2016 CASE 14 Fail to Plan, Plan to Fail Narrative On a fine day, a general cargo vessel was on passage with a cargo of limestone. The master was on watch on the bridge. In the engine room, the chief engineer, motorman and a seaman were undertaking maintenance on one of the two main ballast pumps; the chief engineer",`props_json`:"{\"name\": \"涉及设备\", \"graph_version\": \"4.1\", \"is_causal\": false}"}},{`id`:"edge:bfb0d14c4ff5888e",`source`:"shipkg:case:adf367a46f33",`target`:"shipkg:equipment:61cd855f5970",`properties`:{`name`:"涉及设备",`graph_version`:"4.1",`is_causal`:false,`id`:"edge:bfb0d14c4ff5888e",`case_id`:"wight_sky_me2_2018",`certainty`:"reported",`certainty_zh`:"报告明确记载",`evidence_id`:"ev:4846a9af2b7e6456",`source_file`:"MAIB_2022_04_Wight_Sky_multiple_engine_failures.pdf",`source_url`:"https://assets.publishing.service.gov.uk/media/6267cc85e90e071690c1b679/2022-4-WightSky-Report.pdf",`page`:"84",`locator`:"PDF page 84",`quote`:"S 3.1 SAFETY ISSUES DIRECTLY CONTRIBUTING TO THE ACCIDENTS THAT HAVE BEEN ADDRESSED OR RESULTED IN RECOMMENDATIONS 1. Wight Sky’s ME2 failed catastrophically due to a sudden loss of lubricating oil supply to its number five main journal bearing and number four crankpin. [2.3.1] 2. The oilway to the main journal and crankpin was blocked off when the bearing shells turned in their housing. Poor fuel combustion, the presence of silic",`props_json`:"{\"name\": \"涉及设备\", \"graph_version\": \"4.1\", \"is_causal\": false}"}},{`id`:"edge:c31bc9dea9652958",`source`:"shipkg:case:597875e258c6",`target`:"shipkg:equipment:47a6f6945bb5",`properties`:{`name`:"涉及设备",`graph_version`:"4.1",`is_causal`:false,`id`:"edge:c31bc9dea9652958",`case_id`:"sd2016_05_cpp_backup",`certainty`:"reported",`certainty_zh`:"报告明确记载",`evidence_id`:"ev:96829240b9d90823",`source_file`:"MAIB_2016_Safety_Digest_generator_oil_fire.pdf",`source_url`:"https://assets.publishing.service.gov.uk/media/5e81e5d2d3bf7f13416961fa/2016-SD1-MAIBSafetyDigest.pdf",`page`:"19",`locator`:"PDF page 19",`quote`:"12 MAIB Safety Digest 1/2016 CASE 5 Propelled Onto the Berth Narrative A large roll-on roll-off passenger ferry, operating on its regular route between two European ports, suffered significant damage when it made heavy contact with a linkspan as it was being manoeuvred onto its berth. There were over 500 passengers and crew on board but no",`props_json`:"{\"name\": \"涉及设备\", \"graph_version\": \"4.1\", \"is_causal\": false}"}},{`id`:"edge:ce93f8439e66ac3c",`source`:"shipkg:case:9792cd36162e",`target`:"shipkg:equipment:563809ad0932",`properties`:{`name`:"涉及设备",`graph_version`:"4.1",`is_causal`:false,`id`:"edge:ce93f8439e66ac3c",`case_id`:"windcat8_port_engine_2017",`certainty`:"reported",`certainty_zh`:"报告明确记载",`evidence_id`:"ev:4e45851ecc9eb9f4",`source_file`:"MAIB_2018_01_Windcat8_bearing_failure_fire.pdf",`source_url`:"https://assets.publishing.service.gov.uk/government/uploads/system/uploads/attachment_data/file/683922/MAIBInvReport01_2018.pdf",`page`:"1",`locator`:"PDF page 1",`quote`:"and no injuries. The MAIB investigation identified that the catastrophic damage to Windcat 8’s port main engine was caused by the failure of a piston connecting rod big end shell bearing, which resulted in the connecting rod assembly releasing and penetrating through the engine crankcase. The investigation also identified that: • A high oil temperature alarm prior to the engine failure warranted a more cautious a",`props_json`:"{\"name\": \"涉及设备\", \"graph_version\": \"4.1\", \"is_causal\": false}"}},{`id`:"edge:e102149719c30b36",`source`:"shipkg:case:63aa8b018e0d",`target`:"shipkg:equipment:385291025daa",`properties`:{`name`:"涉及设备",`graph_version`:"4.1",`is_causal`:false,`id`:"edge:e102149719c30b36",`case_id`:"stena_europe_fuel_2023",`certainty`:"reported",`certainty_zh`:"报告明确记载",`evidence_id`:"ev:57049bc52d7488e2",`source_file`:"MAIB_2024_20_Stena_Europe_fuel_spray_fire.pdf",`source_url`:"https://assets.publishing.service.gov.uk/media/6756db0ba63e1781efb87793/2024-20-StenaEurope.pdf",`page`:"7",`locator`:"PDF page 7",`quote`:"mage to the port main engine room and rendered one of its four main engines inoperative for several weeks. The fire was caused by fuel leaking under pressure from the fuel system of main engine number 3 and igniting on an exposed hot surface. No one was injured and there was no pollution. The investigation found that the fuel had ignited on part of the engine’s exhaust system that had",`props_json`:"{\"name\": \"涉及设备\", \"graph_version\": \"4.1\", \"is_causal\": false}"}},{`id`:"edge:f1548e829e0af365",`source`:"shipkg:case:537a034e93e3",`target`:"shipkg:equipment:38482b664e19",`properties`:{`name`:"涉及设备",`graph_version`:"4.1",`is_causal`:false,`id`:"edge:f1548e829e0af365",`case_id`:"sd2013_03_turning_gear",`certainty`:"reported",`certainty_zh`:"报告明确记载",`evidence_id`:"ev:b840391c6c40b9b8",`source_file`:"MAIB_2013_Safety_Digest_lubrication_bearing_cases.pdf",`source_url`:"https://assets.publishing.service.gov.uk/government/uploads/system/uploads/attachment_data/file/876748/2013-SD2-MAIBSafetyDigest.pdf",`page`:"16",`locator`:"PDF page 16",`quote`:"CASE 3 15MAIB Safety Digest 2/2013 Narrative A specialist cargo ship was in port loading a dangerous cargo. As a precaution, the vessel’s slow speed diesel main engine had been tested and was kept at a heightened state of readiness. This involved the fuel being shut off, the main engine indicator",`props_json`:"{\"name\": \"涉及设备\", \"graph_version\": \"4.1\", \"is_causal\": false}"}}] AS row MATCH (a:ShipKG {id:row.source}), (b:ShipKG {id:row.target}) MERGE (a)-[r:HAS_EQUIPMENT {id:row.id}]->(b) SET r += row.properties RETURN count(r) AS processed_35 }
CALL () { UNWIND [{`id`:"edge:08b53075e0cbc35d",`source`:"shipkg:equipment:47a6f6945bb5",`target`:"shipkg:component:ca5637067a12",`properties`:{`name`:"包含部件",`graph_version`:"4.1",`is_causal`:false,`id`:"edge:08b53075e0cbc35d",`case_id`:"sd2016_05_cpp_backup",`certainty`:"reported",`certainty_zh`:"报告明确记载",`evidence_id`:"ev:5a827f088fee8abd",`source_file`:"MAIB_2016_Safety_Digest_generator_oil_fire.pdf",`source_url`:"https://assets.publishing.service.gov.uk/media/5e81e5d2d3bf7f13416961fa/2016-SD1-MAIBSafetyDigest.pdf",`page`:"19",`locator`:"PDF page 19",`quote`:"er being dimmed overnight, the master attempted to adjust the brightness. Distracted by a conversation with the chief officer, he pressed the wrong button (Figure 1) and inadvertently switched the vessel’s starboard controllable pitch propeller (CPP) from its normal control mode to its back-up mode. The error was not spotted by the master or his bridge team as they continued toward",`props_json`:"{\"name\": \"包含部件\", \"graph_version\": \"4.1\", \"is_causal\": false}"}},{`id`:"edge:0eda42296858f964",`source`:"shipkg:equipment:5d25f4bda048",`target`:"shipkg:component:0dcadce61c82",`properties`:{`name`:"包含部件",`graph_version`:"4.1",`is_causal`:false,`id`:"edge:0eda42296858f964",`case_id`:"sd2013_02_control_air",`certainty`:"reported",`certainty_zh`:"报告明确记载",`evidence_id`:"ev:9c5f7101c8442b54",`source_file`:"MAIB_2013_Safety_Digest_lubrication_bearing_cases.pdf",`source_url`:"https://assets.publishing.service.gov.uk/government/uploads/system/uploads/attachment_data/file/876748/2013-SD2-MAIBSafetyDigest.pdf",`page`:"15",`locator`:"PDF page 15",`quote`:"essel was able to berth safely alongside, assisted by harbour tugs. Subsequent investigation identified that No2 compressor had a damaged discharge valve. Neither compressor had been able to keep up with demand.",`props_json`:"{\"name\": \"包含部件\", \"graph_version\": \"4.1\", \"is_causal\": false}"}},{`id`:"edge:1788d18b9c1165b1",`source`:"shipkg:equipment:6cc9aa419de7",`target`:"shipkg:component:2a19cfd5c18a",`properties`:{`name`:"包含部件",`graph_version`:"4.1",`is_causal`:false,`id`:"edge:1788d18b9c1165b1",`case_id`:"wight_sky_me4_2018",`certainty`:"reported",`certainty_zh`:"报告明确记载",`evidence_id`:"ev:45cb3bc7993a557f",`source_file`:"MAIB_2022_04_Wight_Sky_multiple_engine_failures.pdf",`source_url`:"https://assets.publishing.service.gov.uk/media/6267cc85e90e071690c1b679/2022-4-WightSky-Report.pdf",`page`:"84",`locator`:"PDF page 84",`quote`:"y’s ME4 failed catastrophically because of an assembly error during build at Volvo Penta’s factory in Sweden. Two of the engine’s matched connecting rod big end bearing caps had been transposed during the engine assembly process. [2.3.2] 4. The transposition of the bearing caps reduced the metal-to-metal contact between surfaces of the connecting rods and their bearing caps. This would have caused fr",`props_json`:"{\"name\": \"包含部件\", \"graph_version\": \"4.1\", \"is_causal\": false}"}},{`id`:"edge:239b91fb3d0a2af0",`source`:"shipkg:equipment:47a6f6945bb5",`target`:"shipkg:component:282dcd34a768",`properties`:{`name`:"包含部件",`graph_version`:"4.1",`is_causal`:false,`id`:"edge:239b91fb3d0a2af0",`case_id`:"sd2016_05_cpp_backup",`certainty`:"reported",`certainty_zh`:"报告明确记载",`evidence_id`:"ev:a33dab8e3476ce99",`source_file`:"MAIB_2016_Safety_Digest_generator_oil_fire.pdf",`source_url`:"https://assets.publishing.service.gov.uk/media/5e81e5d2d3bf7f13416961fa/2016-SD1-MAIBSafetyDigest.pdf",`page`:"20",`locator`:"PDF page 20",`quote`:"tarboard CPP back-up control mode was inadvertently selected, the master lost bridge control of that propeller. The starboard CPP continued to thrust at over half ahead throughout the vessel’s approach to the berth and up until its engine was stopped (about 2 hours after the contact). Starboard pitch back-up on/off control button Centre console lamps dimmer control buttons Figure 1: Part of brid",`props_json`:"{\"name\": \"包含部件\", \"graph_version\": \"4.1\", \"is_causal\": false}"}},{`id`:"edge:2c39c4f8861cba04",`source`:"shipkg:equipment:024350fd8dee",`target`:"shipkg:component:29dfcfe886de",`properties`:{`name`:"包含部件",`graph_version`:"4.1",`is_causal`:false,`id`:"edge:2c39c4f8861cba04",`case_id`:"queen_mary2_hf_2010",`certainty`:"reported",`certainty_zh`:"报告明确记载",`evidence_id`:"ev:800bdca6cdc9fb5d",`source_file`:"MAIB_2011_28_Queen_Mary_2_harmonic_filter_failure.pdf",`source_url`:"https://assets.digital.cabinet-office.gov.uk/media/547c6fa6ed915d4c10000031/QM2Report.pdf",`page`:"64",`locator`:"PDF page 64",`quote`:"e arly w arning t o p revent mo re s erious problems. 2.4.5 Current imbalance detection system The capacitor exploded because the inoperative imbalance detection system could not identify the deterioration of the capacitors. The failure of the imbalance system’s current transformer remained undetected for what could have been several years. It is certain that this system was not working in 2008",`props_json`:"{\"name\": \"包含部件\", \"graph_version\": \"4.1\", \"is_causal\": false}"}},{`id`:"edge:32afef38cef454c4",`source`:"shipkg:equipment:0d7957f0c12c",`target`:"shipkg:component:26867a3d02f0",`properties`:{`name`:"包含部件",`graph_version`:"4.1",`is_causal`:false,`id`:"edge:32afef38cef454c4",`case_id`:"sd2013_12_oily_rag",`certainty`:"reported",`certainty_zh`:"报告明确记载",`evidence_id`:"ev:188654e8f7b787d6",`source_file`:"MAIB_2013_Safety_Digest_lubrication_bearing_cases.pdf",`source_url`:"https://assets.publishing.service.gov.uk/government/uploads/system/uploads/attachment_data/file/876748/2013-SD2-MAIBSafetyDigest.pdf",`page`:"41",`locator`:"PDF page 41",`quote`:"ked rag to fall onto the hot manifold and catch fire. The small fire then ignited the engine high temperature alarm cabling loom, causing it to short circuit and set off the alarm in the wheelhouse (Figure 2). The functional fire and smoke alarm sensors were some distance from the fire, and the smoke and heat had not migrated that far by the time the master noticed the smoke on the ca",`props_json`:"{\"name\": \"包含部件\", \"graph_version\": \"4.1\", \"is_causal\": false}"}},{`id`:"edge:42516587b10b039a",`source`:"shipkg:equipment:563809ad0932",`target`:"shipkg:component:3552bc595328",`properties`:{`name`:"包含部件",`graph_version`:"4.1",`is_causal`:false,`id`:"edge:42516587b10b039a",`case_id`:"windcat8_port_engine_2017",`certainty`:"reported",`certainty_zh`:"报告明确记载",`evidence_id`:"ev:ff3253f5416e42be",`source_file`:"MAIB_2018_01_Windcat8_bearing_failure_fire.pdf",`source_url`:"https://assets.publishing.service.gov.uk/government/uploads/system/uploads/attachment_data/file/683922/MAIBInvReport01_2018.pdf",`page`:"1",`locator`:"PDF page 1",`quote`:"es. The MAIB investigation identified that the catastrophic damage to Windcat 8’s port main engine was caused by the failure of a piston connecting rod big end shell bearing, which resulted in the connecting rod assembly releasing and penetrating through the engine crankcase. The investigation also identified that: • A high oil temperature alarm prior to the engine failure warranted a more cautious a",`props_json`:"{\"name\": \"包含部件\", \"graph_version\": \"4.1\", \"is_causal\": false}"}},{`id`:"edge:57dbe6924d21326b",`source`:"shipkg:equipment:aea23b9943a4",`target`:"shipkg:component:c3d265fa990c",`properties`:{`name`:"包含部件",`graph_version`:"4.1",`is_causal`:false,`id`:"edge:57dbe6924d21326b",`case_id`:"finlandia_seaways_me_2018",`certainty`:"reported",`certainty_zh`:"报告明确记载",`evidence_id`:"ev:5e9210d8dbe9bf48",`source_file`:"MAIB_2021_02_Finlandia_Seaways_connecting_rod_failure.pdf",`source_url`:"https://www.gov.uk/maib-reports/engine-failure-and-subsequent-fire-on-ro-ro-cargo-vessel-finlandia-seaways-with-1-person-injured",`page`:"9",`locator`:"PDF page 9",`quote`:"Investigation Division and the engine manufacturer, MAN Diesel and Turbo SE. The investigation identified that a fracture of the connecting rod small end had led to the sudden failure of the main engine. The investigation also found that the method used to replace the connecting rod small end piston pin bearing bushes by the vessel manager’s maintenance support contractor had intr",`props_json`:"{\"name\": \"包含部件\", \"graph_version\": \"4.1\", \"is_causal\": false}"}},{`id`:"edge:5e45b9e5f988ba48",`source`:"shipkg:equipment:00688defba1b",`target`:"shipkg:component:864e3371e086",`properties`:{`name`:"包含部件",`graph_version`:"4.1",`is_causal`:false,`id`:"edge:5e45b9e5f988ba48",`case_id`:"sd2016_08_generator_oil",`certainty`:"reported",`certainty_zh`:"报告明确记载",`evidence_id`:"ev:e9d71048b791d31a",`source_file`:"MAIB_2016_Safety_Digest_generator_oil_fire.pdf",`source_url`:"https://assets.publishing.service.gov.uk/media/5e81e5d2d3bf7f13416961fa/2016-SD1-MAIBSafetyDigest.pdf",`page`:"26",`locator`:"PDF page 26",`quote`:"as a result of it being insufficiently tightened by shore staff during a recent dry dock. • A section of the adjacent generator’s exhaust piping had been left unlagged following its overhaul during the recent dry dock (Figure 2b). This was hidden from view by the exhaust casing. • Fine oil spray ignited when it came into contact with the hot exhaust casing. Figure 1: Location of the generator w",`props_json`:"{\"name\": \"包含部件\", \"graph_version\": \"4.1\", \"is_causal\": false}"}},{`id`:"edge:6d7bd55a38b00562",`source`:"shipkg:equipment:710361995928",`target`:"shipkg:component:1157de5d43da",`properties`:{`name`:"包含部件",`graph_version`:"4.1",`is_causal`:false,`id`:"edge:6d7bd55a38b00562",`case_id`:"spirit_of_discovery_pods_2023",`certainty`:"reported",`certainty_zh`:"报告明确记载",`evidence_id`:"ev:e2523ed63e0b4019",`source_file`:"MAIB_2026_06_Spirit_of_Discovery_propulsion_loss.pdf",`source_url`:"https://www.gov.uk/maib-reports/loss-of-propulsion-in-heavy-weather-experienced-by-the-passenger-vessel-spirit-of-discovery-leading-to-over-100-injuries-and-one-fatality",`page`:"42",`locator`:"PDF page 42",`quote`:"at Spirit of Discovery’s pitching caused the propellers to come out of the water. This caused a sudden reduction in torque on the propulsion motor and led to a very rapid increase in the motors’ rpm. The engine alarm and monitoring system recorded that, immediately before their shutdown, the rpm of each pod’s propulsion motor very rapidly increased and exceeded the preset o",`props_json`:"{\"name\": \"包含部件\", \"graph_version\": \"4.1\", \"is_causal\": false}"}},{`id`:"edge:79d4c4c8f1593b12",`source`:"shipkg:equipment:61cd855f5970",`target`:"shipkg:component:be4ab56339d8",`properties`:{`name`:"包含部件",`graph_version`:"4.1",`is_causal`:false,`id`:"edge:79d4c4c8f1593b12",`case_id`:"wight_sky_me2_2018",`certainty`:"reported",`certainty_zh`:"报告明确记载",`evidence_id`:"ev:0b7a42308cc8b6cc",`source_file`:"MAIB_2022_04_Wight_Sky_multiple_engine_failures.pdf",`source_url`:"https://assets.publishing.service.gov.uk/media/6267cc85e90e071690c1b679/2022-4-WightSky-Report.pdf",`page`:"84",`locator`:"PDF page 84",`quote`:"D OR RESULTED IN RECOMMENDATIONS 1. Wight Sky’s ME2 failed catastrophically due to a sudden loss of lubricating oil supply to its number five main journal bearing and number four crankpin. [2.3.1] 2. The oilway to the main journal and crankpin was blocked off when the bearing shells turned in their housing. Poor fuel combustion, the presence of silica sand and other abrasive particles embe",`props_json`:"{\"name\": \"包含部件\", \"graph_version\": \"4.1\", \"is_causal\": false}"}},{`id`:"edge:8e8627bd569385ae",`source`:"shipkg:equipment:361590fc68c0",`target`:"shipkg:component:5fbf5f22d00c",`properties`:{`name`:"包含部件",`graph_version`:"4.1",`is_causal`:false,`id`:"edge:8e8627bd569385ae",`case_id`:"sd2016_14_sea_valve",`certainty`:"reported",`certainty_zh`:"报告明确记载",`evidence_id`:"ev:2180f44fb45d636d",`source_file`:"MAIB_2016_Safety_Digest_generator_oil_fire.pdf",`source_url`:"https://assets.publishing.service.gov.uk/media/5e81e5d2d3bf7f13416961fa/2016-SD1-MAIBSafetyDigest.pdf",`page`:"41",`locator`:"PDF page 41",`quote`:"ssel. Are you prepared for a flooding emergency? 3. Examination of the isolating valve following the accident identified that the valve actuator had been defective, giving an impression that the valve was fully closed when it was not. Although there was a visual indicator located on the side of the actuator, this was not checked to confirm that the valve was closed prior to removal of the f",`props_json`:"{\"name\": \"包含部件\", \"graph_version\": \"4.1\", \"is_causal\": false}"}},{`id`:"edge:8f2f42d9f1eeb319",`source`:"shipkg:equipment:385291025daa",`target`:"shipkg:component:e0a03cf176fe",`properties`:{`name`:"包含部件",`graph_version`:"4.1",`is_causal`:false,`id`:"edge:8f2f42d9f1eeb319",`case_id`:"stena_europe_fuel_2023",`certainty`:"reported",`certainty_zh`:"报告明确记载",`evidence_id`:"ev:861eb8fbe47cd585",`source_file`:"MAIB_2024_20_Stena_Europe_fuel_spray_fire.pdf",`source_url`:"https://assets.publishing.service.gov.uk/media/6756db0ba63e1781efb87793/2024-20-StenaEurope.pdf",`page`:"29",`locator`:"PDF page 29",`quote`:"f pressurised fuel. The fuel sprayed onto the exposed exhaust manifold that was operating at a temperature exceeding 220°C when a screw in a two-screw flange within the fuel oil pipework loosened. [2.2] 2. The fuel oil spray was allowed to reach the hot surface because the joint was not protected by anti-splashing tape or shielding and fuel was able to escape forcefully. [2.3.2] 3. Th",`props_json`:"{\"name\": \"包含部件\", \"graph_version\": \"4.1\", \"is_causal\": false}"}},{`id`:"edge:944a5d342f7be0c3",`source`:"shipkg:equipment:3e7f89ac810b",`target`:"shipkg:component:a53bfe23945e",`properties`:{`name`:"包含部件",`graph_version`:"4.1",`is_causal`:false,`id`:"edge:944a5d342f7be0c3",`case_id`:"sd2016_22_cooling_pipe",`certainty`:"reported",`certainty_zh`:"报告明确记载",`evidence_id`:"ev:e235f3eb9480640d",`source_file`:"MAIB_2016_Safety_Digest_generator_oil_fire.pdf",`source_url`:"https://assets.publishing.service.gov.uk/media/5e81e5d2d3bf7f13416961fa/2016-SD1-MAIBSafetyDigest.pdf",`page`:"60",`locator`:"PDF page 60",`quote`:"al. Never delay unnecessarily when abandoning a sinking ship. 4. The rate of water ingress and the speed at which the vessel sank suggests the failure of a main engine sea water cooling pipe. Analysis of maintenance records showed that this pipework had not been inspected or renewed for many years. Sea inlet pipework should be thoroughly checked during planned maintenance periods. skipper, who had remained in the whe",`props_json`:"{\"name\": \"包含部件\", \"graph_version\": \"4.1\", \"is_causal\": false}"}},{`id`:"edge:98cd72c2410ad408",`source`:"shipkg:equipment:38482b664e19",`target`:"shipkg:component:46d84bd3b794",`properties`:{`name`:"包含部件",`graph_version`:"4.1",`is_causal`:false,`id`:"edge:98cd72c2410ad408",`case_id`:"sd2013_03_turning_gear",`certainty`:"reported",`certainty_zh`:"报告明确记载",`evidence_id`:"ev:f4e14e047a77ffb2",`source_file`:"MAIB_2013_Safety_Digest_lubrication_bearing_cases.pdf",`source_url`:"https://assets.publishing.service.gov.uk/government/uploads/system/uploads/attachment_data/file/876748/2013-SD2-MAIBSafetyDigest.pdf",`page`:"16",`locator`:"PDF page 16",`quote`:"n by the engineer. When the main engine start button was pressed to turn the engine on compressed air, a loud bang was heard; the turning gear interlock, the last remaining safety barrier, had failed to work. The resulting damage to the shaft and gearing (Figure 1) and to the turning gear casing (Figure 2) disabled the ship for a month and cost a six-figure sum to repair. To Turn",`props_json`:"{\"name\": \"包含部件\", \"graph_version\": \"4.1\", \"is_causal\": false}"}},{`id`:"edge:9cdde6134fd4b5b8",`source`:"shipkg:equipment:0d7957f0c12c",`target`:"shipkg:component:828d4178b93f",`properties`:{`name`:"包含部件",`graph_version`:"4.1",`is_causal`:false,`id`:"edge:9cdde6134fd4b5b8",`case_id`:"sd2013_12_oily_rag",`certainty`:"reported",`certainty_zh`:"报告明确记载",`evidence_id`:"ev:1abb50030379f9ee",`source_file`:"MAIB_2013_Safety_Digest_lubrication_bearing_cases.pdf",`source_url`:"https://assets.publishing.service.gov.uk/government/uploads/system/uploads/attachment_data/file/876748/2013-SD2-MAIBSafetyDigest.pdf",`page`:"41",`locator`:"PDF page 41",`quote`:"rag, which he casually left on a tank top above the engine exhaust manifold. Vibration caused the oil-soaked rag to fall onto the hot manifold and catch fire. The small fire then ignited the engine high temperature alarm cabling loom, causing it to short circuit and set off the alarm in the wheelhouse (Figure 2). The functional fire and smoke alarm sensors were some distance from the",`props_json`:"{\"name\": \"包含部件\", \"graph_version\": \"4.1\", \"is_causal\": false}"}},{`id`:"edge:a44b0cd483df5674",`source`:"shipkg:equipment:38482b664e19",`target`:"shipkg:component:6432d2482f06",`properties`:{`name`:"包含部件",`graph_version`:"4.1",`is_causal`:false,`id`:"edge:a44b0cd483df5674",`case_id`:"sd2013_03_turning_gear",`certainty`:"reported",`certainty_zh`:"报告明确记载",`evidence_id`:"ev:157ede421b19ee3a",`source_file`:"MAIB_2013_Safety_Digest_lubrication_bearing_cases.pdf",`source_url`:"https://assets.publishing.service.gov.uk/government/uploads/system/uploads/attachment_data/file/876748/2013-SD2-MAIBSafetyDigest.pdf",`page`:"16",`locator`:"PDF page 16",`quote`:"neer. When the main engine start button was pressed to turn the engine on compressed air, a loud bang was heard; the turning gear interlock, the last remaining safety barrier, had failed to work. The resulting damage to the shaft and gearing (Figure 1) and to the turning gear casing (Figure 2) disabled the ship for a month and cost a six-figure sum to repair. To Turn or Not to Turn?",`props_json`:"{\"name\": \"包含部件\", \"graph_version\": \"4.1\", \"is_causal\": false}"}},{`id`:"edge:ae255bc80cc879b8",`source`:"shipkg:equipment:49d861a78ba3",`target`:"shipkg:component:8052e7754d5f",`properties`:{`name`:"包含部件",`graph_version`:"4.1",`is_causal`:false,`id`:"edge:ae255bc80cc879b8",`case_id`:"kommandor_susan_dg1_2025",`certainty`:"reported",`certainty_zh`:"报告明确记载",`evidence_id`:"ev:e32631e4946436ab",`source_file`:"MAIB_2026_10_Kommandor_Susan_generator_bearing_failure.pdf",`source_url`:"https://www.gov.uk/maib-reports/catastrophic-engine-failure-and-subsequent-fire-on-board-the-site-investigation-vessel-kommandor-susan",`page`:"5",`locator`:"PDF page 5",`quote`:"rod cap number six comes off. Pon Power’s report concluded that: With the facts gathered the most likely root cause is failure of connecting rod bearing number five. The excessive wear on the other connecting rod bearings show that the most likely root cause for the bearing failure is weak bonding of the copper layer. Evidence of weak material bonding was found in several bearings (Figure 4)",`props_json`:"{\"name\": \"包含部件\", \"graph_version\": \"4.1\", \"is_causal\": false}"}},{`id`:"edge:af8e88a950719648",`source`:"shipkg:equipment:385291025daa",`target`:"shipkg:component:a85d6cb18c5c",`properties`:{`name`:"包含部件",`graph_version`:"4.1",`is_causal`:false,`id`:"edge:af8e88a950719648",`case_id`:"stena_europe_fuel_2023",`certainty`:"reported",`certainty_zh`:"报告明确记载",`evidence_id`:"ev:2d2994aad520a17a",`source_file`:"MAIB_2024_20_Stena_Europe_fuel_spray_fire.pdf",`source_url`:"https://assets.publishing.service.gov.uk/media/6756db0ba63e1781efb87793/2024-20-StenaEurope.pdf",`page`:"29",`locator`:"PDF page 29",`quote`:"MMENDATIONS 1. Stena Europe experienced a fire on one of its main engines due to an uncontrolled release of pressurised fuel. The fuel sprayed onto the exposed exhaust manifold that was operating at a temperature exceeding 220°C when a screw in a two-screw flange within the fuel oil pipework loosened. [2.2] 2. The fuel oil spray was allowed to reach the hot surface because the joint was not protected by",`props_json`:"{\"name\": \"包含部件\", \"graph_version\": \"4.1\", \"is_causal\": false}"}},{`id`:"edge:afacc8bce12b4830",`source`:"shipkg:equipment:5ed28aa334b7",`target`:"shipkg:component:784cd78efb12",`properties`:{`name`:"包含部件",`graph_version`:"4.1",`is_causal`:false,`id`:"edge:afacc8bce12b4830",`case_id`:"sd2013_05_missing_filter",`certainty`:"reported",`certainty_zh`:"报告明确记载",`evidence_id`:"ev:b10e854dd960072c",`source_file`:"MAIB_2013_Safety_Digest_lubrication_bearing_cases.pdf",`source_url`:"https://assets.publishing.service.gov.uk/government/uploads/system/uploads/attachment_data/file/876748/2013-SD2-MAIBSafetyDigest.pdf",`page`:"21",`locator`:"PDF page 21",`quote`:"ate without any problems and the vessel undertook several voyages. However, after the engine failure, the duplex filter was found without a filter cartridge in the on-line filter chamber, and the engine lubricating oil system was contaminated. The contamination caused main bearing seizure, the rotation of bearing shells and the blockage of oil ways, and subsequent oil starvation and",`props_json`:"{\"name\": \"包含部件\", \"graph_version\": \"4.1\", \"is_causal\": false}"}},{`id`:"edge:b496cf568525091a",`source`:"shipkg:equipment:361590fc68c0",`target`:"shipkg:component:28a67e535633",`properties`:{`name`:"包含部件",`graph_version`:"4.1",`is_causal`:false,`id`:"edge:b496cf568525091a",`case_id`:"sd2016_14_sea_valve",`certainty`:"reported",`certainty_zh`:"报告明确记载",`evidence_id`:"ev:a815947a42cdaece",`source_file`:"MAIB_2016_Safety_Digest_generator_oil_fire.pdf",`source_url`:"https://assets.publishing.service.gov.uk/media/5e81e5d2d3bf7f13416961fa/2016-SD1-MAIBSafetyDigest.pdf",`page`:"40",`locator`:"PDF page 40",`quote`:"seaman rigged the portable electric water pump on the main deck but, with the vessel now running on emergency power only, he was unable to start the pump. The master contacted the coastguard by VHF radio and advised that the vessel was flooding. The coastguard transmitted a “Mayday Relay”, and RNLI lifeboats from two stations were tasked to assist along with a Royal Navy helicopte",`props_json`:"{\"name\": \"包含部件\", \"graph_version\": \"4.1\", \"is_causal\": false}"}},{`id`:"edge:d5ac1d25a3ce6fca",`source`:"shipkg:equipment:23fe6c4f1acc",`target`:"shipkg:component:ed0a2ad1e065",`properties`:{`name`:"包含部件",`graph_version`:"4.1",`is_causal`:false,`id`:"edge:d5ac1d25a3ce6fca",`case_id`:"pride_can_cpp_2014",`certainty`:"reported",`certainty_zh`:"报告明确记载",`evidence_id`:"ev:504217846ee2ac5f",`source_file`:"MAIB_2015_22_Pride_of_Canterbury_CPP_hydraulic_fire.pdf",`source_url`:"https://assets.digital.cabinet-office.gov.uk/media/563092daed915d566d000002/MAIBInvReport-22_2015.pdf",`page`:"29",`locator`:"PDF page 29",`quote`:"oil, from a ruptured pipework joint in the starboard CPP system, onto the hot exhaust uptakes of the starboard main engines. The flanged joint ruptured because the CPP system became over- pressurised as a result of the back pressure valve (PSV3) becoming jammed in the closed position. The reason for the temporary increase in the starboard main engine load to 100% and correspondi",`props_json`:"{\"name\": \"包含部件\", \"graph_version\": \"4.1\", \"is_causal\": false}"}},{`id`:"edge:d7de15cbb93c98a6",`source`:"shipkg:equipment:8c8343c45190",`target`:"shipkg:component:3295e52dd075",`properties`:{`name`:"包含部件",`graph_version`:"4.1",`is_causal`:false,`id`:"edge:d7de15cbb93c98a6",`case_id`:"sd2016_09_cpp_response",`certainty`:"reported",`certainty_zh`:"报告明确记载",`evidence_id`:"ev:dc67d8904baddd49",`source_file`:"MAIB_2016_Safety_Digest_generator_oil_fire.pdf",`source_url`:"https://assets.publishing.service.gov.uk/media/5e81e5d2d3bf7f13416961fa/2016-SD1-MAIBSafetyDigest.pdf",`page`:"29",`locator`:"PDF page 29",`quote`:"led, but fortunately the damage was above the waterline (Figure 1). The subsequent investigation identified that the vessel had a history of sluggish astern response. However, the crew had accepted this as a ‘characteristic’ of the vessel and usually compensated for it by demanding astern movements well in advance. The CPP control panel on the bridge had a back-up control button (Figure 2) fo",`props_json`:"{\"name\": \"包含部件\", \"graph_version\": \"4.1\", \"is_causal\": false}"}},{`id`:"edge:da1fe1b0531fa071",`source`:"shipkg:equipment:00688defba1b",`target`:"shipkg:component:4d8f23e8a303",`properties`:{`name`:"包含部件",`graph_version`:"4.1",`is_causal`:false,`id`:"edge:da1fe1b0531fa071",`case_id`:"sd2016_08_generator_oil",`certainty`:"reported",`certainty_zh`:"报告明确记载",`evidence_id`:"ev:3749ce726e3d4dcc",`source_file`:"MAIB_2016_Safety_Digest_generator_oil_fire.pdf",`source_url`:"https://assets.publishing.service.gov.uk/media/5e81e5d2d3bf7f13416961fa/2016-SD1-MAIBSafetyDigest.pdf",`page`:"26",`locator`:"PDF page 26",`quote`:"before it was able to spread. No one was hurt in the incident. Subsequent investigation revealed that: • The oil had come from a loose plug on the generator’s engine-mounted lubricating oil pump (Figure 2a). This had vibrated loose as a result of it being insufficiently tightened by shore staff during a recent dry dock. • A section of the adjacent generator’s exhaust piping had been left unlagged following its overhaul d",`props_json`:"{\"name\": \"包含部件\", \"graph_version\": \"4.1\", \"is_causal\": false}"}},{`id`:"edge:e1656ea7817f2772",`source`:"shipkg:equipment:23fe6c4f1acc",`target`:"shipkg:component:fd37cf4aeb64",`properties`:{`name`:"包含部件",`graph_version`:"4.1",`is_causal`:false,`id`:"edge:e1656ea7817f2772",`case_id`:"pride_can_cpp_2014",`certainty`:"reported",`certainty_zh`:"报告明确记载",`evidence_id`:"ev:cd6c3c8ec42fee37",`source_file`:"MAIB_2015_22_Pride_of_Canterbury_CPP_hydraulic_fire.pdf",`source_url`:"https://assets.digital.cabinet-office.gov.uk/media/563092daed915d566d000002/MAIBInvReport-22_2015.pdf",`page`:"27",`locator`:"PDF page 27",`quote`:"ended to release at 6-8 bar, released at much greater pressures, ranging from 20 to 77 bar. When dismantled it was found that the piston was worn, allowing it to tilt and stick sporadically. The valve supplier considered the amount of wear was normal given its 23 years of service. The pressure safety valve (PSV1) was also dismantled and found to be worn, but to a much lesser extent. 1.12 SIMILAR ACCIDEN",`props_json`:"{\"name\": \"包含部件\", \"graph_version\": \"4.1\", \"is_causal\": false}"}},{`id`:"edge:e3e5a53f0f25b5db",`source`:"shipkg:equipment:1755b4f618f2",`target`:"shipkg:component:45c063af0c7c",`properties`:{`name`:"包含部件",`graph_version`:"4.1",`is_causal`:false,`id`:"edge:e3e5a53f0f25b5db",`case_id`:"wight_sky_me_2017",`certainty`:"reported",`certainty_zh`:"报告明确记载",`evidence_id`:"ev:1637d85df75c53f0",`source_file`:"MAIB_2018_14_Wight_Sky_engine_bearing_fire.pdf",`source_url`:"https://assets.publishing.service.gov.uk/media/5b5217c7ed915d0b81e003df/MAIBInvReport14_2018.pdf",`page`:"14",`locator`:"PDF page 14",`quote`:"cluded that: ○ Debris in the engine’s oil channels was most probably responsible for initiating the failure. ○ When the shells of main bearing 5 turned, the lubrication supply to big end bearing 4 was blocked, resulting in destructive failure. • Rebuilding the engine in a clean and controlled environment and transferring it complete into the engine room would have reduced",`props_json`:"{\"name\": \"包含部件\", \"graph_version\": \"4.1\", \"is_causal\": false}"}},{`id`:"edge:e55aa08dc1ef25d1",`source`:"shipkg:equipment:710361995928",`target`:"shipkg:component:160bdfff5e4e",`properties`:{`name`:"包含部件",`graph_version`:"4.1",`is_causal`:false,`id`:"edge:e55aa08dc1ef25d1",`case_id`:"spirit_of_discovery_pods_2023",`certainty`:"reported",`certainty_zh`:"报告明确记载",`evidence_id`:"ev:818a140783772a9b",`source_file`:"MAIB_2026_06_Spirit_of_Discovery_propulsion_loss.pdf",`source_url`:"https://www.gov.uk/maib-reports/loss-of-propulsion-in-heavy-weather-experienced-by-the-passenger-vessel-spirit-of-discovery-leading-to-over-100-injuries-and-one-fatality",`page`:"43",`locator`:"PDF page 43",`quote`:"iple this was an entirely sensible precaution to protect the high voltage pod motor from damage. However, the low position of the bilge sensor meant that it could be activated by a relatively small amount of liquid that accumulated within the pod. Since the bilge suction probably did not extend low enough for the automatic bilge pumps to effectively pump the water out,",`props_json`:"{\"name\": \"包含部件\", \"graph_version\": \"4.1\", \"is_causal\": false}"}},{`id`:"edge:e89be960108f76f9",`source`:"shipkg:equipment:024350fd8dee",`target`:"shipkg:component:726d763bfec1",`properties`:{`name`:"包含部件",`graph_version`:"4.1",`is_causal`:false,`id`:"edge:e89be960108f76f9",`case_id`:"queen_mary2_hf_2010",`certainty`:"reported",`certainty_zh`:"报告明确记载",`evidence_id`:"ev:e1952d272da22996",`source_file`:"MAIB_2011_28_Queen_Mary_2_harmonic_filter_failure.pdf",`source_url`:"https://assets.digital.cabinet-office.gov.uk/media/547c6fa6ed915d4c10000031/QM2Report.pdf",`page`:"13",`locator`:"PDF page 13",`quote`:"ere activated, one in the aft harmonic filter room and the other in the aft main switchboard room. The explosion was triggered by deterioration in the capacitors in the aft HF . Internal arcing between the capacitor plates developed, which vaporised the dielectric medium causing the internal pressure to increase, until it caused the capacitor casing to rupture. Dielectric fluid vapour spr",`props_json`:"{\"name\": \"包含部件\", \"graph_version\": \"4.1\", \"is_causal\": false}"}},{`id`:"edge:eaa4e12083f52246",`source`:"shipkg:equipment:23fe6c4f1acc",`target`:"shipkg:component:d16e663b1271",`properties`:{`name`:"包含部件",`graph_version`:"4.1",`is_causal`:false,`id`:"edge:eaa4e12083f52246",`case_id`:"pride_can_cpp_2014",`certainty`:"reported",`certainty_zh`:"报告明确记载",`evidence_id`:"ev:470e8782d7a79377",`source_file`:"MAIB_2015_22_Pride_of_Canterbury_CPP_hydraulic_fire.pdf",`source_url`:"https://assets.digital.cabinet-office.gov.uk/media/563092daed915d566d000002/MAIBInvReport-22_2015.pdf",`page`:"29",`locator`:"PDF page 29",`quote`:"t in the starboard CPP system, onto the hot exhaust uptakes of the starboard main engines. The flanged joint ruptured because the CPP system became over- pressurised as a result of the back pressure valve (PSV3) becoming jammed in the closed position. The reason for the temporary increase in the starboard main engine load to 100% and corresponding increase in turbocharger rpm has not been det",`props_json`:"{\"name\": \"包含部件\", \"graph_version\": \"4.1\", \"is_causal\": false}"}},{`id`:"edge:ec264eeb7766cd8b",`source`:"shipkg:equipment:5d25f4bda048",`target`:"shipkg:component:960fe73dbb4b",`properties`:{`name`:"包含部件",`graph_version`:"4.1",`is_causal`:false,`id`:"edge:ec264eeb7766cd8b",`case_id`:"sd2013_02_control_air",`certainty`:"reported",`certainty_zh`:"报告明确记载",`evidence_id`:"ev:8e948de9b710ce4f",`source_file`:"MAIB_2013_Safety_Digest_lubrication_bearing_cases.pdf",`source_url`:"https://assets.publishing.service.gov.uk/government/uploads/system/uploads/attachment_data/file/876748/2013-SD2-MAIBSafetyDigest.pdf",`page`:"14",`locator`:"PDF page 14",`quote`:"ond compressor (No2) and reported his actions to the senior engineer in the ECR. Immediate investigation identified that the main lubricating oil discharge pipe assembly in No1 compressor had detached, and that the bottom end bearing had overheated and failed (see figure). No1 compressor was isolated but the engineers soon noticed that the air pressure in the main air receiver was dropping. Short",`props_json`:"{\"name\": \"包含部件\", \"graph_version\": \"4.1\", \"is_causal\": false}"}},{`id`:"edge:ed4a27464a4be699",`source`:"shipkg:equipment:5ed28aa334b7",`target`:"shipkg:component:1333df9ac9f2",`properties`:{`name`:"包含部件",`graph_version`:"4.1",`is_causal`:false,`id`:"edge:ed4a27464a4be699",`case_id`:"sd2013_05_missing_filter",`certainty`:"reported",`certainty_zh`:"报告明确记载",`evidence_id`:"ev:82256a9ee8fd56dd",`source_file`:"MAIB_2013_Safety_Digest_lubrication_bearing_cases.pdf",`source_url`:"https://assets.publishing.service.gov.uk/government/uploads/system/uploads/attachment_data/file/876748/2013-SD2-MAIBSafetyDigest.pdf",`page`:"21",`locator`:"PDF page 21",`quote`:"d main bearing journals; overheating of the bedplate at the main bearing housings; overheating of the piston connecting rods; the seizure of several pistons (Figure 2); failure of the camshaft and turbo charger bearings, and metallic debris throughout the lubricating oil system. The damage sustained necessitated an engine rebuild and the replacement of the bedplate and crankshaft. A",`props_json`:"{\"name\": \"包含部件\", \"graph_version\": \"4.1\", \"is_causal\": false}"}},{`id`:"edge:f6d4787cdc819a2b",`source`:"shipkg:equipment:5ed28aa334b7",`target`:"shipkg:component:67b7bcd7344e",`properties`:{`name`:"包含部件",`graph_version`:"4.1",`is_causal`:false,`id`:"edge:f6d4787cdc819a2b",`case_id`:"sd2013_05_missing_filter",`certainty`:"reported",`certainty_zh`:"报告明确记载",`evidence_id`:"ev:df67722cb172233f",`source_file`:"MAIB_2013_Safety_Digest_lubrication_bearing_cases.pdf",`source_url`:"https://assets.publishing.service.gov.uk/government/uploads/system/uploads/attachment_data/file/876748/2013-SD2-MAIBSafetyDigest.pdf",`page`:"21",`locator`:"PDF page 21",`quote`:"filter cartridge in the on-line filter chamber, and the engine lubricating oil system was contaminated. The contamination caused main bearing seizure, the rotation of bearing shells and the blockage of oil ways, and subsequent oil starvation and overheating to other bearings and to the pistons. The engine daily logs referred to oil filter cartridge changes only prior to the re",`props_json`:"{\"name\": \"包含部件\", \"graph_version\": \"4.1\", \"is_causal\": false}"}},{`id`:"edge:fc333e45409b3219",`source`:"shipkg:equipment:5d25f4bda048",`target`:"shipkg:component:6f0aead2b5a6",`properties`:{`name`:"包含部件",`graph_version`:"4.1",`is_causal`:false,`id`:"edge:fc333e45409b3219",`case_id`:"sd2013_02_control_air",`certainty`:"reported",`certainty_zh`:"报告明确记载",`evidence_id`:"ev:4f930aa49cf38734",`source_file`:"MAIB_2013_Safety_Digest_lubrication_bearing_cases.pdf",`source_url`:"https://assets.publishing.service.gov.uk/government/uploads/system/uploads/attachment_data/file/876748/2013-SD2-MAIBSafetyDigest.pdf",`page`:"14",`locator`:"PDF page 14",`quote`:"ch went according to plan until the ferry was about 1½ ships’ length from its final berthing position, when her three main engine clutches disengaged almost simultaneously. No Air, No Clutch, No CPP , No Brakes Damage to lubrication oil pipe and bottom end bearing Bottom end bearing Failed lubricant oil pipe end fitting",`props_json`:"{\"name\": \"包含部件\", \"graph_version\": \"4.1\", \"is_causal\": false}"}}] AS row MATCH (a:ShipKG {id:row.source}), (b:ShipKG {id:row.target}) MERGE (a)-[r:HAS_COMPONENT {id:row.id}]->(b) SET r += row.properties RETURN count(r) AS processed_36 }
CALL () { UNWIND [{`id`:"edge:097cdade9d0e4641",`source`:"shipkg:symptom:ccae4eb65c57",`target`:"shipkg:fault:fee4df6aeb24",`properties`:{`name`:"先于发生",`graph_version`:"4.1",`is_causal`:false,`id`:"edge:097cdade9d0e4641",`case_id`:"wight_sky_me2_2018",`certainty`:"reported",`certainty_zh`:"报告明确记载",`evidence_id`:"ev:5124f3b43ff47b3a",`source_file`:"MAIB_2022_04_Wight_Sky_multiple_engine_failures.pdf",`source_url`:"https://assets.publishing.service.gov.uk/media/6267cc85e90e071690c1b679/2022-4-WightSky-Report.pdf",`page`:"70",`locator`:"PDF page 70",`quote`:"ymington River. The engine was running at full speed (1800rpm) and was driving the forward VSP unit in parallel with ME1 when its ECU detected a loss of lubricating oil pressure and initiated an engine shutdown. 63 seconds later, the engine’s number four connecting rod and piston assembly was thrown out of the crankcase into the engine room. The engine had accumulated 2241 running hours and had been installed 11 months earlier as a new",`props_json`:"{\"name\": \"先于发生\", \"graph_version\": \"4.1\", \"is_causal\": false}"}},{`id`:"edge:60ec9e810f731a6f",`source`:"shipkg:consequence:fc1835efb5ca",`target`:"shipkg:fault:7d56f05dfb4b",`properties`:{`name`:"先于发生",`graph_version`:"4.1",`is_causal`:false,`id`:"edge:60ec9e810f731a6f",`case_id`:"queen_mary2_hf_2010",`certainty`:"reported",`certainty_zh`:"报告明确记载",`evidence_id`:"ev:f4ea99f2d07cb7c1",`source_file`:"MAIB_2011_28_Queen_Mary_2_harmonic_filter_failure.pdf",`source_url`:"https://assets.digital.cabinet-office.gov.uk/media/547c6fa6ed915d4c10000031/QM2Report.pdf",`page`:"13",`locator`:"PDF page 13",`quote`:"en Mary 2 (QM2) was approaching Barcelona, an explosion occurred in the vessel’s aft main switchboard room. Within a few seconds, all four propulsion motors shut down, and the vessel blacked out shortly afterwards. Fortunately, the vessel was clear of navigational hazards and drifted in open sea. The emergency generator started automatically and provided essential supplies to the vessel, and i",`props_json`:"{\"name\": \"先于发生\", \"graph_version\": \"4.1\", \"is_causal\": false}"}},{`id`:"edge:8d5dfceec483f2d0",`source`:"shipkg:symptom:ea2cdd59ea5c",`target`:"shipkg:fault:4865d7c855d8",`properties`:{`name`:"先于发生",`graph_version`:"4.1",`is_causal`:false,`id`:"edge:8d5dfceec483f2d0",`case_id`:"sd2013_05_missing_filter",`certainty`:"reported",`certainty_zh`:"报告明确记载",`evidence_id`:"ev:31361433815a45d9",`source_file`:"MAIB_2013_Safety_Digest_lubrication_bearing_cases.pdf",`source_url`:"https://assets.publishing.service.gov.uk/government/uploads/system/uploads/attachment_data/file/876748/2013-SD2-MAIBSafetyDigest.pdf",`page`:"21",`locator`:"PDF page 21",`quote`:"stigated but could not find any fault with the engine. He reset the alarm and continued with his duties. Several hours later, the OMD alarm activated again. The chief engineer was in the engine room and saw smoke vent from the main engine crankcase explosion relief doors. A lubricating oil low pressure alarm, and a lubricating oil low pressure trip alarm soon followed. The engine th",`props_json`:"{\"name\": \"先于发生\", \"graph_version\": \"4.1\", \"is_causal\": false}"}},{`id`:"edge:8e42e88551262b21",`source`:"shipkg:symptom:13f0f30403ca",`target`:"shipkg:fault:4cb7be531584",`properties`:{`name`:"先于发生",`graph_version`:"4.1",`is_causal`:false,`id`:"edge:8e42e88551262b21",`case_id`:"sd2013_02_control_air",`certainty`:"reported",`certainty_zh`:"报告明确记载",`evidence_id`:"ev:9fa6115be15d0d77",`source_file`:"MAIB_2013_Safety_Digest_lubrication_bearing_cases.pdf",`source_url`:"https://assets.publishing.service.gov.uk/government/uploads/system/uploads/attachment_data/file/876748/2013-SD2-MAIBSafetyDigest.pdf",`page`:"14",`locator`:"PDF page 14",`quote`:"ntre main engine was started and all three main engines were put on standby in preparation for entering port. During this period, multiple alarms sounded in the ECR warning of low control air pressure. In response, two engineers searched the engine room for a possible air leak. The senior engineer in the ECR telephoned the bridge and informed the OOW that there was a problem with the compressed air supply and that there was a",`props_json`:"{\"name\": \"先于发生\", \"graph_version\": \"4.1\", \"is_causal\": false}"}},{`id`:"edge:916e961e0139fa0d",`source`:"shipkg:symptom:d2a57b31e287",`target`:"shipkg:fault:2c644dcfc770",`properties`:{`name`:"先于发生",`graph_version`:"4.1",`is_causal`:false,`id`:"edge:916e961e0139fa0d",`case_id`:"windcat8_port_engine_2017",`certainty`:"reported",`certainty_zh`:"报告明确记载",`evidence_id`:"ev:caaf8005d66a8fbb",`source_file`:"MAIB_2018_01_Windcat8_bearing_failure_fire.pdf",`source_url`:"https://assets.publishing.service.gov.uk/government/uploads/system/uploads/attachment_data/file/683922/MAIBInvReport01_2018.pdf",`page`:"1",`locator`:"PDF page 1",`quote`:"in the connecting rod assembly releasing and penetrating through the engine crankcase. The investigation also identified that: • A high oil temperature alarm prior to the engine failure warranted a more cautious approach to the use of the engine until a deeper technical investigation could be conducted. • The fire resulted from the ignition of oil vapour released from the damaged crankcase and did not spread bey",`props_json`:"{\"name\": \"先于发生\", \"graph_version\": \"4.1\", \"is_causal\": false}"}},{`id`:"edge:fbc5db279b3cf9d4",`source`:"shipkg:consequence:81fff36694d8",`target`:"shipkg:fault:34646312c70d",`properties`:{`name`:"先于发生",`graph_version`:"4.1",`is_causal`:false,`id`:"edge:fbc5db279b3cf9d4",`case_id`:"sd2016_22_cooling_pipe",`certainty`:"reported",`certainty_zh`:"报告明确记载",`evidence_id`:"ev:f99011c1bd987967",`source_file`:"MAIB_2016_Safety_Digest_generator_oil_fire.pdf",`source_url`:"https://assets.publishing.service.gov.uk/media/5e81e5d2d3bf7f13416961fa/2016-SD1-MAIBSafetyDigest.pdf",`page`:"59",`locator`:"PDF page 59",`quote`:"e bilge pump but could not reach the two sea water inlet valves as they were already more than a metre below the water level. The main engine then stopped and the engineer told the skipper that nothing could be done to stem the ingress of water. The Figure 1: Sequence showing fishing vessel sinking",`props_json`:"{\"name\": \"先于发生\", \"graph_version\": \"4.1\", \"is_causal\": false}"}}] AS row MATCH (a:ShipKG {id:row.source}), (b:ShipKG {id:row.target}) MERGE (a)-[r:PRECEDED {id:row.id}]->(b) SET r += row.properties RETURN count(r) AS processed_37 }
CALL () { UNWIND [{`id`:"edge:0a4f90ffd11313dc",`source`:"shipkg:observation:0c0be039e775",`target`:"shipkg:action:a153887f0b20",`properties`:{`name`:"建议采取",`graph_version`:"4.1",`is_causal`:false,`id`:"edge:0a4f90ffd11313dc",`case_id`:"",`certainty`:"dataset_label",`certainty_zh`:"数据集标签",`evidence_id`:"ev:51f2102546185648",`source_file`:"Azimuth_Thruster_CBM_Dataset.zip",`source_url`:"https://zenodo.org/records/20101612",`page`:"",`locator`:"table3_lti_by_fault_type_anonymised.csv:row12",`quote`:"System / engine-family case=CAT 3508B/C thruster reference; Fault or condition=Normal operation; Detection/event reference=Normal vibration and oil condition; N/A; Recommended CBM action=Standard monitoring; 500 h vibration / 500 h oil; Included in mechanical LTI summary=no",`props_json`:"{\"name\": \"建议采取\", \"graph_version\": \"4.1\", \"is_causal\": false}"}},{`id`:"edge:10b86056b2bc9afc",`source`:"shipkg:observation:83cf859e3d48",`target`:"shipkg:action:157f8a0199e8",`properties`:{`name`:"建议采取",`graph_version`:"4.1",`is_causal`:false,`id`:"edge:10b86056b2bc9afc",`case_id`:"",`certainty`:"dataset_label",`certainty_zh`:"数据集标签",`evidence_id`:"ev:3ee08dc0eebc21a7",`source_file`:"Azimuth_Thruster_CBM_Dataset.zip",`source_url`:"https://zenodo.org/records/20101612",`page`:"",`locator`:"table3_lti_by_fault_type_anonymised.csv:row8",`quote`:"System / engine-family case=CAT C7 shaftline reductor / CAT C7 case B; Fault or condition=Babbitt wear (Pb); Detection/event reference=Vibration alert Month -4.0; oil alert at Month -1.2; Reference class=LTI_oil; LTI / warning (mo)=2.8; Warning (h)=420.0; Recommended CBM action=Oil-confirmed mixed follow-up; 250 h vibration / 250 h oil; Included in mechanical LTI summary=yes",`props_json`:"{\"name\": \"建议采取\", \"graph_version\": \"4.1\", \"is_causal\": false}"}},{`id`:"edge:11a1c3a31e11dad7",`source`:"shipkg:observation:f5d747e68b69",`target`:"shipkg:action:6667f1d39b0e",`properties`:{`name`:"建议采取",`graph_version`:"4.1",`is_causal`:false,`id