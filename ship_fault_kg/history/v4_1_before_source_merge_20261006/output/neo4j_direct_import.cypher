ummary=no",`props_json`:"{\"classification_rule\": \"lubrication\", \"name\": \"归属系统\", \"graph_version\": \"4.1\", \"is_causal\": false, \"legacy_relation\": \"BELONGS_TO_SUBSYSTEM\"}"}},{`id`:"edge:bd6f5d18215e2408",`source`:"shipkg:check:61f2da350e19",`target`:"shipkg:subsystem:5e357a568055",`properties`:{`classification_rule`:"transmission",`name`:"归属系统",`graph_version`:"4.1",`is_causal`:false,`legacy_relation`:"BELONGS_TO_SUBSYSTEM",`id`:"edge:bd6f5d18215e2408",`case_id`:"",`certainty`:"curated_classification",`certainty_zh`:"研究者分类（非因果结论）",`evidence_id`:"ev:6312cf968733db1b",`source_file`:"MAIB_2017_20_Hebrides_CPP_coupling.pdf",`source_url`:"https://assets.publishing.service.gov.uk/media/59b7ab1c40f0b61231e71a54/MAIBInvReport20_2017.pdf",`page`:"36",`locator`:"PDF page 36",`quote`:"NISATIONS Rolls-Royce Marine has: ● Issued a service letter to all users of the HeliconX propulsion control systems regarding the inspection and integrity of the jaw coupling within the linear servomotor actuator. ● Issued a service procedure for the linear servomotor based on OEM requirements. CalMac Ferries Ltd h as: ● Issued a technical bulletin to its major vessels that requires all propulsion con",`props_json`:"{\"classification_rule\": \"transmission\", \"name\": \"归属系统\", \"graph_version\": \"4.1\", \"is_causal\": false, \"legacy_relation\": \"BELONGS_TO_SUBSYSTEM\"}"}},{`id`:"edge:bdcf42a553da6f7f",`source`:"shipkg:sensor:65ae734da9ec",`target`:"shipkg:subsystem:52e7560c8465",`properties`:{`classification_rule`:"fuel_air",`name`:"归属系统",`graph_version`:"4.1",`is_causal`:false,`legacy_relation`:"BELONGS_TO_SUBSYSTEM",`id`:"edge:bdcf42a553da6f7f",`case_id`:"",`certainty`:"curated_classification",`certainty_zh`:"研究者分类（非因果结论）",`evidence_id`:"ev:400d60e3617603ce",`source_file`:"Marine_Engine_Fault_Data_v1.zip",`source_url`:"https://zenodo.org/records/19857425",`page`:"",`locator`:"variable_dictionary.csv:Charge Air Press.",`quote`:"full_name=Charge Air Press.; symbol=Pturb; unit=k