故障/事件", "graph_version": "3.0", "semantic_class": "normal_reference"}</data></node><node id="shipkg:fault:f6eb639558ed"><data key="name">轴系扭转共振风险</data><data key="kind">Fault</data><data key="aliases" /><data key="display_name">轴系扭转共振风险</data><data key="props_json">{"display_name": "轴系扭转共振风险", "kind_zh": "故障/事件", "graph_version": "3.0", "semantic_class": "failure_or_event"}</data></node><node id="shipkg:fault:fce2f501a499"><data key="name">CPP倒车响应迟缓</data><data key="kind">Fault</data><data key="aliases">sluggish astern response</data><data key="display_name">CPP倒车响应迟缓</data><data key="props_json">{"display_name": "CPP倒车响应迟缓", "kind_zh": "故障/事件", "graph_version": "3.0", "semantic_class": "failure_or_event"}</data></node><node id="shipkg:fault:fee4df6aeb24"><data key="name">主机灾难性失效</data><data key="kind">Fault</data><data key="aliases">catastrophic main engine failure</data><data key="display_name">主机灾难性失效</data><data key="props_json">{"display_name": "主机灾难性失效", "kind_zh": "故障/事件", "graph_version": "3.0", "semantic_class": "failure_or_event"}</data></node><node id="shipkg:faulttype:12275851bbd1"><data key="name">联轴器故障</data><data key="kind">FaultType</data><data key="aliases">联轴器故障 联轴器松脱 coupling failure</data><data key="display_name">联轴器故障</data><data key="props_json">{"knowledge_id": "knowledge:coupling_failure", "applicability": "实际证据是Hebrides的CPP执行器小型爪式联轴器，不是主推进轴联轴器断裂；主轴断裂根因不可由此推断。", "coupling_domains": "机-电", "data_origin": "reference_knowledge", "display_name": "联轴器故障", "kind_zh": "经典故障类别", "graph_version": "3.0"}</data></node><node id="shipkg:faulttype:3353dce7f4ad"><data key="name">烧瓦与轴承咬死</data><data key="kind">FaultType</data><data key="aliases">烧瓦 抱轴 轴瓦过热 轴承咬死 bearing seizure</data><data key="display_name">烧瓦与轴承咬死</data><data key="props_json">{"knowledge_id": "knowledge:bearing_seizure", "applicability": "主机滑动轴承；烧瓦是检索用的工程统称，不能把全部轴瓦疲劳、瓦片转位或轴承失效直接标成已证实烧瓦。", "coupling_domains": "热-机", "data_origin": "reference_knowledge", "display_name": "烧瓦与轴承咬死", "kind_zh": "经典故障类别", "graph_version": "3.0"}</data></node><node id="shipkg:faulttype:40cb53a64e31"><data key="name">发电机绕组绝缘劣化</data><data key="kind">FaultType</data><data key="aliases">绝缘下降 绕组绝缘 绝缘电阻 insulation resistance</data><data key="display_name">发电机绕组绝缘劣化</data><data key="props_json">{"knowledge_id": "knowledge:winding_insulation", "applicability": "STAMFORD/AvK发电机；检测与干燥作业须停电隔离，由合格人员依本机手册执行，本文不提供通用阈值或操作命令。", "coupling_domains": "热-电", "data_origin": "reference_knowledge", "display_name": "发电机绕组绝缘劣化", "kind_zh": "经典故障类别", "graph_version": "3.0"}</data></node><node id="shipkg:faulttype:6456485708ad"><data key="name">轴带发电机对中异常与振动损伤</data><data key="kind">FaultType</data><data key="aliases">轴带 对中不良 轴带电机振动 shaft generator alignment</data><data key="display_name">轴带发电机对中异常与振动损伤</data><data key="props_json">{"knowledge_id": "knowledge:shaft_generator_alignment", "applicability": "通过齿轮箱及联轴器驱动的轴带发电机；不能推广到所有同轴无附加轴承的构型。", "coupling_domains": "热-机-电", "data_origin": "reference_knowledge", "display_name": "轴带发电机对中异常与振动损伤", "kind_zh": "经典故障类别", "graph_version": "3.0"}</data></node><node id="shipkg:faulttype:660e09f63773"><data key="name">冷却水通道堵塞与热过载</data><data key="kind">FaultType</data><data key="aliases">冷却水堵塞 结垢 冷却不足 热过载</data><data key="display_name">冷却水通道堵塞与热过载</data><data key="props_json">{"knowledge_id": "knowledge:coolant_blockage", "applicability": "MAN四冲程柴油机闭式淡水冷却；水质要求与添加剂须按具体机型手册确认。", "coupling_domains": "热-机", "data_origin": "reference_knowledge", "display_name": "冷却水通道堵塞与热过载", "kind_zh": "经典故障类别", "graph_version": "3.0"}</data></node><node id="shipkg:faulttype:6dbd0d51366c"><data key="name">电机与发电机轴承电蚀</data><data key="kind">FaultType</data><data key="aliases">电蚀 轴承电流 轴电流 shaft bearing currents</data><data key="display_name">电机与发电机轴承电蚀</data><data key="props_json">{"knowledge_id": "knowledge:bearing_electrical_erosion", "applicability": "具有闭合轴电流路径的旋转电机；轴承绝缘和接地刷方案按厂家/机型确定，不能假定全部STAMFORD机型都需要绝缘轴承。", "coupling_domains": "电-机", "data_origin": "reference_knowledge", "display_name": "电机与发电机轴承电蚀", "kind_zh": "经典故障类别", "graph_version": "3.0"}</data></node><node id="shipkg:faulttype:796439daaa03"><data key="name">船舶电网耦合振荡</data><data key="kind">FaultType</data><data key="aliases">电网耦合振荡 轴带发电振荡 电压振荡 频率振荡 marine microgrid oscillation</data><data key="display_name">船舶电网耦合振荡</data><data key="props_json">{"knowledge_id": "knowledge:electrical_oscillation", "applicability": "2021论文三类船舶的实测电网信号，含轴带发电化学品船；不是所有振荡都超限。DP船风浪影响主要作用于基波与频率，不能一概说风浪显著放大所有谐波。", "coupling_domains": "机-电", "data_origin": "reference_knowledge", "display_name": "船舶电网耦合振荡", "kind_zh": "经典故障类别", "graph_version": "3.0"}</data></node><node id="shipkg:faulttype:84e503bec36b"><data key="name">轴系扭振与联轴器过载风险</data><data key="kind">FaultType</data><data key="aliases">扭振 共振 联轴器断裂风险 torsional resonance</data><data key="display_name">轴系扭振与联轴器过载风险</data><data key="props_json">{"knowledge_id": "knowledge:shaft_torsional", "applicability": "内燃机-发电机传动链一般机理；证据支持扭振导致失效风险及电气故障转矩冲击，但未建立某大型船主轴联轴器断裂的已证实事故链。", "coupling_domains": "热-机-电", "data_origin": "reference_knowledge", "display_name": "轴系扭振与联轴器过载风险", "kind_zh": "经典故障类别", "graph_version": "3.0"}</data></node><node id="shipkg:faulttype:8a35cec932af"><data key="name">扭振减振器失效</data><data key="kind">FaultType</data><data key="aliases">减振器失效 扭振减振器 torsional vibration damper</data><data key="display_name">扭振减振器失效</data><data key="props_json">{"knowledge_id": "knowledge:damper_failure", "applicability": "MAN L16/24、L21/31、L27/38等通函列明机型；不得推广其维护周期到其它机型。", "coupling_domains": "热-机", "data_origin": "reference_knowledge", "display_name": "扭振减振器失效", "kind_zh": "经典故障类别", "graph_version": "3.0"}</data></node><node id="shipkg:faulttype:bff048b48ff1"><data key="name">发电机轴承机械磨损</data><data key="kind">FaultType</data><data key="aliases">轴带电机磨损 发电机轴承磨损 滚动轴承 bearing wear</data><data key="display_name">发电机轴承机械磨损</data><data key="props_json">{"knowledge_id": "knowledge:generator_bearing_wear", "applicability": "有滚动轴承的发电机或轴带发电机构型；滚动轴承与主机滑动轴瓦的失效机理不得混用。", "coupling_domains": "热-机-电", "data_origin": "reference_knowledge", "display_name": "发电机轴承机械磨损", "kind_zh": "经典故障类别", "graph_version": "3.0"}</data></node><node id="shipkg:faulttype:ce7933999459"><data key="name">拉缸</data><data key="kind">FaultType</data><data key="aliases">拉缸 scuffing 缸套拉伤 黏着磨损</data><data key="display_name">拉缸</data><data key="props_json">{"knowledge_id": "knowledge:liner_scuffing", "applicability": "MAN B&amp;W两冲程柴油机缸套/活塞环；2016通函用于机理，润滑油选择须查2023通函及本机手册。不能把活塞咬死一概等同于已证实拉缸。", "coupling_domains": "热-机", "data_origin": "reference_knowledge", "display_name": "拉缸", "kind_zh": "经典故障类别", "graph_version": "3.0"}</data></node><node id="shipkg:faulttype:f8ea1aa17718"><data key="name">冷却回路汽蚀</data><data key="kind">FaultType</data><data key="aliases">汽蚀 空化 冷却水汽蚀 cavitation</data><data key="display_name">冷却回路汽蚀</data><data key="props_json">{"knowledge_id": "knowledge:cooling_cavitation", "applicability": "扫气空气冷却器水侧；该证据描述低流量局部沸腾及管路汽蚀，不等同于已证明所有冷却泵汽蚀由此引起。", "coupling_domains": "热-机", "data_origin": "reference_knowledge", "display_name": "冷却回路汽蚀", "kind_zh": "经典故障类别", "graph_version": "3.0"}</data></node><node id="shipkg:observation:0c0be039e775"><data key="name">CAT 3508B/C thruster reference</data><data key="kind">Observation</data><data key="aliases" /><data key="display_name">CAT 3508B/C thruster reference</data><data key="props_json">{"data_origin": "anonymised_field_summary", "record": 12, "warning_hours": "", "warning_months": "", "reference_class": "", "display_name": "CAT 3508B/C thruster reference", "kind_zh": "监测记录", "graph_version": "3.0"}</data></node><node id="shipkg:observation:36b9efa16da9"><data key="name">CAT 3516C coupling EB 1</data><data key="kind">Observation</data><data key="aliases" /><data key="display_name">CAT 3516C coupling EB 1</data><data key="props_json">{"data_origin": "anonymised_field_summary", "record": 4, "warning_hours": "300.0", "warning_months": "2.0", "reference_class": "LTI_maintenance", "display_name": "CAT 3516C coupling EB 1", "kind_zh": "